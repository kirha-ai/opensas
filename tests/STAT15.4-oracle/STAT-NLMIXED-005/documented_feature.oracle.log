6561       data inhaler;
6562       input clarity group time freq @@;
6563       gt = group*time;
6564       sub = floor((_n_+1)/2);
6565       datalines;

NOTE: SAS went to a new line when INPUT statement reached past the end of a line.
NOTE: The data set WORK.INHALER has 38 observations and 6 variables.

6572       ;
6573       proc nlmixed data=inhaler corr ecorr;
6574       parms b0=0 b1=0 b2=0 b3=0 sd=1 i1=1 i2=1;
6575       bounds i1 > 0, i2 > 0;
6576       eta = b0 + b1*group + b2*time + b3*gt + u;
6577       if (clarity=1) then p = probnorm(-eta);
6578       else if (clarity=2) then
6579       p = probnorm(i1-eta) - probnorm(-eta);
6580       else if (clarity=3) then
6581       p = probnorm(i1+i2-eta) - probnorm(i1-eta);
6582       else p = 1 - probnorm(i1+i2-eta);
6583       if (p > 1e-8) then ll = log(p);
6584       else ll = -1e20;
6585       model clarity ~ general(ll);
6586       random u ~ normal(0,sd*sd) subject=sub;
6587       replicate freq;
6588       estimate 'thresh2' i1;
6589       estimate 'thresh3' i1 + i2;
6590       estimate 'icc' sd*sd/(1+sd*sd);
6591       run;

NOTE: Convergence criterion (GCONV=1E-8) satisfied.
