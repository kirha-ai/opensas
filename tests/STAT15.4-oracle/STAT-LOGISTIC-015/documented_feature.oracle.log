14581      ;
14582      title 'Stepwise Regression on Cancer Remission Data';
14583      proc logistic data=Remission outest=betas covout;
14584      model remiss(event='1')=cell smear infil li blast temp
14585      / selection=stepwise
14586      slentry=0.3
14587      slstay=0.35
14588      details
14589      lackfit;
14590      output out=pred p=phat lower=lcl upper=ucl
14591      predprob=(individual crossvalidate);
14592      ods output Association=Association;
14593      run;

