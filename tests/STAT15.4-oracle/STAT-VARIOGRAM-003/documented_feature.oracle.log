30162      ods path work.templat(update) sashelp.tmplmst(read);
30163      
30164      title 'Spatial Correlation Analysis with PROC VARIOGRAM';
30165      ods graphics on;
30166      proc variogram data=sashelp.thick plots=pairs(thr=30);
30167      compute novariogram nhc=20;
30168      coordinates xc=East yc=North;
30169      var Thick;
30170      run;

NOTE: The PROCEDURE VARIOGRAM printed page 1843.

30171      proc variogram data=sashelp.thick outv=outv;
30172      compute lagd=7 maxlag=10 cl robust;
30173      coordinates xc=East yc=North;
30174      var Thick;
30175      run;

NOTE: No DIRECTIONS statement and no NDIRECTIONS=, or NDIRECTIONS=0 specified: Computing omnidirectional semivariogram.
NOTE: The data set WORK.OUTV has 12 observations and 9 variables.
NOTE: The PROCEDURE VARIOGRAM printed pages 1844-1845.

30176      proc variogram data=sashelp.thick outv=outv plots(only)=moran;
30177      compute lagd=7 maxlag=10 autocorr(assum=random);
30178      coordinates xc=East yc=North;
30179      var Thick;
30180      run;

NOTE: No DIRECTIONS statement and no NDIRECTIONS=, or NDIRECTIONS=0 specified: Computing omnidirectional semivariogram.
NOTE: The autocorrelation statistics exclude 33 observation(s) that have no neighbors within the specified LAGDISTANCE= distance.
NOTE: The Moran scatter plot excludes 33 observation(s) because they have no neighbors within the specified LAGDISTANCE= distance.
NOTE: The data set WORK.OUTV has 12 observations and 8 variables.
NOTE: The PROCEDURE VARIOGRAM printed pages 1846-1847.

30181      proc variogram data=sashelp.thick outv=outv;
30182      store out=SemivStoreGau / label='Thickness Gaussian WLS Fit';
30183      compute lagd=7 maxlag=10;
30184      coordinates xc=East yc=North;
30185      model form=gau cl / covb;
30186      var Thick;
30187      run;

NOTE: No DIRECTIONS statement and no NDIRECTIONS=, or NDIRECTIONS=0 specified: Computing omnidirectional semivariogram.
NOTE: Convergence criterion (GCONV=1E-8) satisfied.
NOTE: The data set WORK.OUTV has 12 observations and 8 variables.
NOTE: The PROCEDURE VARIOGRAM printed pages 1848-1851.

30188      ods graphics off;
30189      run;
30190      quit;
