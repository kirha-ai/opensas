30155      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
30155    ! validmemname=compatible locale=en_US;
30156      %let syscc=0;
30157      title; footnote;
30158      ods _all_ close;
30159      ods listing gpath="%sysfunc(pathname(work))";
30160      ods graphics off;
30161      proc datasets library=work kill nolist;
