2671       data a (drop=i);
2672       do i=1 to 1000;
2673       x1=rannor(1234);
2674       x2=rannor(1234);
2675       e=rannor(1234);
2676       if i > 950 then y=100 + 10*e;
2677       else y=10 + 5*x1 + 3*x2 + 0.5 * e;
2678       output;
2679       end;
2680       run;

NOTE: The data set WORK.A has 1000 observations and 4 variables.

2681       proc quantreg data=a;
2682       model y = x1 x2 / seed=314159;
2683       run;

NOTE: No valid quantiles are specified. PROC QUANTREG computes median regression.
NOTE: The PROCEDURE QUANTREG printed page 149.

2684       proc quantreg algorithm=interior(tolerance=1e-6)
2685       ci=none data=a;
2686       model y = x1 x2 / itprint nosummary seed=314159;
2687       run;

NOTE: No valid quantiles are specified. PROC QUANTREG computes median regression.
NOTE: The PROCEDURE QUANTREG printed pages 150-151.

2688       proc quantreg algorithm=smooth(rratio=.5) ci=none data=a;
