21062      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
21062    ! validmemname=compatible locale=en_US;
21063      %let syscc=0;
21064      title; footnote;
21065      ods _all_ close;
21066      ods listing gpath="%sysfunc(pathname(work))";
21067      ods graphics off;
21068      proc datasets library=work kill nolist;
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
