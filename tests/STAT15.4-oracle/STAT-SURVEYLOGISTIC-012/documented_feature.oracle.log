21071      data survey;
21072      call streaminit(722);
21073      do stratum=1 to 2;
21074      do cluster=1 to 4;
21075      do id=1 to 12;
21076      age=20+mod(id*7+cluster,45);
21077      event=rand('bernoulli',0.3);
21078      weight=2+stratum+cluster/10;
21079      output;
21080      end;
21081      end;
21082      end;
21083      run;

NOTE: The data set WORK.SURVEY has 96 observations and 6 variables.

21084      proc surveylogistic data=survey;
21085      strata stratum;
21086      cluster cluster;
21087      weight weight;
21088      model event(event='1')=age;
21089      run;

NOTE: PROC SURVEYLOGISTIC is modeling the probability that event=1.
NOTE: Convergence criterion (GCONV=1E-8) satisfied.
