2544       %let nObs = 1500;
2545       %let nContIn = 5;
2546       %let nContOut = 10;
2547       %let Seed = 12345;
2548       data ex4Data;
2549       array xIn{&nContIn};
2550       array xOut{&nContOut};
2551       drop i j sign xBeta expXbeta;
2552       seed = &Seed;
2553       do i=1 to &nObs;
2554       sign = -1;
2555       xBeta = 0;
2556       do j=1 to dim(xIn);
2557       call ranuni(seed,xIn[j]);
2558       xBeta = xBeta + j *sign*xIn{j};
2559       sign = -sign;
2560       end;
2561       do j=1 to dim(xOut);
2562       call ranuni(seed,xOut[j]);
2563       end;
2564       call ranuni(seed,xSubtle);
2565       call ranuni(seed,xTiny);
2566       xBeta = xBeta + 0.1*xSubtle + 0.05*xTiny;
2567       expXbeta = exp(xBeta/20);
2568       call ranpoi(seed,expXbeta,yPoisson);
2569       output;
2570       end;
2571       run;

NOTE: The data set WORK.EX4DATA has 1500 observations and 19 variables.

2572       proc hpgenselect data=ex4Data(Obs=10000);
2573       model yPoisson = x: / dist=Poisson;
2574       selection method=Lasso(choose=SBC) details=all;
2575       performance details;
2576       run;

