6340       data analysisData testData;
6341       drop i j c3Num;
6342       length c3 $ 7;
6343       array x{20} x1-x20;
6344       do i=1 to 1500;
6345       do j=1 to 20;
6346       x{j} = ranuni(1);
6347       end;
6348       c1 = 1 + mod(i,8);
6349       c2 = ranbin(1,3,.6);
6350       if i < 50 then do;
6351       c3 = 'tiny';
6352       c3Num=1;
6353       end;
6354       else if i < 250 then do;
6355       c3 = 'small';
6356       c3Num=1;
6357       end;
6358       else if i < 600 then do;
6359       c3 = 'average';
6360       c3Num=2;
6361       end;
6362       else if i < 1200 then do;
6363       c3 = 'big';
6364       c3Num=3;
6365       end;
6366       else do;
6367       c3 = 'huge';
6368       c3Num=5;
6369       end;
6370       y = 10 + x1 + 2*x5 + 3*x10 + 4*x20 + 3 *x1*x7 + 8*x6*x7
6371       + 5*(c1=3)*c3Num + 8*(c1=7) + 5 *rannor(1);
6372       if ranuni(1) < 2/3 then output analysisData;
6373       else output testData;
6374       end;
6375       run;

NOTE: The data set WORK.ANALYSISDATA has 1010 observations and 24 variables.
NOTE: The data set WORK.TESTDATA has 490 observations and 24 variables.

6376       ods graphics on;
6377       proc glmselect data=analysisData testdata=testData
6378       seed=1 plots(stepAxis=number)=(criterionPanel ASEPlot);
6379       partition fraction(validate=0.5);
6380       class c1 c2 c3(order=data);
6381       model y = c1|c2|c3|x1|x2|x3|x4|x5|x5|x6|x7|x8|x9|x10
6382       |x11|x12|x13|x14|x15|x16|x17|x18|x19|x20 @2
6383       / selection=stepwise(choose = validate
6384       select = sl)
6385       hierarchy=single stb;
6386       run;

