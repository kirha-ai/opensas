1625       title 'Polynomial Data';
1626       data Polynomial;
1627       do i = 1 to 101;
1628       x = (i-1)/(101-1);
1629       y = 10**(9/2);
1630       do j = 0 to 8;
1631       y = y * (x - j/8);
1632       end;
1633       output;
1634       end;
1635       run;

NOTE: The data set WORK.POLYNOMIAL has 101 observations and 4 variables.

1636       ods graphics on;
1637       proc orthoreg data=Polynomial;
1638       effect xMod = polynomial(x / degree=9);
1639       model y = xMod;
1640       effectplot fit / obs;
1641       store OStore;
1642       run;

NOTE: The ORTHOREG procedure generated the model item store WORK.OSTORE.
NOTE: There were 101 observations read from the data set WORK.POLYNOMIAL.
NOTE: The PROCEDURE ORTHOREG printed page 191.

1643       ods graphics off;
1644       data Zeros(keep=x);
1645       do j = 0 to 8;
1646       x = j/8;
1647       output;
1648       end;
1649       run;

NOTE: The data set WORK.ZEROS has 9 observations and 1 variables.

1650       proc plm restore=OStore noprint;
