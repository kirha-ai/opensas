21386      ;
21387      proc gee data=Children descending;
21388      class ID City;
21389      model Symptom = City Age Smoke / dist=bin link=logit;
21390      repeated subject=ID / type=exch covb corrw;
21391      run;

NOTE: PROC GEE is modeling the probability that Symptom='1'.
