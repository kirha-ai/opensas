10327      datalines;

NOTE: The data set WORK.GROWTH has 16 observations and 5 variables.

10344      ;
10345      proc calis method=ml data=growth nostand noparmname;
10346      lineqs
10347      y1 = 0. * Intercept + f_alpha + e1,
10348      y2 = 0. * Intercept + f_alpha + 1 * f_beta + e2,
10349      y3 = 0. * Intercept + f_alpha + 2 * f_beta + e3,
10350      y4 = 0. * Intercept + f_alpha + 3 * f_beta + e4,
10351      y5 = 0. * Intercept + f_alpha + 4 * f_beta + e5;
10352      variance
10353      f_alpha f_beta,
10354      e1-e5 = 5 * evar;
10355      mean
10356      f_alpha f_beta;
10357      cov
10358      f_alpha f_beta;
10359      fitindex on(only)=[chisq df probchi];
10360      run;

