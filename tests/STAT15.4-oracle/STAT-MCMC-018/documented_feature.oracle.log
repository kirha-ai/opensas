16914      ods graphics off;
16915      title 'The Behrens-Fisher Problem';
16916      data behrens;
16917      input y ind @@;
16918      datalines;

NOTE: SAS went to a new line when INPUT statement reached past the end of a line.
NOTE: The data set WORK.BEHRENS has 33 observations and 2 variables.

16924      ;
16925      proc mcmc data=behrens outpost=postout seed=123
16926      nmc=1000 monitor=(_parms_ mudif)
16927      statistics(alpha=0.01) nbi=200;
16928      ods select PostSumInt;
16929      parm mu1 0 mu2 0;
16930      parm sig21 1;
16931      parm sig22 1;
16932      prior mu: ~ general(0);
16933      prior sig21 ~ general(-log(sig21), lower=0);
16934      prior sig22 ~ general(-log(sig22), lower=0);
16935      mudif = mu1 - mu2;
16936      if ind = 1 then do;
16937      mu = mu1;
16938      s2 = sig21;
16939      end;
16940      else do;
16941      mu = mu2;
16942      s2 = sig22;
16943      end;
16944      model y ~ normal(mu, var=s2);
16945      run;

