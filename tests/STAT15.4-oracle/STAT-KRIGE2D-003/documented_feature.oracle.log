9960       options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
9960     ! validmemname=compatible locale=en_US;
9961       %let syscc=0;
9962       title; footnote;
9963       ods _all_ close;
