9968       
9969       title 'Spatial Prediction With Kriging';
9970       data thick;
9971       input East North Thick @@;
9972       label Thick='Coal Seam Thickness';
9973       datalines;

NOTE: SAS went to a new line when INPUT statement reached past the end of a line.
NOTE: The data set WORK.THICK has 75 observations and 3 variables.

9999       ;
10000      ods graphics on;
10001      proc krige2d data=thick;
10002      coordinates xc=East yc=North;
10003      predict var=Thick radius=60;
10004      model scale=7.4599 range=30.1111 form=gauss;
10005      grid x=0 to 100 by 2.5 y=0 to 100 by 2.5;
10006      run;

NOTE: The data set WORK.DATA7 has 1681 observations and 7 variables.
NOTE: The PROCEDURE KRIGE2D printed pages 721-722.

10007      ods graphics off;
10008      run;
10009      quit;
