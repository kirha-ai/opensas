1626       input Make $ 1-10 Model $ 12-22 @25 ('1'n-'25'n) (1.);
1627       datalines;

NOTE: The data set WORK.CARPREF has 17 observations and 27 variables.

1645       ;
1646       ods graphics on;
1647       * Principal Component Analysis of the Original Data;
1648       proc princomp data=CarPref;
1649       ods select ScreePlot;
1650       var '1'n-'25'n;
1651       run;

WARNING: The Correlation Matrix is not positive definite.

1652       * Transform the Data to Better Fit a Two Component Model;
1653       proc prinqual data=CarPref out=Results n=2 replace mdpref;
1654       title2 'Multidimensional Preference (MDPREF) Analysis';
1655       title3 'Optimal Monotonic Transformation of Preference Data';
1656       id model;
1657       transform monotone('1'n-'25'n);
1658       run;

WARNING: Failed to converge, however criterion change is less than 0.0001.
