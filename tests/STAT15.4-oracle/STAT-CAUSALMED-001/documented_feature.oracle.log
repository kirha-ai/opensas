13267      proc causalmed data=sashelp.birthwgt decomp;
13268      class LowBirthWgt Smoking Death AgeGroup Married Race
13269      Drinking SomeCollege /descending;
13270      mediator LowBirthWgt = Smoking;
13271      model Death = LowBirthWgt | Smoking;
13272      covar AgeGroup Married Race Drinking SomeCollege;
13273      evaluate 'Low Birth-Weight' LowBirthWgt='Yes' / nodecomp;
13274      evaluate 'Normal Birth-Weight' LowBirthWgt='No' / nodecomp;
13275      run;

NOTE: PROC CAUSALMED is modeling the probability that Death='Yes' in the outcome model.
NOTE: PROC CAUSALMED is modeling the probability that LowBirthWgt='Yes' in the mediator model.
NOTE: The PROCEDURE CAUSALMED printed pages 1802-1807.

