1311       data VALung;
1312       drop check m;
1313       retain Therapy Cell;
1314       infile cards column=column;
1315       length Check $ 1;
1316       label Time='time to death in days'
1317       Kps='Karnofsky performance scale'
1318       Duration='months from diagnosis to randomization'
1319       Age='age in years'
1320       Prior='prior therapy'
1321       Cell='cell type'
1322       Therapy='type of treatment';
1323       format Prior yesno.;
1324       M=Column;
1325       input Check $ @@;
1326       if M>Column then M=1;
1327       if Check='s'|Check='t' then do;
1328       input @M Therapy $ Cell $;
1329       delete;
1330       end;
1331       else do;
1332       input @M Time Kps Duration Age Prior @@;
1333       Status=(Time>0);
1334       Time=abs(Time);
1335       end;
1336       datalines;

