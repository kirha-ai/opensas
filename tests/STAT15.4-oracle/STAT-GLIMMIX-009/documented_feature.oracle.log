23747      data pr;
23748      input child gender$ y1 y2 y3 y4;
23749      array yy y1-y4;
23750      do time=1 to 4;
23751      age = time*2 + 6;
23752      y = yy{time};
23753      output;
23754      end;
23755      drop y1-y4;
23756      datalines;

NOTE: The data set WORK.PR has 108 observations and 5 variables.

23784      ;
23785      proc glimmix data=pr;
23786      class child gender time;
23787      model y = gender age gender*age / covb(details) ddfm=kr;
23788      random intercept age / type=chol sub=child;
23789      random time / subject=child type=ar(1) residual;
23790      ods select ModelInfo CovB CovBModelBased CovBDetails;
23791      run;



NOTE: Convergence criterion (GCONV=1E-8) satisfied.
NOTE: At least one element of the gradient is greater than 1e-3.
NOTE: The PROCEDURE GLIMMIX printed page 2411.

