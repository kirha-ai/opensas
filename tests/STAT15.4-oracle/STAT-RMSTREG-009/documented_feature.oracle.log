13579      data survival;
13580      call streaminit(218);
13581      do id=1 to 100;
13582      age=25+mod(id*7,40);
13583      x=mod(id,2);
13584      time=exp(0.5+0.15*x+0.01*age+rand('normal')*0.7);
13585      status=(mod(id,4) ne 0);
13586      output;
13587      end;
13588      run;

NOTE: The data set WORK.SURVIVAL has 100 observations and 5 variables.

13589      proc rmstreg data=survival tau=5;
13590      model time*status(0)=age x / link=linear method=pv;
13591      run;

