12013      proc contents varnum data=sashelp.baseball;
12014      ods select position;
12015      run;

NOTE: The PROCEDURE CONTENTS printed page 889.

12016      proc quantselect data=sashelp.baseball;
12017      class Div;
12018      model Salary = nAtBat nHits nHome nRuns nRBI nBB yrMajor crAtBat
12019      crHits crHome crRuns crRbi crBB nAssts nError nOuts
12020      Div
12021      / selection=lasso(adaptive stop=aic choose=sbc sh=7);
12022      run;

NOTE: The PROCEDURE QUANTSELECT printed pages 890-892.

12023      proc quantselect data=sashelp.baseball;
12024      class Div;
12025      model Salary = nAtBat nHits nHome nRuns nRBI nBB yrMajor crAtBat
12026      crHits crHome crRuns crRbi crBB nAssts nError nOuts
12027      Div
12028      / quantiles=0.1 0.9 selection=lasso(adaptive stop=aic choose=sbc sh=7);
