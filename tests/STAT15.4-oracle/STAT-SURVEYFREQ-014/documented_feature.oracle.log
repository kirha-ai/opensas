19593      ods path work.templat(update) sashelp.tmplmst(read);
19594      
19595      data survey;
19596      do state=1 to 2;
19597      do school=1 to 4;
19598      do id=1 to 6;
19599      response=1+mod(id+school,3);
19600      schooltype=1+mod(school,2);
19601      samplingweight=2+state+school/10;
19602      output;
19603      end;
19604      end;
19605      end;
19606      run;

NOTE: The data set WORK.SURVEY has 48 observations and 6 variables.

19607      proc surveyfreq data=survey;
19608      strata state;
19609      cluster school;
19610      weight samplingweight;
19611      tables schooltype*response / row chisq;
19612      run;

NOTE: The Rao-Scott chi-square test cannot be computed for the table of schooltype by response because the design correction is not positive.
