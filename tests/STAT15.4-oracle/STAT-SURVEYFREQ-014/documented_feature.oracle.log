19585       */
19586      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
19586    ! validmemname=compatible locale=en_US;
19587      %let syscc=0;
19588      title; footnote;
19589      ods _all_ close;
19590      ods listing gpath="%sysfunc(pathname(work))";
19591      ods graphics off;
19592      proc datasets library=work kill nolist;
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
