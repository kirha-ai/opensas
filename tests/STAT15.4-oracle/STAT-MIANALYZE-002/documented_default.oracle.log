3102       ods path work.templat(update) sashelp.tmplmst(read);
3103       
3104       *----------------- Data on Physical Fitness -----------------*
3105       | These measurements were made on men involved in a physical |
3106       | fitness course at N.C. State University. |
3107       | Only selected variables of |
3108       | Oxygen (oxygen intake, ml per kg body weight per minute), |
3109       | Runtime (time to run 1.5 miles in minutes), and |
3110       | RunPulse (heart rate while running) are used. |
3111       | Certain values were changed to missing for the analysis. |
3112       *------------------------------------------------------------*;
3113       data Fitness1;
3114       input Oxygen RunTime RunPulse @@;
3115       datalines;

NOTE: SAS went to a new line when INPUT statement reached past the end of a line.
NOTE: The data set WORK.FITNESS1 has 31 observations and 3 variables.

3132       ;
3133       proc mi data=Fitness1 seed=3237851 noprint out=outmi;
3134       var Oxygen RunTime RunPulse;
3135       run;

WARNING: The default number of imputations has been changed from 5 to 25.
NOTE: The EM algorithm (MLE) converges in 12 iterations.
NOTE: The EM algorithm (posterior mode) converges in 7 iterations.
NOTE: The data set WORK.OUTMI has 775 observations and 4 variables.

3136       proc reg data=outmi outest=outreg covout noprint;
3137       model Oxygen= RunTime RunPulse;
3138       by _Imputation_;
3139       run;

NOTE: Interactivity disabled with BY processing.
NOTE: The data set WORK.OUTREG has 100 observations and 10 variables.

3140       proc print data=outreg(obs=8);
3141       var _Imputation_ _Type_ _Name_
3142       Intercept RunTime RunPulse;
3143       title 'Parameter Estimates from Imputed Data Sets';
3144       run;

NOTE: There were 8 observations read from the data set WORK.OUTREG.
NOTE: The PROCEDURE PRINT printed page 270.

3145       proc mianalyze data=outreg;
3146       modeleffects Intercept RunTime RunPulse;
3147       run;

NOTE: The PROCEDURE MIANALYZE printed page 271.

