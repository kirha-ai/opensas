4890       data sample;
4891       call streaminit(314159);
4892       do id=1 to 120;
4893        x=rand('normal'); z=rand('normal'); w=rand('normal'); group=1+mod(id,3);
4894        y=2+1.5*x-0.6*z+0.4*group+rand('normal');
4895        role=mod(id,4); output;
4896       end;
4897       run;

NOTE: The data set WORK.SAMPLE has 120 observations and 7 variables.

4898       
4899       proc hpquantselect data=sample;
4900       class group;
4901       model y=x z w group / quantile=0.5 clb;
4902       partition rolevar=role(validate="0");
4903       selection method=forward(select=sbc stop=validate choose=validate);
4904       performance nthreads=1;
4905       run;

NOTE: The HPQUANTSELECT procedure is executing in single-machine mode.
