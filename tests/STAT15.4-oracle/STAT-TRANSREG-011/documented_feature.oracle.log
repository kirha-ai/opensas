27644      title 'Introductory Main-Effects ANOVA Example';
27645      data a;
27646      input y x1 $ x2 $;
27647      datalines;

NOTE: The data set WORK.A has 12 observations and 3 variables.

27660      ;
27661      * Fit a main-effects ANOVA model with 1, 0, -1 coding;
27662      proc transreg ss2;
27663      model identity(y) = class(x1 x2 / effects);
27664      output coefficients replace;
27665      run;

