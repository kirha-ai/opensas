9478       options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
9478     ! validmemname=compatible locale=en_US;
9479       %let syscc=0;
9480       title; footnote;
9481       ods _all_ close;
9482       ods listing gpath="%sysfunc(pathname(work))";
9483       ods graphics off;
9484       proc datasets library=work kill nolist;
NOTE: Deleting WORK.NEW (memtype=DATA).
