5039       data sample;
5040       call streaminit(314159);
5041       do id=1 to 120;
5042        x=rand('normal'); z=rand('normal'); w=rand('normal'); group=1+mod(id,3);
5043        y=2+1.5*x-0.6*z+0.4*group+rand('normal');
5044        role=mod(id,4); output;
5045       end;
5046       run;

