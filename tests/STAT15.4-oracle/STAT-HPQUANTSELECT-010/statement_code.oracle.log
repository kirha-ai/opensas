5137       data sample;
5138       call streaminit(314159);
5139       do id=1 to 120;
5140        x=rand('normal'); z=rand('normal'); w=rand('normal'); group=1+mod(id,3);
5141        y=2+1.5*x-0.6*z+0.4*group+rand('normal');
5142        role=mod(id,4); output;
5143       end;
5144       run;

NOTE: The data set WORK.SAMPLE has 120 observations and 7 variables.

5145       filename _orcode "%sysfunc(pathname(work))/_oracle_score.sas";
5146       proc hpquantselect data=sample;
5147       class group;
5148       model y=x z w group / quantile=0.5 clb;
5149       code file="%sysfunc(pathname(work))/_oracle_score.sas";
5150       performance nthreads=1;
5151       run;

