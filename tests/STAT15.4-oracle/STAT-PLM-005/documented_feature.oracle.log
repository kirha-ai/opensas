4795       options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
4795     ! validmemname=compatible locale=en_US;
4796       %let syscc=0;
4797       title; footnote;
4798       ods _all_ close;
4799       ods listing gpath="%sysfunc(pathname(work))";
4800       ods graphics off;
4801       proc datasets library=work kill nolist;
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK.SIMUDATA (memtype=DATA).
