25025      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
25025    ! validmemname=compatible locale=en_US;
25026      %let syscc=0;
25027      title; footnote;
25028      ods _all_ close;
25029      ods listing gpath="%sysfunc(pathname(work))";
25030      ods graphics off;
25031      proc datasets library=work kill nolist;
NOTE: Deleting WORK.FERRITECORES (memtype=DATA).
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK.SASGOPT (memtype=CATALOG).
NOTE: File WORK.SASGOPT (memtype=CATALOG) cannot be deleted because it is in use.
NOTE: Deleting WORK.SASMAC1 (memtype=CATALOG).
NOTE: File WORK.SASMAC1 (memtype=CATALOG) cannot be deleted because it is in use.
NOTE: Deleting WORK.TEMPLAT (memtype=ITEMSTOR).
NOTE: File WORK.TEMPLAT (memtype=ITEMSTOR) cannot be deleted because it is in use.
25031    !                                         quit;


25032      ods path work.templat(update) sashelp.tmplmst(read);
25033      
25034      ods trace on;
25035      data multicenter;
25036      input center group$ n sideeffect;
25037      datalines;

NOTE: The data set WORK.MULTICENTER has 30 observations and 4 variables.

25068      ;
25069      proc glimmix data=multicenter;
25070      class center group;
25071      model sideeffect/n = group / solution;
25072      random intercept / subject=center;
25073      run;




