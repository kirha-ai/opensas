24190    !                                         quit;


24191      ods path work.templat(update) sashelp.tmplmst(read);
24192      
24193      data Sample;
24194      input Stratum X Y W;
24195      datalines;

NOTE: The data set WORK.SAMPLE has 8 observations and 4 variables.

24204      ;
24205      data StratumTotals;
24206      input Stratum _TOTAL_;
24207      datalines;

NOTE: The data set WORK.STRATUMTOTALS has 8 observations and 2 variables.

24216      ;
24217      title1 'Stratified Sample with Single Sampling Unit in Strata';
24218      title2 'With Stratum Collapse';
24219      proc surveyreg data=Sample total=StratumTotals;
24220      strata Stratum/list;
24221      model Y=X;
24222      weight W;
24223      run;

NOTE: Strata with only one observation are collapsed. Use the NOCOLLAPSE option in the STRATA statement if you do not want to collapse these strata.
NOTE: The PROCEDURE SURVEYREG printed page 1538.

24224      title1 'Stratified Sample with Single Sampling Unit in Strata';
24225      title2 'Without Stratum Collapse';
24226      proc surveyreg data=Sample total=StratumTotals;
24227      strata Stratum/list nocollapse;
24228      model Y = X;
24229      weight W;
24230      run;

NOTE: Strata with only one observation are not collapsed because you used the NOCOLLAPSE option in the STRATA statement.
NOTE: The PROCEDURE SURVEYREG printed page 1539.

