24181    ! 10146); S154 / Chapter 123 / `Analysis of Variance (ANOVA)` (PDF pp. 10146–10147).
24182       * Discriminates: Example 123.6: Stratum Collapse
24183       */
24184      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
24184    ! validmemname=compatible locale=en_US;
24185      %let syscc=0;
24186      title; footnote;
24187      ods _all_ close;
24188      ods listing gpath="%sysfunc(pathname(work))";
24189      ods graphics off;
24190      proc datasets library=work kill nolist;
NOTE: Deleting WORK.MUNICIPALITIES (memtype=DATA).
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK.SASGOPT (memtype=CATALOG).
