9836       options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
9836     ! validmemname=compatible locale=en_US;
9837       %let syscc=0;
9838       title; footnote;
9839       ods _all_ close;
9840       ods listing gpath="%sysfunc(pathname(work))";
9841       ods graphics off;
9842       proc datasets library=work kill nolist;
NOTE: Deleting WORK.BIVNORMAL (memtype=DATA).
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK.SASMAC2 (memtype=CATALOG).
