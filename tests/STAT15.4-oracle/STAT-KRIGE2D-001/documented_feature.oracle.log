9842     !                                         quit;


9843       ods path work.templat(update) sashelp.tmplmst(read);
9844       
9845       title 'Spatial Prediction With Kriging';
9846       data thick;
9847       input East North Thick @@;
9848       label Thick='Coal Seam Thickness';
9849       datalines;

NOTE: SAS went to a new line when INPUT statement reached past the end of a line.
NOTE: The data set WORK.THICK has 75 observations and 3 variables.

9875       ;
9876       ods graphics on;
9877       proc krige2d data=thick;
9878       coordinates xc=East yc=North;
9879       predict var=Thick radius=60;
9880       model scale=7.4599 range=30.1111 form=gauss;
9881       grid x=0 to 100 by 2.5 y=0 to 100 by 2.5;
9882       run;

NOTE: The data set WORK.DATA5 has 1681 observations and 7 variables.
NOTE: The PROCEDURE KRIGE2D printed pages 717-718.

9883       ods graphics off;
9884       run;
9885       quit;
