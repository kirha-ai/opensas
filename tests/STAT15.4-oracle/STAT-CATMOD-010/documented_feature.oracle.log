12563      ods path work.templat(update) sashelp.tmplmst(read);
12564      
12565      title 'Growth Curve Analysis';
12566      data growth2;
12567      input Diagnosis $ Treatment $ week1 $ week2 $ week4 $ count @@;
12568      datalines;

NOTE: SAS went to a new line when INPUT statement reached past the end of a line.
NOTE: The data set WORK.GROWTH2 has 32 observations and 6 variables.

12585      ;
12586      proc catmod data=growth2 order=data;
12587      title2 'Reduced Logistic Model';
12588      weight count;
12589      population Diagnosis Treatment;
12590      response logit;
12591      model week1*week2*week4=(1 0 0 0, /* mild, std */
12592      1 0 1 0,
12593      1 0 2 0,
12594      1 0 0 0, /* mild, new */
12595      1 0 0 1,
12596      1 0 0 2,
12597      0 1 0 0, /* severe, std */
12598      0 1 1 0,
12599      0 1 2 0,
12600      0 1 0 0, /* severe, new */
12601      0 1 0 1,
12602      0 1 0 2)
12603      (1='Mild diagnosis, week 1',
12604      2='Severe diagnosis, week 1',
12605      3='Time effect for std trt',
12606      4='Time effect for new trt')
12607      / freq design;
12608      contrast 'Diagnosis effect, week 1' all_parms 1 -1 0 0;
12609      contrast 'Equal time effects' all_parms 0 0 1 -1;
12610      quit;

