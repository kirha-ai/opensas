12556      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
12556    ! validmemname=compatible locale=en_US;
12557      %let syscc=0;
12558      title; footnote;
12559      ods _all_ close;
12560      ods listing gpath="%sysfunc(pathname(work))";
12561      ods graphics off;
12562      proc datasets library=work kill nolist;
