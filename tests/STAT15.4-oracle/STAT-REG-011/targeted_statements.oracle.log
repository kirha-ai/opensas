12727      data sample;
12728      call streaminit(314159);
12729      do id=1 to 90;
12730       x=rand('normal'); z=rand('normal'); w=rand('normal');
12731       group=1+mod(id,3); block=1+mod(id,5);
12732       y=5+1.5*x-0.6*z+0.4*group+rand('normal');
12733       y2=2+0.5*x+0.8*z+rand('normal'); output;
12734      end;
