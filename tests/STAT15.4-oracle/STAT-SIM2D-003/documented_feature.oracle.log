3056       ;
3057       ods graphics on;
3058       proc sim2d data=thick outsim=sim plot=(observ sim);
3059       coordinates xc=East yc=North;
3060       simulate var=Thick numreal=100 seed=79931
3061       scale=7.4599 range=30.1111 nugget=1e-8 form=gauss;
3062       mean 40.1173;
3063       grid x=0 to 100 by 25 y=0 to 100 by 25;
3064       run;

