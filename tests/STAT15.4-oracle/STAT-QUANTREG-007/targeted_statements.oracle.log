50         data sample;
51         call streaminit(314159);
52         do id=1 to 90;
53          x=rand('normal'); z=rand('normal'); w=rand('normal');
54          group=1+mod(id,3); block=1+mod(id,5);
55          y=5+1.5*x-0.6*z+0.4*group+rand('normal');
56          y2=2+0.5*x+0.8*z+rand('normal'); output;
57         end;
58         run;

NOTE: The data set WORK.SAMPLE has 90 observations and 8 variables.

59         proc quantreg data=sample; model y=x z / quantile=0.5 seed=314159; estimate 'x coefficient' x 1; test x z; run;


