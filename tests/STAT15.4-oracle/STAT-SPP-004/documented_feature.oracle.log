17666      proc spp data=sashelp.bei plots(equate)=(residual intensity);
17667      process trees = (x,y /area=(0,0,1000,500) event=Trees);
17668      trend elev = field(x,y,elevation);
17669      trend grad = field(x,y,gradient);
17670      model trees = elev grad / grid(64,64) residual(B=70) ;
17671      run;

