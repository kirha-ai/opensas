10090      data patients;
10091      call streaminit(419);
10092      do patientid=1 to 100;
10093      gender=mod(patientid,2);
10094      age=30+mod(patientid*7,45);
10095      bmi=20+mod(patientid,12);
10096      drug=rand('bernoulli',0.5);
10097      output;
10098      end;
10099      run;

NOTE: The data set WORK.PATIENTS has 100 observations and 5 variables.

10100      proc psmatch data=patients region=cs;
10101      class drug gender;
10102      psmodel drug(treated='1')=gender age bmi;
10103      match method=greedy(k=1) distance=lps caliper=0.5;
10104      assess lps var=(age bmi);
10105      output out(obs=match)=matched matchid=matchid;
10106      run;

WARNING: Some treated units do not have matched controls because there are not enough available controls for these treated units.
