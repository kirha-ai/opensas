15677      proc mcmc data=behrens outpost=postout seed=123
15678      nmc=1000 monitor=(_parms_ mudif)
15679      statistics(alpha=0.01) nbi=200;
15680      ods select PostSumInt;
15681      parm mu1 0 mu2 0;
15682      parm sig21 1;
15683      parm sig22 1;
15684      prior mu: ~ general(0);
15685      prior sig21 ~ general(-log(sig21), lower=0);
15686      prior sig22 ~ general(-log(sig22), lower=0);
15687      mudif = mu1 - mu2;
15688      if ind = 1 then do;
15689      mu = mu1;
15690      s2 = sig21;
15691      end;
15692      else do;
15693      mu = mu2;
15694      s2 = sig22;
15695      end;
15696      model y ~ normal(mu, var=s2);
15697      run;

