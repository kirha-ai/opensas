21504      ;
21505      proc gee data=Children descending;
21506      class ID City;
21507      model Symptom = City Age Smoke / dist=bin link=logit;
21508      repeated subject=ID / type=exch covb corrw;
21509      run;

NOTE: PROC GEE is modeling the probability that Symptom='1'.
