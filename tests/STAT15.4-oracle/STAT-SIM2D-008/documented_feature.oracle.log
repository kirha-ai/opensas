3426       title 'Using PROC SIM2D for Spatial Simulation';
3427       data thick;
3428       input East North Thick @@;
3429       label Thick='Coal Seam Thickness';
3430       datalines;

NOTE: SAS went to a new line when INPUT statement reached past the end of a line.
NOTE: The data set WORK.THICK has 75 observations and 3 variables.

3456       ;
3457       ods graphics on;
3458       proc sim2d data=thick outsim=sim plot=(observ sim);
3459       coordinates xc=East yc=North;
3460       simulate var=Thick numreal=100 seed=79931
3461       scale=7.4599 range=30.1111 nugget=1e-8 form=gauss;
3462       mean 40.1173;
3463       grid x=0 to 100 by 25 y=0 to 100 by 25;
3464       run;


