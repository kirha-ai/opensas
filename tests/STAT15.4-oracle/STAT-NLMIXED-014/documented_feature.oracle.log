218        /* STAT-NLMIXED-014: NLMIXED — Programming Statements
219         * Source: S154 / Chapter 89 / `Programming Statements` (PDF pp. 7126–7128).
220         * Discriminates: Verified default procedure context
221         */
222        options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
222      ! validmemname=compatible locale=en_US;
223        %let syscc=0;
224        title; footnote;
225        ods _all_ close;
226        ods listing gpath="%sysfunc(pathname(work))";
227        ods graphics off;
228        proc datasets library=work kill nolist;
NOTE: Deleting WORK.NESTED (memtype=DATA).
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
228      !                                         quit;


229        ods path work.templat(update) sashelp.tmplmst(read);
230        
231        %let na = 100;
232        %let nb = 5;
233        %let nr = 2;
234        data nested;
235        do A = 1 to &na;
236        err1 = 3*rannor(339205);
237        do B = 1 to &nb;
238        err2 = 2*rannor(314159);
239        do rep = 1 to &nr;
240        err3 = 1*rannor(314159);
241        resp = 10 + err1 + err2 + err3;
242        output;
243        end;
244        end;
245        end;
246        run;

NOTE: The data set WORK.NESTED has 1000 observations and 7 variables.

247        proc nlmixed data = nested;
248        bounds vara >=0, varb_a >=0;
249        mean = intercept + aeffect + beffect;
250        model resp ~ normal (mean, s2);
251        random aeffect ~ normal(0,vara) subject = A;
252        random beffect ~ normal(0,varb_a) subject = B(A);
253        run;

NOTE: To assign starting values to parameters, use the PARMS statement. The default starting value of 1.0 is in effect for all parameters.
NOTE: Convergence criterion (GCONV=1E-6) satisfied.
NOTE: At least one element of the gradient is greater than 1e-3.
NOTE: The PROCEDURE NLMIXED printed page 5.

