7539       /* STAT-POWER-018: POWER — Official examples and feature integration regression
7540        * Source: S154 / Chapter 96 / `Examples: POWER Procedure` (PDF pp. 7918–7984).
7541        * Discriminates: Example 96.9: Binary Logistic Regression with Independent Predictors
7542        */
7543       options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
7543     ! validmemname=compatible locale=en_US;
7544       %let syscc=0;
7545       title; footnote;
7546       ods _all_ close;
7547       ods listing gpath="%sysfunc(pathname(work))";
7548       ods graphics off;
7549       proc datasets library=work kill nolist;
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK.SASMAC2 (memtype=CATALOG).
7549     !                                         quit;


7550       ods path work.templat(update) sashelp.tmplmst(read);
7551       
7552       proc power;
7553       logistic
7554       vardist("Heat") = ordinal((5 10 15 20) : (0.2 0.3 0.3 0.2))
7555       vardist("Soak") = ordinal((2 4 6) : (0.4 0.4 0.2))
7556       vardist("Mass1") = normal(4, 1)
7557       vardist("Mass2") = normal(4, 2)
7558       testpredictor = "Heat"
7559       covariates = "Soak" | "Mass1" "Mass2"
7560       responseprob = 0.15 0.25
7561       testoddsratio = 1.2
7562       units= ("Heat" = 5)
7563       covoddsratios = 1.4 | 1 1.3
7564       alpha = 0.1
7565       power = 0.9
7566       ntotal = .;
7567       run;

