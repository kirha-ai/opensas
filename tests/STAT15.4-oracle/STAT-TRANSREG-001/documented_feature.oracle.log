26931      * Separate Curves and Intercepts with Penalized B-Splines;
26932      proc transreg data=Gas ss2 plots=transformation lprefix=0;
26933      model identity(nox) = class(Fuel / zero=none) * pbspline(EqRatio);
26934      run;

