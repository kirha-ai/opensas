5039     !                                         quit;


5040       ods path work.templat(update) sashelp.tmplmst(read);
5041       
5042       data Sim;
5043       keep Species Farm Animal Yield;
5044       array AnimalEffect{3000};
5045       array AnimalFarm{3000};
5046       array AnimalSpecies{3000};
5047       do i = 1 to dim(AnimalEffect);
5048       AnimalEffect{i} = sqrt(4.0) *rannor(12345);
5049       AnimalFarm{i} = 1 + int(100 *ranuni(12345));
5050       AnimalSpecies{i} = 1 + int(5*ranuni(12345));
5051       end;
5052       do i = 1 to 40000;
5053       Animal = 1 + int(3000 *ranuni(12345));
5054       Species = AnimalSpecies{Animal};
5055       Farm = AnimalFarm{Animal};
5056       Yield = 1 + Species + Farm/10 + AnimalEffect{Animal}
5057       + sqrt(8.0)*rannor(12345);
5058       output;
5059       end;
5060       run;

NOTE: The data set WORK.SIM has 40000 observations and 4 variables.

5061       proc hpmixed data=Sim;
5062       class Species Farm Animal;
5063       model Yield = Species Species*Farm;
5064       random Animal;
5065       test Species*Farm;
5066       contrast 'Species1 = Species2 = Species3'
5067       Species 1 0 -1,
5068       Species 0 1 -1;
5069       run;

NOTE: Convergence criterion (GCONV=1E-8) satisfied.
NOTE: The PROCEDURE HPMIXED printed page 215.

