13613      data survival;
13614      call streaminit(218);
13615      do id=1 to 100;
13616      age=25+mod(id*7,40);
13617      x=mod(id,2);
13618      time=exp(0.5+0.15*x+0.01*age+rand('normal')*0.7);
13619      status=(mod(id,4) ne 0);
13620      output;
13621      end;
13622      run;

NOTE: The data set WORK.SURVIVAL has 100 observations and 5 variables.

13623      proc rmstreg data=survival tau=5;
13624      model time*status(0)=age x / link=linear method=pv;
13625      run;

NOTE: Algorithm converged.
