NOTE: The data set WORK.SIMOUT has 1000 observations and 5 variables.

1702       proc mcmc data=x outpost=simout_m seed=1234 nmc=1000 nbi=200;
1703       array p[3] (0.3 0.4 0.3);
1704       array mu[3] (-3 2 10);
1705       array sd[3] (2 1 4);
1706       parm z alpha;
1707       prior z ~ table(p);
1708       prior alpha ~ normal(mu[z], sd=sd[z]);
1709       model general(0);
1710       run;

