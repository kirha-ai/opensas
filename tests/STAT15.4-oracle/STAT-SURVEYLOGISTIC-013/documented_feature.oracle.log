21111      data survey;
21112      call streaminit(722);
21113      do stratum=1 to 2;
21114      do cluster=1 to 4;
21115      do id=1 to 12;
21116      age=20+mod(id*7+cluster,45);
21117      event=rand('bernoulli',0.3);
21118      weight=2+stratum+cluster/10;
21119      output;
21120      end;
21121      end;
21122      end;
21123      run;

NOTE: The data set WORK.SURVEY has 96 observations and 6 variables.

21124      proc surveylogistic data=survey;
21125      strata stratum;
21126      cluster cluster;
21127      weight weight;
21128      model event(event='1')=age;
21129      run;

NOTE: PROC SURVEYLOGISTIC is modeling the probability that event=1.
