736        /* STAT-NLMIXED-006: NLMIXED — Built-In Log-Likelihood Functions / Compartment Models / Hierarchical Model Specification
737         * Source: S154 / Chapter 89 / `Built-In Log-Likelihood Functions` (PDF pp. 7131–7134); S154 / Chapter 89 / `Compartment Models` (PDF pp.
737      ! 7134–7144); S154 / Chapter 89 / `Hierarchical Model Specification` (PDF pp. 7144–7146).
738         * Discriminates: Normal likelihood with nested cluster/person random effects and predictions.
739         */
740        options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
740      ! validmemname=compatible locale=en_US;
741        %let syscc=0;
742        title; footnote;
743        ods _all_ close;
744        ods listing gpath="%sysfunc(pathname(work))";
745        ods graphics off;
746        proc datasets library=work kill nolist;
NOTE: Deleting WORK.HEIGHTS (memtype=DATA).
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
