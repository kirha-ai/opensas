746      !                                         quit;


747        ods path work.templat(update) sashelp.tmplmst(read);
748        
749        data repeated;
750        call streaminit(314159);
751        do cluster=1 to 8;
752         u0=0.5*rand('normal');
753         do j=1 to 4;
754         person=cluster*10+j; v0=0.3*rand('normal');
755         do visit=1 to 3;
756         x=visit/3; y=2+1.2*x+u0+v0+0.4*rand('normal'); output;
757         end; end;
758        end;
759        drop u0 v0 j;
760        run;

NOTE: The data set WORK.REPEATED has 96 observations and 5 variables.

761        proc nlmixed data=repeated qpoints=3 maxiter=100;
762        parms b0=2 b1=1 s1=0.25 s2=0.09 se=0.16;
763        bounds s1 s2 se > 0;
764        mu=b0+b1*x+u+v;
765        model y ~ normal(mu,se);
766        random u ~ normal(0,s1) subject=cluster;
767        random v ~ normal(0,s2) subject=person(cluster);
768        predict mu out=predicted;
769        run;

NOTE: Convergence criterion (GCONV=1E-6) satisfied.
