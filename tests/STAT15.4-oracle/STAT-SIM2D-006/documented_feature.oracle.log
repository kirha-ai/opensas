3263       title 'Using PROC SIM2D for Spatial Simulation';
3264       data thick;
3265       input East North Thick @@;
3266       label Thick='Coal Seam Thickness';
3267       datalines;

NOTE: SAS went to a new line when INPUT statement reached past the end of a line.
NOTE: The data set WORK.THICK has 75 observations and 3 variables.

3293       ;
3294       ods graphics on;
3295       proc sim2d data=thick outsim=sim plot=(observ sim);
3296       coordinates xc=East yc=North;
3297       simulate var=Thick numreal=100 seed=79931
3298       scale=7.4599 range=30.1111 nugget=1e-8 form=gauss;
3299       mean 40.1173;
3300       grid x=0 to 100 by 25 y=0 to 100 by 25;
3301       run;

NOTE: The data set WORK.SIM has 2500 observations and 6 variables.
