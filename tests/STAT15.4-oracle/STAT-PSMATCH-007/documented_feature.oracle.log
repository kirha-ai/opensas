9842       data patients;
9843       call streaminit(419);
9844       do patientid=1 to 100;
9845       gender=mod(patientid,2);
9846       age=30+mod(patientid*7,45);
9847       bmi=20+mod(patientid,12);
9848       drug=rand('bernoulli',0.5);
9849       output;
9850       end;
9851       run;

NOTE: The data set WORK.PATIENTS has 100 observations and 5 variables.

9852       proc psmatch data=patients region=cs;
9853       class drug gender;
9854       psmodel drug(treated='1')=gender age bmi;
9855       match method=greedy(k=1) distance=lps caliper=0.5;
9856       assess lps var=(age bmi);
9857       output out(obs=match)=matched matchid=matchid;
9858       run;

