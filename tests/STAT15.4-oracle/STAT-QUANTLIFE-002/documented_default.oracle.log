10152      /* STAT-QUANTLIFE-002: QUANTLIFE — Quantile regression for survival data
10153       * Source: S154 / Chapter 102 / `Getting Started: QUANTLIFE Procedure` (PDF pp. 8328–8331); S154 / Chapter 102 / `Overview: QUANTLIFE Procedure`
10153    ! (PDF pp. 8326–8328).
10154       * Discriminates: Small synthetic/public-input default model adapted to the documented Getting Started procedure
10155       */
10156      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
10156    ! validmemname=compatible locale=en_US;
10157      %let syscc=0;
10158      title; footnote;
10159      ods _all_ close;
10160      ods listing gpath="%sysfunc(pathname(work))";
10161      ods graphics off;
10162      proc datasets library=work kill nolist;
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK.SASGOPT (memtype=CATALOG).
NOTE: File WORK.SASGOPT (memtype=CATALOG) cannot be deleted because it is in use.
NOTE: Deleting WORK.SURVIVAL (memtype=DATA).
NOTE: Deleting WORK.TEMPLAT (memtype=ITEMSTOR).
NOTE: File WORK.TEMPLAT (memtype=ITEMSTOR) cannot be deleted because it is in use.
10162    !                                         quit;


10163      ods path work.templat(update) sashelp.tmplmst(read);
10164      
10165      data survival; call streaminit(518); do id=1 to 80; drug=mod(id,2); age=25+mod(id*7,40); time=exp(2+0.25*drug+0.008*age+rand('normal')*0.4);
10165    ! status=(mod(id,5) ne 0); output; end; run;

NOTE: The data set WORK.SURVIVAL has 80 observations and 5 variables.

10166      proc quantlife data=survival seed=1268; class drug; model time*status(0)=drug age / quantile=0.5; run;

NOTE: The PROCEDURE QUANTLIFE printed page 666.

