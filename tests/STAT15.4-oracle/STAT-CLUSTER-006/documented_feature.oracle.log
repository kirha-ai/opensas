14153      title 'Cluster Analysis of Flying Mileages Between 10 American Cities';
14154      ods graphics on;
14155      title2 'Using METHOD=AVERAGE';
14156      proc cluster data=sashelp.mileages(type=distance) method=average pseudo;
14157      id City;
14158      run;

