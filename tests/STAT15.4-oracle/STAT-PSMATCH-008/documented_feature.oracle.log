9882       data patients;
9883       call streaminit(419);
9884       do patientid=1 to 100;
9885       gender=mod(patientid,2);
9886       age=30+mod(patientid*7,45);
9887       bmi=20+mod(patientid,12);
9888       drug=rand('bernoulli',0.5);
9889       output;
9890       end;
9891       run;

NOTE: The data set WORK.PATIENTS has 100 observations and 5 variables.

9892       proc psmatch data=patients region=cs;
9893       class drug gender;
9894       psmodel drug(treated='1')=gender age bmi;
9895       match method=greedy(k=1) distance=lps caliper=0.5;
9896       assess lps var=(age bmi);
9897       output out(obs=match)=matched matchid=matchid;
9898       run;

