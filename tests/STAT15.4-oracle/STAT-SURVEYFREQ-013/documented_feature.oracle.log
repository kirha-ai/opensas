19555      
19556      data survey;
19557      do state=1 to 2;
19558      do school=1 to 4;
19559      do id=1 to 6;
19560      response=1+mod(id+school,3);
19561      schooltype=1+mod(school,2);
19562      samplingweight=2+state+school/10;
19563      output;
19564      end;
19565      end;
19566      end;
19567      run;

NOTE: The data set WORK.SURVEY has 48 observations and 6 variables.

19568      proc surveyfreq data=survey;
19569      strata state;
19570      cluster school;
19571      weight samplingweight;
19572      tables schooltype*response / row chisq;
19573      run;

NOTE: The Rao-Scott chi-square test cannot be computed for the table of schooltype by response because the design correction is not positive.
