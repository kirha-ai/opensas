2488       ods path work.templat(update) sashelp.tmplmst(read);
2489       
2490       %let nObs = 1500;
2491       %let nContIn = 5;
2492       %let nContOut = 10;
2493       %let Seed = 12345;
2494       data ex4Data;
2495       array xIn{&nContIn};
2496       array xOut{&nContOut};
2497       drop i j sign xBeta expXbeta;
2498       seed = &Seed;
2499       do i=1 to &nObs;
2500       sign = -1;
2501       xBeta = 0;
2502       do j=1 to dim(xIn);
2503       call ranuni(seed,xIn[j]);
2504       xBeta = xBeta + j *sign*xIn{j};
2505       sign = -sign;
2506       end;
2507       do j=1 to dim(xOut);
2508       call ranuni(seed,xOut[j]);
2509       end;
2510       call ranuni(seed,xSubtle);
2511       call ranuni(seed,xTiny);
2512       xBeta = xBeta + 0.1*xSubtle + 0.05*xTiny;
2513       expXbeta = exp(xBeta/20);
2514       call ranpoi(seed,expXbeta,yPoisson);
2515       output;
2516       end;
2517       run;

NOTE: The data set WORK.EX4DATA has 1500 observations and 19 variables.

2518       proc hpgenselect data=ex4Data(Obs=10000);
2519       model yPoisson = x: / dist=Poisson;
2520       selection method=Lasso(choose=SBC) details=all;
2521       performance details;
2522       run;

NOTE: The HPGENSELECT procedure is executing in single-machine mode.
