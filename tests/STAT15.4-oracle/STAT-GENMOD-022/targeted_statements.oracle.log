1089     !                                         quit;


1090       ods path work.templat(update) sashelp.tmplmst(read);
1091       
1092       data sample;
1093       call streaminit(314159);
1094       do id=1 to 90;
1095        x=rand('normal'); z=rand('normal'); w=rand('normal');
1096        group=1+mod(id,3); block=1+mod(id,5);
1097        y=5+1.5*x-0.6*z+0.4*group+rand('normal');
1098        y2=2+0.5*x+0.8*z+rand('normal'); output;
1099       end;
1100       run;

NOTE: The data set WORK.SAMPLE has 90 observations and 8 variables.

1101       proc genmod data=sample; model y=x z; variance v=1; deviance d=(_resp_-_mean_)**2; run;


NOTE: Algorithm converged.
NOTE: The scale parameter was held fixed.
