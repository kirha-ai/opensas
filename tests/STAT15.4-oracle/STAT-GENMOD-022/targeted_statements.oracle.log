1079       /* STAT-GENMOD-022: GENMOD — VARIANCE
1080        * Source: S154 / Chapter 51 / `VARIANCE Statement` (PDF p. 3567).
1081        * Discriminates: Explicit VARIANCE, DEVIANCE statement behavior on seeded synthetic inputs.
1082        */
1083       options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
1083     ! validmemname=compatible locale=en_US;
1084       %let syscc=0;
1085       title; footnote;
1086       ods _all_ close;
1087       ods listing gpath="%sysfunc(pathname(work))";
1088       ods graphics off;
1089       proc datasets library=work kill nolist;
NOTE: Deleting WORK.POSITIVE (memtype=DATA).
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
