6459       * Fetch -2LogL for reduced model;
6460       data statsRed;
6461       set statsRed;
6462       where Criterion = "-2 Log L";
6463       Neg2LogLRed = InterceptAndCovariates;
6464       keep Neg2LogLRed;
6465       run;

NOTE: There were 1 observations read from the data set WORK.STATSRED.
      WHERE Criterion='-2 Log L';
NOTE: The data set WORK.STATSRED has 1 observations and 1 variables.

6466       * Compute primary noncentralities for Wald and LR tests;
6467       data PrimNC;
6468       merge fitFull statsFull statsRed;
6469       WaldPrimNC = WaldChiSq / 20;
6470       LRPrimNC = -(Neg2LogLFull-Neg2LogLRed) / 20;
6471       keep DF WaldPrimNC LRPrimNC;
6472       call symput ("DF", DF);
6473       call symput ("WaldPrimNC", WaldPrimNC);
6474       call symput ("LRPrimNC", LRPrimNC);
6475       run;

