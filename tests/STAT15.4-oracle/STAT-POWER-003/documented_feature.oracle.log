6478       proc power;
6479       custom
6480       dist = chisquare
6481       primnc = &WaldPrimNC &LRPrimNC
6482       testdf = &DF
6483       ntotal = 100
6484       power = .;
6485       run;

NOTE: The PROCEDURE POWER printed page 523.

6486       data Power;
6487       set PrimNC;
6488       Crit = quantile("chisq", 1-0.05, DF);
6489       WaldPower = sdf("chisq", Crit, DF, 100 * WaldPrimNC);
6490       LRPower = sdf("chisq", Crit, DF, 100 * LRPrimNC);
6491       keep WaldPower LRPower;
6492       run;

NOTE: There were 1 observations read from the data set WORK.PRIMNC.
