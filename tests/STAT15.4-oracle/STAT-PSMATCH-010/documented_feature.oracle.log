9972       proc psmatch data=patients region=cs;
9973       class drug gender;
9974       psmodel drug(treated='1')=gender age bmi;
9975       match method=greedy(k=1) distance=lps caliper=0.5;
9976       assess lps var=(age bmi);
9977       output out(obs=match)=matched matchid=matchid;
9978       run;

