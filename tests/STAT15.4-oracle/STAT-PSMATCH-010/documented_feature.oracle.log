9962       data patients;
9963       call streaminit(419);
9964       do patientid=1 to 100;
9965       gender=mod(patientid,2);
9966       age=30+mod(patientid*7,45);
9967       bmi=20+mod(patientid,12);
9968       drug=rand('bernoulli',0.5);
9969       output;
