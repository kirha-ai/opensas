19101    !                                         quit;


19102      ods path work.templat(update) sashelp.tmplmst(read);
19103      
19104      data survey;
19105      do state=1 to 2;
19106      do school=1 to 4;
19107      do id=1 to 6;
19108      response=1+mod(id+school,3);
19109      schooltype=1+mod(school,2);
19110      samplingweight=2+state+school/10;
19111      output;
19112      end;
19113      end;
19114      end;
19115      run;

NOTE: The data set WORK.SURVEY has 48 observations and 6 variables.

19116      proc surveyfreq data=survey;
19117      strata state;
19118      cluster school;
19119      weight samplingweight;
19120      tables schooltype*response / row chisq;
19121      run;

NOTE: The Rao-Scott chi-square test cannot be computed for the table of schooltype by response because the design correction is not positive.
