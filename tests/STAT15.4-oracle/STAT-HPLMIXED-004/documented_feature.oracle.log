2778       data SchoolSample;
2779       do SchoolID = 1 to 300;
2780       do nID = 1 to 25;
2781       Neighborhood = (SchoolID-1)*5 + nId;
2782       bInt = 5 *ranuni(1);
2783       bTime = 5 *ranuni(1);
2784       bTime2 = ranuni(1);
2785       do sID = 1 to 2;
2786       do Time = 1 to 4;
2787       Math = bInt + bTime*Time + bTime2*Time*Time + rannor(2);
2788       output;
2789       end;
2790       end;
2791       end;
2792       end;
2793       run;

NOTE: The data set WORK.SCHOOLSAMPLE has 60000 observations and 9 variables.

2794       proc hplmixed data=SchoolSample;
2795       class Neighborhood SchoolID;
2796       model Math = Time Time*Time / solution;
2797       random int Time Time *Time / sub=Neighborhood(SchoolID) type=un;
2798       run;

