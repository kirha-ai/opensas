6365       %let na = 100;
6366       %let nb = 5;
6367       %let nr = 2;
6368       data nested;
6369       do A = 1 to &na;
6370       err1 = 3*rannor(339205);
6371       do B = 1 to &nb;
6372       err2 = 2*rannor(314159);
6373       do rep = 1 to &nr;
6374       err3 = 1*rannor(314159);
6375       resp = 10 + err1 + err2 + err3;
6376       output;
6377       end;
6378       end;
6379       end;
6380       run;

NOTE: The data set WORK.NESTED has 1000 observations and 7 variables.

6381       proc nlmixed data = nested;
6382       bounds vara >=0, varb_a >=0;
6383       mean = intercept + aeffect + beffect;
6384       model resp ~ normal (mean, s2);
6385       random aeffect ~ normal(0,vara) subject = A;
6386       random beffect ~ normal(0,varb_a) subject = B(A);
6387       run;

NOTE: To assign starting values to parameters, use the PARMS statement. The default starting value of 1.0 is in effect for all parameters.
NOTE: Convergence criterion (GCONV=1E-6) satisfied.
