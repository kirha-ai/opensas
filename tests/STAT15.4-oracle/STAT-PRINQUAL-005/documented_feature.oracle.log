1859       title 'Preference Ratings for Automobiles Manufactured in 1980';
1860       options validvarname=any;
1861       data CarPref;
1862       input Make $ 1-10 Model $ 12-22 @25 ('1'n-'25'n) (1.);
1863       datalines;

NOTE: The data set WORK.CARPREF has 17 observations and 27 variables.

1881       ;
1882       ods graphics on;
1883       * Principal Component Analysis of the Original Data;
1884       proc princomp data=CarPref;
1885       ods select ScreePlot;
1886       var '1'n-'25'n;
1887       run;

WARNING: The Correlation Matrix is not positive definite.

