1888       * Transform the Data to Better Fit a Two Component Model;
1889       proc prinqual data=CarPref out=Results n=2 replace mdpref;
1890       title2 'Multidimensional Preference (MDPREF) Analysis';
1891       title3 'Optimal Monotonic Transformation of Preference Data';
1892       id model;
1893       transform monotone('1'n-'25'n);
1894       run;


