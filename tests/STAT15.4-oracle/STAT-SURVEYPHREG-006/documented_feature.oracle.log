23034      do id=1 to 12;
23035      age=20+mod(id*7+cluster,45);
23036      time=1+rand('exponential')*10;
23037      status=(mod(id,4) ne 0);
23038      weight=2+stratum+cluster/10;
23039      output;
23040      end;
23041      end;
23042      end;
