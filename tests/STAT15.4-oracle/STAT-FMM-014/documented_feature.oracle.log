4105       data assay;
4106       label dose = 'Dose of quinoline (microg/plate)'
4107       num = 'Observed number of colonies';
4108       input dose @;
4109       logd = log(dose+10);
4110       do i=1 to 3;
4111       input num@;
4112       output;
4113       end;
4114       datalines;

NOTE: The data set WORK.ASSAY has 18 observations and 4 variables.

4121       ;
4122       proc fmm data=assay seed=314159;
4123       model num = dose logd / dist=Poisson;
4124       run;

NOTE: Convergence criterion (GCONV=1E-8) satisfied.
NOTE: The PROCEDURE FMM printed page 257.

4125       proc fmm data=assay seed=314159;
4126       model num = dose logd / dist=Poisson k=2
4127       equate=effects(dose logd);
4128       run;

NOTE: Convergence criterion (GCONV=1E-8) satisfied.
NOTE: The PROCEDURE FMM printed page 258.

4129       proc fmm data=assay seed=314159;
4130       model num = dose logd / dist=Poisson k=2;
4131       restrict 'common dose' dose 1, dose -1;
4132       restrict 'common logd' logd 1, logd -1;
