9802       data patients;
9803       call streaminit(419);
9804       do patientid=1 to 100;
9805       gender=mod(patientid,2);
9806       age=30+mod(patientid*7,45);
9807       bmi=20+mod(patientid,12);
9808       drug=rand('bernoulli',0.5);
9809       output;
9810       end;
9811       run;

NOTE: The data set WORK.PATIENTS has 100 observations and 5 variables.

9812       proc psmatch data=patients region=cs;
9813       class drug gender;
9814       psmodel drug(treated='1')=gender age bmi;
9815       match method=greedy(k=1) distance=lps caliper=0.5;
9816       assess lps var=(age bmi);
9817       output out(obs=match)=matched matchid=matchid;
9818       run;

WARNING: Some treated units do not have matched controls because there are not enough available controls for these treated units.
