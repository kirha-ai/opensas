NOTE: The data set WORK.TEST has 9 observations and 11 variables.

16093      ;
16094      title2 'A nine-variable-three-factor example';
16095      proc factor data=test method=ml reorder rotate=quartimin
16096      nobs=200 n=3 se cover=.45 alpha=.1;
16097      run;

