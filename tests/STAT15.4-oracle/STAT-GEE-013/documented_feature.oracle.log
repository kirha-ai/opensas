21925      ;
21926      proc gee data=Children descending;
21927      class ID City;
21928      model Symptom = City Age Smoke / dist=bin link=logit;
21929      repeated subject=ID / type=exch covb corrw;
21930      run;

NOTE: PROC GEE is modeling the probability that Symptom='1'.
