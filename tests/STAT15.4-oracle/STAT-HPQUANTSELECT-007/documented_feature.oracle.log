4914       /* STAT-HPQUANTSELECT-007: HPQUANTSELECT — Using the Validation ACL as the SELECT= Criterion / Computational Method
4915        * Source: S154 / Chapter 66 / `Using the Validation ACL as the SELECT= Criterion` (PDF p. 5006); S154 / Chapter 66 / `Computational Method` (PDF pp.
4915     !  5006–5007).
4916        * Discriminates: Seeded synthetic quantile-regression fixture: Using the Validation ACL as the SELECT= Criterion / Computational Method
4917        */
4918       options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
4918     ! validmemname=compatible locale=en_US;
4919       %let syscc=0;
4920       title; footnote;
4921       ods _all_ close;
4922       ods listing gpath="%sysfunc(pathname(work))";
4923       ods graphics off;
4924       proc datasets library=work kill nolist;
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK.SAMPLE (memtype=DATA).
NOTE: Deleting WORK.TEMPLAT (memtype=ITEMSTOR).
NOTE: File WORK.TEMPLAT (memtype=ITEMSTOR) cannot be deleted because it is in use.
4924     !                                         quit;


4925       ods path work.templat(update) sashelp.tmplmst(read);
4926       
4927       data sample;
4928       call streaminit(314159);
4929       do id=1 to 120;
4930        x=rand('normal'); z=rand('normal'); w=rand('normal'); group=1+mod(id,3);
4931        y=2+1.5*x-0.6*z+0.4*group+rand('normal');
4932        role=mod(id,4); output;
4933       end;
4934       run;

NOTE: The data set WORK.SAMPLE has 120 observations and 7 variables.

4935       
4936       proc hpquantselect data=sample;
4937       class group;
4938       model y=x z w group / quantile=0.5 clb;
4939       partition rolevar=role(validate="0");
4940       selection method=forward(select=validate choose=validate);
4941       performance nthreads=1;
4942       run;

NOTE: The HPQUANTSELECT procedure is executing in single-machine mode.
NOTE: The PROCEDURE HPQUANTSELECT printed pages 187-189.

