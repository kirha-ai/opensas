1470       options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
1470     ! validmemname=compatible locale=en_US;
1471       %let syscc=0;
1472       title; footnote;
1473       ods _all_ close;
1474       ods listing gpath="%sysfunc(pathname(work))";
1475       ods graphics off;
1476       proc datasets library=work kill nolist;
NOTE: Deleting WORK.EXPOSED (memtype=DATA).
