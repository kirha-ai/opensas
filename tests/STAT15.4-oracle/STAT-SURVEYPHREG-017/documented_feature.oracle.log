23481      data survey;
23482      call streaminit(722);
23483      do stratum=1 to 2;
23484      do cluster=1 to 4;
23485      do id=1 to 12;
23486      age=20+mod(id*7+cluster,45);
23487      time=1+rand('exponential')*10;
23488      status=(mod(id,4) ne 0);
23489      weight=2+stratum+cluster/10;
23490      output;
23491      end;
23492      end;
23493      end;
23494      run;

