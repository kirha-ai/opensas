NOTE: The data set WORK.EXEMPLARY has 6 observations and 3 variables.

27018      ;
27019      proc glmpower data=Exemplary;
27020      class Variety Exposure;
27021      model Height = Variety | Exposure;
27022      power
27023      stddev = 5
27024      ntotal = 60
27025      power = .;
27026      run;

