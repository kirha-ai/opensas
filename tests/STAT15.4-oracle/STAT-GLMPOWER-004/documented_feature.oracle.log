27047      ;
27048      proc glmpower data=Exemplary;
27049      class Variety Exposure;
27050      model HeightOrig HeightNew = Variety | Exposure;
27051      weight Weight;
27052      contrast 'Exposure=1 vs Exposure=3' Exposure 1 0 -1;
27053      power
