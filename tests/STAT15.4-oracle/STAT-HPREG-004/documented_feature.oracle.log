5589       data analysisData;
5590       drop i j c3Num;
5591       length c3$ 7;
5592       array x{20} x1-x20;
5593       do i=1 to 15000;
5594       do j=1 to 20;
5595       x{j} = ranuni(1);
5596       end;
5597       c1 = 1 + mod(i,8);
5598       c2 = ranbin(1,3,.6);
5599       if i < 50 then do;
5600       c3 = 'tiny';
5601       c3Num=1;
5602       end;
5603       else if i < 250 then do;
5604       c3 = 'small';
5605       c3Num=1;
5606       end;
5607       else if i < 600 then do;
5608       c3 = 'average';
5609       c3Num=2;
5610       end;
5611       else if i < 1200 then do;
5612       c3 = 'big';
5613       c3Num=3;
5614       end;
5615       else do;
5616       c3 = 'huge';
5617       c3Num=5;
5618       end;
5619       yTrue = 10 + x1 + 2*x5 + 3*x10 + 4*x20 + 3 *x1*x7 + 8*x6*x7
5620       + 5*(c1=3)*c3Num + 8*(c1=7);
5621       error = 5*rannor(1);
5622       y = yTrue + error;
5623       if mod(i,3)=1 then Role = 'TRAIN';
5624       else if mod(i,3)=2 then Role = 'VAL';
5625       else Role = 'TEST';
5626       output;
5627       end;
5628       run;

NOTE: The data set WORK.ANALYSISDATA has 15000 observations and 27 variables.

5629       proc summary data=analysisData;
5630       class role;
5631       ways 1;
5632       var error;
5633       output out=ASE uss=uss n=n;

