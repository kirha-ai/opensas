4506       data artificial;
4507       drop i;
4508       array X{10};
4509       do i=1 to 400;
4510       do j=1 to 10;
4511       X{j} = ranuni(1);
4512       end;
4513       Y = 40*exp(8*((X1-0.5)**2+(X2-0.5)**2))/
4514       (exp(8*((X1-0.2)**2+(X2-0.7)**2))+
4515       exp(8*((X1-0.7)**2+(X2-0.2)**2)))+rannor(1);
4516       output;
4517       end;
4518       run;

NOTE: The data set WORK.ARTIFICIAL has 400 observations and 12 variables.

4519       ods graphics on;
4520       proc adaptivereg data=artificial plots=fit;
4521       model y=x1-x10;
4522       run;

NOTE: The PROCEDURE ADAPTIVEREG printed page 334.

4523       data score;
4524       do X1=0 to 1 by 0.01;
4525       do X2=0 to 1 by 0.01;
4526       Y=40*exp(8*((X1-0.5)**2+(X2-0.5)**2))/
4527       (exp(8*((X1-0.2)**2+(X2-0.7)**2))+
4528       exp(8*((X1-0.7)**2+(X2-0.2)**2)));
4529       output;
4530       end;
4531       end;
4532       run;

NOTE: The data set WORK.SCORE has 10201 observations and 3 variables.

4533       proc adaptivereg data=artificial;
4534       model y=x1-x10;
4535       score data=score out=scoreout;
4536       run;

NOTE: The data set WORK.SCOREOUT has 10201 observations and 4 variables.
