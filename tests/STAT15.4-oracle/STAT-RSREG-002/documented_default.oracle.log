14982      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
14982    ! validmemname=compatible locale=en_US;
14983      %let syscc=0;
14984      title; footnote;
14985      ods _all_ close;
14986      ods listing gpath="%sysfunc(pathname(work))";
14987      ods graphics off;
14988      proc datasets library=work kill nolist;
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
