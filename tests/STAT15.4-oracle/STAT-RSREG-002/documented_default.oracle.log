14988    !                                         quit;


14989      ods path work.templat(update) sashelp.tmplmst(read);
14990      
14991      title 'Response Surface with a Simple Optimum';
14992      data smell;
14993      input Odor T R H @@;
14994      label
14995      T = "Temperature"
14996      R = "Gas-Liquid Ratio"
14997      H = "Packing Height";
14998      datalines;

NOTE: SAS went to a new line when INPUT statement reached past the end of a line.
NOTE: The data set WORK.SMELL has 15 observations and 4 variables.

15003      ;
15004      proc rsreg data=smell;
15005      model Odor = T R H / lackfit;
15006      run;

NOTE: The PROCEDURE RSREG printed pages 1106-1107.

15007      ods graphics on;
15008      proc rsreg data=smell
15009      plots(unpack)=surface(3d at(H=7.541050));
15010      model Odor = T R H;
15011      ods select 'T * R = Pred';
15012      run;


