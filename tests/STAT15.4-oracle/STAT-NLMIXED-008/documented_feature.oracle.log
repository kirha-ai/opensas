93         
94         %let na = 100;
95         %let nb = 5;
96         %let nr = 2;
97         data nested;
98         do A = 1 to &na;
99         err1 = 3*rannor(339205);
100        do B = 1 to &nb;
101        err2 = 2*rannor(314159);
102        do rep = 1 to &nr;
103        err3 = 1*rannor(314159);
104        resp = 10 + err1 + err2 + err3;
105        output;
106        end;
107        end;
108        end;
109        run;

NOTE: The data set WORK.NESTED has 1000 observations and 7 variables.

110        proc nlmixed data = nested;
111        bounds vara >=0, varb_a >=0;
112        mean = intercept + aeffect + beffect;
113        model resp ~ normal (mean, s2);
114        random aeffect ~ normal(0,vara) subject = A;
115        random beffect ~ normal(0,varb_a) subject = B(A);
116        run;

NOTE: To assign starting values to parameters, use the PARMS statement. The default starting value of 1.0 is in effect for all parameters.
NOTE: Convergence criterion (GCONV=1E-6) satisfied.
NOTE: At least one element of the gradient is greater than 1e-3.
NOTE: The PROCEDURE NLMIXED printed page 2.

