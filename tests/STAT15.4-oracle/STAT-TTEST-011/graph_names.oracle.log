29107      /* STAT-TTEST-011: TTEST — ODS Graphics
29108       * Source: S154 / Chapter 128 / `ODS Graphics` (PDF pp. 10644–10650).
29109       * Discriminates: Interval and QQ graph creation and ODS TRACE names; text listing is paired with the graph trace
29110       */
29111      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
29111    ! validmemname=compatible locale=en_US;
29112      %let syscc=0;
29113      title; footnote;
29114      ods _all_ close;
29115      ods listing gpath="%sysfunc(pathname(work))";
29116      ods graphics off;
29117      proc datasets library=work kill nolist;
NOTE: Deleting WORK.LIMITS (memtype=DATA).
