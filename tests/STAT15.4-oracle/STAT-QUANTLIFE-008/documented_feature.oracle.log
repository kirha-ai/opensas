10354      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
10354    ! validmemname=compatible locale=en_US;
10355      %let syscc=0;
10356      title; footnote;
10357      ods _all_ close;
10358      ods listing gpath="%sysfunc(pathname(work))";
10359      ods graphics off;
10360      proc datasets library=work kill nolist;
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
