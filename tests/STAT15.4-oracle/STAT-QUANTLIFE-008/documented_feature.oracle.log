10360    !                                         quit;


10361      ods path work.templat(update) sashelp.tmplmst(read);
10362      
10363      ods trace on;
10364      data survival;
10365      call streaminit(518);
10366      do id=1 to 80;
10367      drug=mod(id,2);
10368      age=25+mod(id*7,40);
10369      time=exp(2+0.25*drug+0.008*age+rand('normal')*0.4);
10370      status=(mod(id,5) ne 0);
10371      output;
10372      end;
10373      run;

NOTE: The data set WORK.SURVIVAL has 80 observations and 5 variables.

10374      proc quantlife data=survival seed=1268;
10375      class drug;
10376      model time*status(0)=drug age / quantile=0.5;
10377      run;


