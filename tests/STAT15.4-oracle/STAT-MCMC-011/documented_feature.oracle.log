16331      proc mcmc data=stagnant outpost=postout seed=24860 ntu=1000
16332      nmc=1000 nbi=200;
16333      ods select PostSumInt;
16334      ods output PostSumInt=ds;
16335      array beta[2];
16336      parms alpha cp beta1 beta2;
16337      parms s2;
16338      prior cp ~ unif(-1.3, 1.1);
16339      prior s2 ~ uniform(0, 5);
16340      prior alpha beta: ~ normal(0, v = 1e6);
16341      j = 1 + (x >= cp);
16342      mu = alpha + beta[j] * (x - cp);
16343      model y ~ normal(mu, var=s2);
16344      run;

