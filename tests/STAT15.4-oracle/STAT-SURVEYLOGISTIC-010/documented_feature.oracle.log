20991      data survey;
20992      call streaminit(722);
20993      do stratum=1 to 2;
20994      do cluster=1 to 4;
20995      do id=1 to 12;
20996      age=20+mod(id*7+cluster,45);
20997      event=rand('bernoulli',0.3);
20998      weight=2+stratum+cluster/10;
20999      output;
21000      end;
21001      end;
21002      end;
21003      run;

NOTE: The data set WORK.SURVEY has 96 observations and 6 variables.

21004      proc surveylogistic data=survey;
21005      strata stratum;
21006      cluster cluster;
21007      weight weight;
21008      model event(event='1')=age;
21009      run;

NOTE: PROC SURVEYLOGISTIC is modeling the probability that event=1.
