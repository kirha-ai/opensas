10047      data patients;
10048      call streaminit(419);
10049      do patientid=1 to 100;
10050      gender=mod(patientid,2);
10051      age=30+mod(patientid*7,45);
10052      bmi=20+mod(patientid,12);
10053      drug=rand('bernoulli',0.5);
10054      output;
10055      end;
10056      run;

NOTE: The data set WORK.PATIENTS has 100 observations and 5 variables.

10057      proc psmatch data=patients region=cs;
10058      class drug gender;
10059      psmodel drug(treated='1')=gender age bmi;
10060      match method=greedy(k=1) distance=lps caliper=0.5;
10061      assess lps var=(age bmi);
10062      output out(obs=match)=matched matchid=matchid;
10063      run;

