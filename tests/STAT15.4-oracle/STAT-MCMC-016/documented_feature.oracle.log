16732      proc mcmc data=behrens outpost=postout seed=123
16733      nmc=1000 monitor=(_parms_ mudif)
16734      statistics(alpha=0.01) nbi=200;
16735      ods select PostSumInt;
16736      parm mu1 0 mu2 0;
16737      parm sig21 1;
16738      parm sig22 1;
16739      prior mu: ~ general(0);
16740      prior sig21 ~ general(-log(sig21), lower=0);
16741      prior sig22 ~ general(-log(sig22), lower=0);
16742      mudif = mu1 - mu2;
16743      if ind = 1 then do;
16744      mu = mu1;
16745      s2 = sig21;
16746      end;
16747      else do;
16748      mu = mu2;
16749      s2 = sig22;
16750      end;
16751      model y ~ normal(mu, var=s2);
16752      run;

