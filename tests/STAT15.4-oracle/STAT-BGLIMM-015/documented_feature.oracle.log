214        proc bglimm data=pr seed=475193 outpost=pr_out nmc=1000 nbi=200;
215        class Person Gender Time;
216        model Distance = Age|Gender;
217        repeated Time / type=un subject=Person group=Gender r;
218        estimate 'Girls Intercept' Int 1 Gender 1 0;
219        estimate 'Boys Intercept' Int 1 Gender 0 1;
220        estimate 'Girls Slope' Age 1 Age*Gender 1 0;
221        estimate 'Boys Slope' Age 1 Age*Gender 0 1;
222        run;

