230        proc bglimm data=pr seed=475193 outpost=pr_out nmc=1000 nbi=200;
231        class Person Gender Time;
232        model Distance = Gender Age*Gender / noint;
233        repeated Time / type=un subject=Person group=Gender;
234        estimate 'Intercept Difference' Gender 1 -1;
