12926       */
12927      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
12927    ! validmemname=compatible locale=en_US;
12928      %let syscc=0;
12929      title; footnote;
12930      ods _all_ close;
12931      ods listing gpath="%sysfunc(pathname(work))";
12932      ods graphics off;
12933      proc datasets library=work kill nolist;
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK.SASGOPT (memtype=CATALOG).
