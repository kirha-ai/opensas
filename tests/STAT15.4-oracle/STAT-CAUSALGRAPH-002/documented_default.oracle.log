12934      ods path work.templat(update) sashelp.tmplmst(read);
12935      
12936      proc causalgraph;
12937      model "Timm17TwoLatent"
12938      Age ==> Parity PFAS Education,
12939      Parity ==> PrevBF Duration PFAS,
12940      PrevBF ==> PFAS Duration,
12941      PFAS ==> Duration,
12942      Education ==> Duration Employment PFAS BMI Alcohol Smoking,
12943      Employment ==> Duration PFAS BMI Alcohol Smoking,
12944      BMI Alcohol Smoking ==> Duration;
12945      identify PFAS ==> Duration;
12946      unmeasured Alcohol Smoking;
12947      run;

