3214       ;
3215       ods graphics on;
3216       proc sim2d data=thick outsim=sim plot=(observ sim);
3217       coordinates xc=East yc=North;
3218       simulate var=Thick numreal=100 seed=79931
3219       scale=7.4599 range=30.1111 nugget=1e-8 form=gauss;
3220       mean 40.1173;
3221       grid x=0 to 100 by 25 y=0 to 100 by 25;
3222       run;

