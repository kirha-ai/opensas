2028       ;
2029       * Find maximum rank for each news service and replace
2030       * each missing value with the next highest rank.;
2031       proc means data=bballm noprint;
2032       output out=maxrank
2033       max=mcsn mdurs mdurh mwas musa mspom mins mupi map mspoi;
2034       run;

NOTE: There were 35 observations read from the data set WORK.BBALLM.
NOTE: The data set WORK.MAXRANK has 1 observations and 12 variables.

2035       data bball;
2036       set bballm;
2037       if _n_=1 then set maxrank;
2038       array services[10] CSN--SportsIllustrated;
2039       array maxranks[10] mcsn--mspoi;
2040       keep School CSN--SportsIllustrated;
2041       do i=1 to 10;
2042       if services[i]=. then services[i]=maxranks[i]+1;
2043       end;
2044       run;

NOTE: There were 35 observations read from the data set WORK.BBALLM.
NOTE: There were 1 observations read from the data set WORK.MAXRANK.
NOTE: The data set WORK.BBALL has 35 observations and 11 variables.

2045       * Assume that the ranks are ordinal and that unranked teams would have
2046       * been ranked lower than ranked teams. Monotonically transform all ranked
2047       * teams while estimating the unranked teams. Enforce the constraint that
2048       * the missing ranks are estimated to be less than the observed ranks.
2049       * Order the unranked teams optimally within this constraint. Do this so
2050       * as to maximize the variance accounted for by one linear combination.
2051       * This makes the data as nearly rank one as possible, given the constraints.
2052       *
2053       * NOTE: The UNTIE transformation should be used with caution.
2054       * It frequently produces degenerate results.;
2055       ods graphics on;
2056       proc prinqual data=bball out=tbball scores n=1 tstandard=z
2057       plots=transformations;
2058       title2 'Optimal Monotonic Transformation of Ranked Teams';
2059       title3 'with Constrained Estimation of Unranked Teams';
2060       transform untie(CSN -- SportsIllustrated);
2061       id School;
2062       run;


