2038       options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
2038     ! validmemname=compatible locale=en_US;
2039       %let syscc=0;
2040       title; footnote;
2041       ods _all_ close;
2042       ods listing gpath="%sysfunc(pathname(work))";
2043       ods graphics off;
2044       proc datasets library=work kill nolist;
