10278      ;
10279      ods graphics on;
10280      proc variogram data=thick noprint;
10281      store out=SemivStoreGau / label='Thickness Gaussian Model';
10282      compute lagd=7 maxlag=10;
10283      coord xc=East yc=North;
10284      model form=gau;
10285      var Thick;
10286      run;

NOTE: No DIRECTIONS statement and no NDIRECTIONS=, or NDIRECTIONS=0 specified: Computing omnidirectional semivariogram.

10287      proc krige2d data=thick outest=pred1 noprint;
10288      restore in=SemivStoreGau;
10289      coordinates xc=East yc=North;
10290      predict var=Thick r=60;
10291      model storeselect;
10292      grid x=0 to 100 by 10 y=0 to 100 by 10;
10293      run;

