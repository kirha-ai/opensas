10308      data compare;
10309      merge pred1(rename=(estimate=g_prd stderr=g_std))
10310      pred2(rename=(estimate=s_prd stderr=s_std));
10311      prdRelDif = ((g_prd-s_prd) / s_prd) * 100;
10312      stdRelDif = ((g_std-s_std) / s_std) * 100;
10313      run;

