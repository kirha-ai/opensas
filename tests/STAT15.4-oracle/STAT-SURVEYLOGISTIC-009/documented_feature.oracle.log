20951      data survey;
20952      call streaminit(722);
20953      do stratum=1 to 2;
20954      do cluster=1 to 4;
20955      do id=1 to 12;
20956      age=20+mod(id*7+cluster,45);
20957      event=rand('bernoulli',0.3);
20958      weight=2+stratum+cluster/10;
20959      output;
