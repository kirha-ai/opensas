12425      
12426      title 'Survival of Males with Angina Pectoris';
12427      data Males;
12428      keep Freq Years Censored;
12429      retain Years -.5;
12430      input fail withdraw @@;
12431      Years + 1;
12432      Censored=0;
12433      Freq=fail;
12434      output;
12435      Censored=1;
12436      Freq=withdraw;
12437      output;
12438      datalines;

NOTE: SAS went to a new line when INPUT statement reached past the end of a line.
NOTE: The data set WORK.MALES has 32 observations and 3 variables.

12442      ;
12443      ods graphics on;
12444      proc lifetest data=Males method=lt intervals=(0 to 15 by 1)
12445      plots=(s,ls,lls,h,p);
12446      time Years*Censored(1);
12447      freq Freq;
12448      run;

NOTE: The LOGLOG transform is used to compute the confidence limits for the quartiles of the survivor distribution. To suppress using this transform, specify 
