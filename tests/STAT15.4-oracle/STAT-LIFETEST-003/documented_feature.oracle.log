12417      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
12417    ! validmemname=compatible locale=en_US;
12418      %let syscc=0;
12419      title; footnote;
12420      ods _all_ close;
