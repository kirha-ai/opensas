10293      data survival;
10294      call streaminit(518);
10295      do id=1 to 80;
10296      drug=mod(id,2);
10297      age=25+mod(id*7,40);
10298      time=exp(2+0.25*drug+0.008*age+rand('normal')*0.4);
10299      status=(mod(id,5) ne 0);
10300      output;
10301      end;
10302      run;

NOTE: The data set WORK.SURVIVAL has 80 observations and 5 variables.

10303      proc quantlife data=survival seed=1268;
10304      class drug;
10305      model time*status(0)=drug age / quantile=0.5;
10306      run;

