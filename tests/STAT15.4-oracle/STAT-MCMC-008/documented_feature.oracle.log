16085      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
16085    ! validmemname=compatible locale=en_US;
16086      %let syscc=0;
16087      title; footnote;
16088      ods _all_ close;
