16248      title 'Multivariate Normal Random-Effects Model';
16249      data rats;
16250      array days[5] (8 15 22 29 36);
16251      input weight @@;
16252      subject = ceil(_n_/5);
16253      index = mod(_n_-1, 5) + 1;
16254      age = days[index];
16255      drop index days:;
16256      datalines;

NOTE: SAS went to a new line when INPUT statement reached past the end of a line.
NOTE: The data set WORK.RATS has 150 observations and 3 variables.

16272      ;
16273      proc mcmc data=rats nmc=1000 outpost=postout
16274      seed=17 init=random nbi=200;
16275      ods select Parameters REParameters PostSumInt;
16276      array theta[2] alpha beta;
16277      array theta_c[2];
16278      array Sig_c[2,2];
16279      array mu0[2] (0 0);
16280      array Sig0[2,2] (1000 0 0 1000);
16281      array S[2,2] (0.02 0 0 20);
16282      parms theta_c Sig_c {121 0 0 0.26} var_y;
16283      prior theta_c ~ mvn(mu0, Sig0);
16284      prior Sig_c ~ iwish(2, S);
16285      prior var_y ~ igamma(0.01, scale=0.01);
16286      random theta ~ mvn(theta_c, Sig_c) subject=subject
16287      monitor=(alpha_9 beta_9 alpha_25 beta_25);
16288      mu = alpha + beta * age;
16289      model weight ~ normal(mu, var=var_y);
16290      run;

NOTE: Tuning the proposal distribution.
NOTE: Generating the burn-in samples.
NOTE: Beginning sample generation.
NOTE: The data set WORK.POSTOUT has 1000 observations and 72 variables.
NOTE: The PROCEDURE MCMC printed pages 1298-1299.

16291      run;
16292      quit;
