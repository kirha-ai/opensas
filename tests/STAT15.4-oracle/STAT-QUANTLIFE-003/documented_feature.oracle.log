10186      ods path work.templat(update) sashelp.tmplmst(read);
10187      
10188      data survival;
10189      call streaminit(518);
10190      do id=1 to 80;
10191      drug=mod(id,2);
10192      age=25+mod(id*7,40);
10193      time=exp(2+0.25*drug+0.008*age+rand('normal')*0.4);
10194      status=(mod(id,5) ne 0);
10195      output;
10196      end;
10197      run;

NOTE: The data set WORK.SURVIVAL has 80 observations and 5 variables.

10198      proc quantlife data=survival seed=1268;
10199      class drug;
10200      model time*status(0)=drug age / quantile=0.5;
10201      run;

