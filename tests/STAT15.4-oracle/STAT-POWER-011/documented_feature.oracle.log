6977       * Fetch -2LogL for reduced model;
6978       data statsRed;
6979       set statsRed;
6980       where Criterion = "-2 Log L";
6981       Neg2LogLRed = InterceptAndCovariates;
6982       keep Neg2LogLRed;
6983       run;

NOTE: There were 1 observations read from the data set WORK.STATSRED.
      WHERE Criterion='-2 Log L';
NOTE: The data set WORK.STATSRED has 1 observations and 1 variables.

6984       * Compute primary noncentralities for Wald and LR tests;
6985       data PrimNC;
6986       merge fitFull statsFull statsRed;
6987       WaldPrimNC = WaldChiSq / 20;
6988       LRPrimNC = -(Neg2LogLFull-Neg2LogLRed) / 20;
6989       keep DF WaldPrimNC LRPrimNC;
6990       call symput ("DF", DF);
6991       call symput ("WaldPrimNC", WaldPrimNC);
6992       call symput ("LRPrimNC", LRPrimNC);
6993       run;

