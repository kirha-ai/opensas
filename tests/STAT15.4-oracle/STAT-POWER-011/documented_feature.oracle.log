6996       proc power;
6997       custom
6998       dist = chisquare
6999       primnc = &WaldPrimNC &LRPrimNC
7000       testdf = &DF
7001       ntotal = 100
7002       power = .;
7003       run;

NOTE: The PROCEDURE POWER printed page 553.

7004       data Power;
7005       set PrimNC;
7006       Crit = quantile("chisq", 1-0.05, DF);
7007       WaldPower = sdf("chisq", Crit, DF, 100 * WaldPrimNC);
7008       LRPower = sdf("chisq", Crit, DF, 100 * LRPrimNC);
7009       keep WaldPower LRPower;
7010       run;

NOTE: There were 1 observations read from the data set WORK.PRIMNC.
