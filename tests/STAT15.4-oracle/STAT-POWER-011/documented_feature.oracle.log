6958       * Fetch Wald chi-square statistic for test of X1*X2;
6959       data fitFull;
6960       set fitFull;
6961       where Variable = "X1*X2";
6962       keep DF WaldChiSq;
6963       run;

NOTE: There were 1 observations read from the data set WORK.FITFULL.
      WHERE Variable='X1*X2';
