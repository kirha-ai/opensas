14626      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
14626    ! validmemname=compatible locale=en_US;
14627      %let syscc=0;
14628      title; footnote;
14629      ods _all_ close;
14630      ods listing gpath="%sysfunc(pathname(work))";
14631      ods graphics off;
14632      proc datasets library=work kill nolist;
NOTE: Deleting WORK.PHD (memtype=DATA).
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
