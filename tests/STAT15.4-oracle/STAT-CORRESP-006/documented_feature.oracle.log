14633      ods path work.templat(update) sashelp.tmplmst(read);
14634      
14635      title "Number of Ph.D.'s Awarded from 1973 to 1978";
14636      data PhD;
14637      input Science $ 1-19 y1973-y1978;
14638      label y1973 = '1973'
14639      y1974 = '1974'
14640      y1975 = '1975'
14641      y1976 = '1976'
14642      y1977 = '1977'
14643      y1978 = '1978';
14644      datalines;

NOTE: The data set WORK.PHD has 6 observations and 7 variables.

14651      ;
14652      ods graphics on;
14653      proc corresp data=PhD out=Results short chi2p;
14654      var y1973-y1978;
14655      id Science;
14656      run;

