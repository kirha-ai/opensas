27753      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
27753    ! validmemname=compatible locale=en_US;
27754      %let syscc=0;
27755      title; footnote;
27756      ods _all_ close;
27757      ods listing gpath="%sysfunc(pathname(work))";
27758      ods graphics off;
