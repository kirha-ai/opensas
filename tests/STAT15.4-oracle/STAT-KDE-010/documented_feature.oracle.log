9804       data bivnormal;
9805       seed = 1283470;
9806       do i = 1 to 1000;
9807       z1 = rannor(seed);
9808       z2 = rannor(seed);
9809       z3 = rannor(seed);
9810       x = 3*z1+z2;
9811       y = 3*z1+z3;
9812       output;
9813       end;
9814       drop seed;
9815       run;

NOTE: The data set WORK.BIVNORMAL has 1000 observations and 6 variables.

9816       ods graphics on;
9817       proc kde data=bivnormal;
9818       univar x / plots=(density histogram histdensity);
9819       univar x y / plots=densityoverlay;
9820       run;

