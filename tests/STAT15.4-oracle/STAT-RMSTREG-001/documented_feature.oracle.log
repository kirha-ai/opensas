13316      ods path work.templat(update) sashelp.tmplmst(read);
13317      
13318      data survival;
13319      call streaminit(218);
13320      do id=1 to 100;
13321      age=25+mod(id*7,40);
13322      x=mod(id,2);
13323      time=exp(0.5+0.15*x+0.01*age+rand('normal')*0.7);
13324      status=(mod(id,4) ne 0);
13325      output;
13326      end;
13327      run;

NOTE: The data set WORK.SURVIVAL has 100 observations and 5 variables.

13328      proc rmstreg data=survival tau=5;
13329      model time*status(0)=age x / link=linear method=pv;
13330      run;

NOTE: Algorithm converged.
