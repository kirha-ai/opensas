10557      ;
10558      ods graphics on;
10559      proc krige2d data=thick;
10560      coordinates xc=East yc=North;
10561      predict var=Thick radius=60;
10562      model scale=7.4599 range=30.1111 form=gauss;
10563      grid x=0 to 100 by 2.5 y=0 to 100 by 2.5;
10564      run;

NOTE: The data set WORK.DATA10 has 1681 observations and 7 variables.
