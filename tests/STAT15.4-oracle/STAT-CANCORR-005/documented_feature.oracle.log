11665      ods trace on;
11666      data Jobs;
11667      input Career Supervisor Finance Variety Feedback Autonomy;
11668      label Career ='Career Satisfaction' Variety ='Task Variety'
11669      Supervisor='Supervisor Satisfaction' Feedback='Amount of Feedback'
11670      Finance ='Financial Satisfaction' Autonomy='Degree of Autonomy';
11671      datalines;

NOTE: The data set WORK.JOBS has 14 observations and 6 variables.

11686      ;
11687      proc cancorr data=Jobs
