2734       ods path work.templat(update) sashelp.tmplmst(read);
2735       
2736       data SchoolSample;
2737       do SchoolID = 1 to 300;
2738       do nID = 1 to 25;
2739       Neighborhood = (SchoolID-1)*5 + nId;
2740       bInt = 5 *ranuni(1);
2741       bTime = 5 *ranuni(1);
2742       bTime2 = ranuni(1);
2743       do sID = 1 to 2;
2744       do Time = 1 to 4;
2745       Math = bInt + bTime*Time + bTime2*Time*Time + rannor(2);
2746       output;
2747       end;
2748       end;
2749       end;
2750       end;
2751       run;

NOTE: The data set WORK.SCHOOLSAMPLE has 60000 observations and 9 variables.

2752       proc hplmixed data=SchoolSample;
2753       class Neighborhood SchoolID;
2754       model Math = Time Time*Time / solution;
2755       random int Time Time *Time / sub=Neighborhood(SchoolID) type=un;
2756       run;

NOTE: The HPLMIXED procedure is executing in single-machine mode.
NOTE: Convergence criterion (ABSGCONV=0.00001) satisfied.
