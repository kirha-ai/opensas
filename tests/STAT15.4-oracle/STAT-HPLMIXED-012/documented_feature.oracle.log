3188       ods path work.templat(update) sashelp.tmplmst(read);
3189       
3190       %let NCenter = 100;
3191       %let NPatient = %eval(&NCenter*50);
3192       %let NTime = 3;
3193       %let SigmaC = 2.0;
3194       %let SigmaP = 4.0;
3195       %let SigmaE = 8.0;
3196       %let Seed = 12345;
3197       data WeekSim;
3198       keep Gender Center Patient Time Measurement;
3199       array PGender{&NPatient};
3200       array PCenter{&NPatient};
3201       array PEffect{&NPatient};
3202       array CEffect{&NCenter};
3203       array GEffect{2};
3204       do Center = 1 to &NCenter;
3205       CEffect{Center} = sqrt(&SigmaC)*rannor(&Seed);
3206       end;
3207       GEffect{1} = 10*ranuni(&Seed);
3208       GEffect{2} = 10*ranuni(&Seed);
3209       do Patient = 1 to &NPatient;
3210       PGender{Patient} = 1 + int(2 *ranuni(&Seed));
3211       PCenter{Patient} = 1 + int(&NCenter*ranuni(&Seed));
3212       PEffect{Patient} = sqrt(&SigmaP)*rannor(&Seed);
3213       end;
3214       do Patient = 1 to &NPatient;
3215       Gender = PGender{Patient};
3216       Center = PCenter{Patient};
3217       Mean = 1 + GEffect{Gender} + CEffect{Center} + PEffect{Patient};
3218       do Time = 1 to &nTime;
3219       Measurement = Mean + sqrt(&SigmaE)*rannor(&Seed);
3220       output;
3221       end;
3222       end;
3223       run;

NOTE: The data set WORK.WEEKSIM has 15000 observations and 5 variables.

