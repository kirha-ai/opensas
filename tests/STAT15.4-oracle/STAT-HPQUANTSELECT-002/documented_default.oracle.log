4733       /* STAT-HPQUANTSELECT-002: HPQUANTSELECT — High-performance quantile regression and model selection
4734        * Source: S154 / Chapter 66 / `Getting Started: HPQUANTSELECT Procedure` (PDF pp. 4976–4985); S154 / Chapter 66 / `Overview: HPQUANTSELECT
4734     ! Procedure` (PDF pp. 4972–4976).
4735        * Discriminates: Seeded synthetic quantile-regression fixture: High-performance quantile regression and model selection
4736        */
4737       options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
4737     ! validmemname=compatible locale=en_US;
4738       %let syscc=0;
4739       title; footnote;
4740       ods _all_ close;
4741       ods listing gpath="%sysfunc(pathname(work))";
4742       ods graphics off;
4743       proc datasets library=work kill nolist;
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK.SAMPLE (memtype=DATA).
NOTE: Deleting WORK.TEMPLAT (memtype=ITEMSTOR).
NOTE: File WORK.TEMPLAT (memtype=ITEMSTOR) cannot be deleted because it is in use.
4743     !                                         quit;


4744       ods path work.templat(update) sashelp.tmplmst(read);
4745       
4746       data sample;
4747       call streaminit(314159);
4748       do id=1 to 120;
4749        x=rand('normal'); z=rand('normal'); w=rand('normal'); group=1+mod(id,3);
4750        y=2+1.5*x-0.6*z+0.4*group+rand('normal');
4751        role=mod(id,4); output;
4752       end;
4753       run;

NOTE: The data set WORK.SAMPLE has 120 observations and 7 variables.

4754       
4755       proc hpquantselect data=sample;
4756       class group;
4757       model y=x z w group / quantile=0.5 clb;
4758       
4759       performance nthreads=1;
4760       run;

NOTE: The HPQUANTSELECT procedure is executing in single-machine mode.
NOTE: The PROCEDURE HPQUANTSELECT printed pages 175-176.

