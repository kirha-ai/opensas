27456      title 'Introductory Main-Effects ANOVA Example';
27457      data a;
27458      input y x1 $ x2 $;
27459      datalines;

NOTE: The data set WORK.A has 12 observations and 3 variables.

27472      ;
27473      * Fit a main-effects ANOVA model with 1, 0, -1 coding;
27474      proc transreg ss2;
27475      model identity(y) = class(x1 x2 / effects);
27476      output coefficients replace;
27477      run;

