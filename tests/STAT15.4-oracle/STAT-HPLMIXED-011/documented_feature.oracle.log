3148       data SchoolSample;
3149       do SchoolID = 1 to 300;
3150       do nID = 1 to 25;
3151       Neighborhood = (SchoolID-1)*5 + nId;
3152       bInt = 5 *ranuni(1);
3153       bTime = 5 *ranuni(1);
3154       bTime2 = ranuni(1);
3155       do sID = 1 to 2;
3156       do Time = 1 to 4;
3157       Math = bInt + bTime*Time + bTime2*Time*Time + rannor(2);
3158       output;
3159       end;
3160       end;
3161       end;
3162       end;
3163       run;

NOTE: The data set WORK.SCHOOLSAMPLE has 60000 observations and 9 variables.

3164       proc hplmixed data=SchoolSample;
3165       class Neighborhood SchoolID;
3166       model Math = Time Time*Time / solution;
3167       random int Time Time *Time / sub=Neighborhood(SchoolID) type=un;
3168       run;

