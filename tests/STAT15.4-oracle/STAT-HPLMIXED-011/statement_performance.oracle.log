1822       options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
1822     ! validmemname=compatible locale=en_US;
1823       %let syscc=0;
1824       title; footnote;
1825       ods _all_ close;
1826       ods listing gpath="%sysfunc(pathname(work))";
1827       ods graphics off;
1828       proc datasets library=work kill nolist;
NOTE: Deleting WORK.GETSTARTED (memtype=DATA).
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
