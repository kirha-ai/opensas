1828     !                                         quit;


1829       ods path work.templat(update) sashelp.tmplmst(read);
1830       
1831       data SchoolSample;
1832       do SchoolID = 1 to 300;
1833       do nID = 1 to 25;
1834       Neighborhood = (SchoolID-1)*5 + nId;
1835       bInt = 5 *ranuni(1);
1836       bTime = 5 *ranuni(1);
1837       bTime2 = ranuni(1);
1838       do sID = 1 to 2;
1839       do Time = 1 to 4;
1840       Math = bInt + bTime*Time + bTime2*Time*Time + rannor(2);
1841       output;
1842       end;
1843       end;
1844       end;
1845       end;
1846       run;

NOTE: The data set WORK.SCHOOLSAMPLE has 60000 observations and 9 variables.

1847       proc hplmixed data=SchoolSample;
1848       class Neighborhood SchoolID;
1849       model Math = Time Time*Time / solution;
1850       random int Time Time *Time / sub=Neighborhood(SchoolID) type=un;
1851       
1852       performance nthreads=1;
1853       run;

NOTE: The HPLMIXED procedure is executing in single-machine mode.
NOTE: Convergence criterion (ABSGCONV=0.00001) satisfied.
