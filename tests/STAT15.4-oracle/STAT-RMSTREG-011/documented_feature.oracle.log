13638      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
13638    ! validmemname=compatible locale=en_US;
13639      %let syscc=0;
13640      title; footnote;
13641      ods _all_ close;
13642      ods listing gpath="%sysfunc(pathname(work))";
13643      ods graphics off;
13644      proc datasets library=work kill nolist;
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK.SASGOPT (memtype=CATALOG).
NOTE: File WORK.SASGOPT (memtype=CATALOG) cannot be deleted because it is in use.
NOTE: Deleting WORK.SURVIVAL (memtype=DATA).
NOTE: Deleting WORK.TEMPLAT (memtype=ITEMSTOR).
NOTE: File WORK.TEMPLAT (memtype=ITEMSTOR) cannot be deleted because it is in use.
13644    !                                         quit;


13645      ods path work.templat(update) sashelp.tmplmst(read);
13646      
13647      ods trace on;
13648      data survival;
13649      call streaminit(218);
13650      do id=1 to 100;
13651      age=25+mod(id*7,40);
13652      x=mod(id,2);
13653      time=exp(0.5+0.15*x+0.01*age+rand('normal')*0.7);
13654      status=(mod(id,4) ne 0);
13655      output;
13656      end;
13657      run;

NOTE: The data set WORK.SURVIVAL has 100 observations and 5 variables.

13658      proc rmstreg data=survival tau=5;
13659      model time*status(0)=age x / link=linear method=pv;
13660      run;


