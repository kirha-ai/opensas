25002      ;
25003      proc glimmix data=FerriteCores;
25004      class Temp;
25005      model MagneticForce = Temp;
25006      lsmestimate Temp
25007      'avg(1:1)<avg(2:4)' -3 1 1 1 divisor=3,
25008      'avg(1:2)<avg(3:4)' -1 -1 1 1 divisor=2,
25009      'avg(1:3)<avg(4:4)' -1 -1 -1 3 divisor=3
25010      / adjust=simulate(seed=1) cl upper;
25011      ods select LSMestimates;
25012      run;




