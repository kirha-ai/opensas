23358      data survey;
23359      call streaminit(722);
23360      do stratum=1 to 2;
23361      do cluster=1 to 4;
23362      do id=1 to 12;
23363      age=20+mod(id*7+cluster,45);
23364      time=1+rand('exponential')*10;
23365      status=(mod(id,4) ne 0);
23366      weight=2+stratum+cluster/10;
23367      output;
23368      end;
23369      end;
23370      end;
23371      run;

NOTE: The data set WORK.SURVEY has 96 observations and 7 variables.

23372      proc surveyphreg data=survey;
23373      strata stratum;
23374      cluster cluster;
23375      weight weight;
23376      model time*status(0)=age;
23377      run;

