675        title 'United States Population, 1920-1970';
676        data USPop;
677        * Regions:
678        * New England - ME, NH, VT, MA, RI, CT.
679        * Great Lakes - OH, IN, IL, MI, WI.
680        * South Atlantic - DE, MD, DC, VA, WV, NC, SC, GA, FL.
681        * Mountain - MT, ID, WY, CO, NM, AZ, UT, NV.
682        * Pacific - WA, OR, CA.
683        *
684        * Note: Multiply data values by 1000 to get populations.;
685        length Region $14;
686        input Region :$14. y1920 y1930 y1940 y1950 y1960 y1970;
687        label y1920 = '1920' y1930 = '1930' y1940 = '1940'
688        y1950 = '1950' y1960 = '1960' y1970 = '1970';
689        if region = 'Hawaii' or region = 'Alaska'
690        then w = -1000;
691        /* Flag Supplementary Observations */
692        else w = 1000;
693        datalines;

NOTE: The data set WORK.USPOP has 11 observations and 8 variables.

705        ;
706        ods graphics on;
707        * Perform Simple Correspondence Analysis;
708        proc corresp data=uspop print=percent observed cellchi2 rp cp chi2p
709        short plot(flip);
710        var y1920 -- y1970;
711        id Region;
712        weight w;
713        run;

