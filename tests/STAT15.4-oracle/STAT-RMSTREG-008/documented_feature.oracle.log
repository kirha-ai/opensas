13545      data survival;
13546      call streaminit(218);
13547      do id=1 to 100;
13548      age=25+mod(id*7,40);
13549      x=mod(id,2);
13550      time=exp(0.5+0.15*x+0.01*age+rand('normal')*0.7);
13551      status=(mod(id,4) ne 0);
13552      output;
13553      end;
13554      run;

NOTE: The data set WORK.SURVIVAL has 100 observations and 5 variables.

13555      proc rmstreg data=survival tau=5;
13556      model time*status(0)=age x / link=linear method=pv;
13557      run;

