13511      data survival;
13512      call streaminit(218);
13513      do id=1 to 100;
13514      age=25+mod(id*7,40);
13515      x=mod(id,2);
13516      time=exp(0.5+0.15*x+0.01*age+rand('normal')*0.7);
13517      status=(mod(id,4) ne 0);
13518      output;
13519      end;
13520      run;

NOTE: The data set WORK.SURVIVAL has 100 observations and 5 variables.

13521      proc rmstreg data=survival tau=5;
13522      model time*status(0)=age x / link=linear method=pv;
13523      run;

