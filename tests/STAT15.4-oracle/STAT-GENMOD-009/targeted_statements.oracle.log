1030       data sample;
1031       call streaminit(314159);
1032       do id=1 to 90;
1033        x=rand('normal'); z=rand('normal'); w=rand('normal');
1034        group=1+mod(id,3); block=1+mod(id,5);
1035        y=5+1.5*x-0.6*z+0.4*group+rand('normal');
1036        y2=2+0.5*x+0.8*z+rand('normal'); output;
1037       end;
1038       run;

NOTE: The data set WORK.SAMPLE has 90 observations and 8 variables.

1039       proc genmod data=sample; model y=x z / dist=normal; bayes seed=314159 nbi=200 nmc=1000; run;


