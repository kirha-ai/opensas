10256      ods path work.templat(update) sashelp.tmplmst(read);
10257      
10258      data survival;
10259      call streaminit(518);
10260      do id=1 to 80;
10261      drug=mod(id,2);
10262      age=25+mod(id*7,40);
10263      time=exp(2+0.25*drug+0.008*age+rand('normal')*0.4);
10264      status=(mod(id,5) ne 0);
10265      output;
10266      end;
10267      run;

NOTE: The data set WORK.SURVIVAL has 80 observations and 5 variables.

10268      proc quantlife data=survival seed=1268;
10269      class drug;
10270      model time*status(0)=drug age / quantile=0.5;
10271      run;

