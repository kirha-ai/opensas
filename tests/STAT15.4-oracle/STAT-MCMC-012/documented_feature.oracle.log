16414      proc mcmc data=behrens outpost=postout seed=123
16415      nmc=1000 monitor=(_parms_ mudif)
16416      statistics(alpha=0.01) nbi=200;
16417      ods select PostSumInt;
16418      parm mu1 0 mu2 0;
16419      parm sig21 1;
16420      parm sig22 1;
16421      prior mu: ~ general(0);
16422      prior sig21 ~ general(-log(sig21), lower=0);
16423      prior sig22 ~ general(-log(sig22), lower=0);
16424      mudif = mu1 - mu2;
16425      if ind = 1 then do;
16426      mu = mu1;
16427      s2 = sig21;
16428      end;
16429      else do;
16430      mu = mu2;
16431      s2 = sig22;
16432      end;
16433      model y ~ normal(mu, var=s2);
16434      run;

