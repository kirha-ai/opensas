23399      data survey;
23400      call streaminit(722);
23401      do stratum=1 to 2;
23402      do cluster=1 to 4;
23403      do id=1 to 12;
23404      age=20+mod(id*7+cluster,45);
23405      time=1+rand('exponential')*10;
23406      status=(mod(id,4) ne 0);
23407      weight=2+stratum+cluster/10;
23408      output;
23409      end;
23410      end;
23411      end;
23412      run;

NOTE: The data set WORK.SURVEY has 96 observations and 7 variables.

23413      proc surveyphreg data=survey;
23414      strata stratum;
23415      cluster cluster;
23416      weight weight;
23417      model time*status(0)=age;
23418      run;

