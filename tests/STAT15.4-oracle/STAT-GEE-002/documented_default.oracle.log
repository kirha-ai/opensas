21227      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
21227    ! validmemname=compatible locale=en_US;
21228      %let syscc=0;
21229      title; footnote;
21230      ods _all_ close;
21231      ods listing gpath="%sysfunc(pathname(work))";
21232      ods graphics off;
21233      proc datasets library=work kill nolist;
