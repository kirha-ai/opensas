24007      ;
24008      proc glimmix data=diallel outdesign(z)=zmat;
24009      class block sym p m;
24010      effect line = mm(p m);
24011      model time = block;
24012      random line sym p m p*m;
24013      run;

NOTE: When neither METHOD=QUADRATURE nor METHOD=LAPLACE is specified, the default degrees-of-freedom method in models with random effects and constructed 
