23985      data diallel;
23986      label time = 'Flowering time in days';
23987      do p = 1 to 8;
23988      do m = 1 to 8;
23989      if (m ne p) then do;
23990      sym = trim(left(min(m,p))) || ',' || trim(left(max(m,p)));
23991      do block = 1 to 2;
23992      input time @@;
23993      output;
23994      end;
23995      end;
23996      end;
23997      end;
23998      datalines;

