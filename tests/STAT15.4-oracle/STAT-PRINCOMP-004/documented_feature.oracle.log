7854       options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
7854     ! validmemname=compatible locale=en_US;
7855       %let syscc=0;
7856       title; footnote;
7857       ods _all_ close;
7858       ods listing gpath="%sysfunc(pathname(work))";
7859       ods graphics off;
7860       proc datasets library=work kill nolist;
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
