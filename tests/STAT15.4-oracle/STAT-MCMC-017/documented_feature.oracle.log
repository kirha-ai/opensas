16828      proc mcmc data=behrens outpost=postout seed=123
16829      nmc=1000 monitor=(_parms_ mudif)
16830      statistics(alpha=0.01) nbi=200;
16831      ods select PostSumInt;
16832      parm mu1 0 mu2 0;
16833      parm sig21 1;
16834      parm sig22 1;
16835      prior mu: ~ general(0);
16836      prior sig21 ~ general(-log(sig21), lower=0);
16837      prior sig22 ~ general(-log(sig22), lower=0);
16838      mudif = mu1 - mu2;
16839      if ind = 1 then do;
16840      mu = mu1;
16841      s2 = sig21;
16842      end;
16843      else do;
16844      mu = mu2;
16845      s2 = sig22;
16846      end;
16847      model y ~ normal(mu, var=s2);
16848      run;

