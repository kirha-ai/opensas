4992       options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
4992     ! validmemname=compatible locale=en_US;
4993       %let syscc=0;
4994       title; footnote;
4995       ods _all_ close;
4996       ods listing gpath="%sysfunc(pathname(work))";
4997       ods graphics off;
4998       proc datasets library=work kill nolist;
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK.SAMPLE (memtype=DATA).
NOTE: Deleting WORK.TEMPLAT (memtype=ITEMSTOR).
