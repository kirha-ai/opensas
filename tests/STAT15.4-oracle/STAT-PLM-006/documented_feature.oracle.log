4859       ods path work.templat(update) sashelp.tmplmst(read);
4860       
4861       %let nObs = 5000;
4862       %let nVars = 100;
4863       data SimuData;
4864       array x{&nVars};
4865       do obsNum=1 to &nObs;
4866       do j=1 to &nVars;
4867       x{j}=ranuni(1);
4868       end;
4869       linp = 10 + 11 *x1 - 10*sqrt(x2) + 2/x3 - 8*exp(x4) + 7*x5*x5
4870       - 6*x6**1.5 + 5*log(x7) - 4*sin(3.14*x8) + 3*x9 - 2*x10;
4871       TrueProb = 1/(1+exp(-linp));
4872       if ranuni(1) < TrueProb then y=1;
4873       else y=0;
4874       output;
4875       end;
4876       run;

NOTE: The data set WORK.SIMUDATA has 5000 observations and 105 variables.

4877       proc logistic data=SimuData;
4878       effect splines = spline(x1-x&nVars/separate);
4879       model y = splines/selection=stepwise;
4880       store work.SimuModel;
4881       run;

