1497       data VALung;
1498       drop check m;
1499       retain Therapy Cell;
1500       infile cards column=column;
1501       length Check $ 1;
1502       label Time='time to death in days'
1503       Kps='Karnofsky performance scale'
1504       Duration='months from diagnosis to randomization'
1505       Age='age in years'
1506       Prior='prior therapy'
1507       Cell='cell type'
1508       Therapy='type of treatment';
1509       format Prior yesno.;
1510       M=Column;
1511       input Check $ @@;
1512       if M>Column then M=1;
1513       if Check='s'|Check='t' then do;
1514       input @M Therapy $ Cell $;
1515       delete;
1516       end;
1517       else do;
1518       input @M Time Kps Duration Age Prior @@;
1519       Status=(Time>0);
1520       Time=abs(Time);
1521       end;
1522       datalines;

