1578       proc phreg data=VALung;
1579       class Prior(ref='no') Cell(ref='large') Therapy(ref='standard');
1580       model Time*Status(0) = Kps Cell Prior|Therapy;
1581       hazardratio 'H1' Kps / units=10 cl=both;
1582       hazardratio 'H2' Cell / cl=both;
1583       hazardratio 'H3' Therapy / diff=ref cl=both;
1584       contrast 'C1' Kps 10 / estimate=exp;
1585       contrast 'C2' cell 1 0 0, /* adeno vs large */
1586       cell 1 -1 0, /* adeno vs small */
1587       cell 1 0 -1, /* adeno vs squamous */
1588       cell 0 -1 0, /* large vs small */
1589       cell 0 0 -1, /* large vs Squamous */
1590       cell 0 1 -1 /* small vs squamous */
1591       / estimate=exp;
1592       contrast 'C3' Prior 0 Therapy 1 Prior *Therapy 0,
1593       Prior 0 Therapy 1 Prior *Therapy 1 / estimate=exp;
1594       run;

NOTE: Convergence criterion (GCONV=1E-8) satisfied.
NOTE: Under full-rank parameterizations, Type 3 effect tests are replaced by joint tests.  The joint test for an effect is a test that all of the parameters 
