1199       data VALung;
1200       drop check m;
1201       retain Therapy Cell;
1202       infile cards column=column;
1203       length Check $ 1;
1204       label Time='time to death in days'
1205       Kps='Karnofsky performance scale'
1206       Duration='months from diagnosis to randomization'
1207       Age='age in years'
1208       Prior='prior therapy'
1209       Cell='cell type'
1210       Therapy='type of treatment';
1211       format Prior yesno.;
1212       M=Column;
1213       input Check $ @@;
1214       if M>Column then M=1;
1215       if Check='s'|Check='t' then do;
1216       input @M Therapy $ Cell $;
1217       delete;
1218       end;
1219       else do;
1220       input @M Time Kps Duration Age Prior @@;
1221       Status=(Time>0);
1222       Time=abs(Time);
1223       end;
1224       datalines;

NOTE: SAS went to a new line when INPUT statement reached past the end of a line.
NOTE: The data set WORK.VALUNG has 137 observations and 8 variables.

1270       ;
1271       data Prior;
1272       input _TYPE_ $ Kps Duration Age Prioryes Celladeno Cellsmall
1273       Cellsquamous Therapytest;
1274       datalines;

NOTE: The data set WORK.PRIOR has 2 observations and 9 variables.

1277       ;
1278       run;
1279       ods graphics on;
1280       proc phreg data=VALung;
1281       class Prior(ref='no') Cell(ref='large') Therapy(ref='standard');
1282       model Time*Status(0) = Kps Duration Age Prior Cell Therapy;
1283       bayes seed=1 coeffprior=normal(input=Prior) statistics=(summary interval)
1284       diagnostics=(autocorr ess) plots=trace nmc=1000 nbi=200;
1285       hazardratio 'Hazard Ratio Statement 1' Therapy;
1286       hazardratio 'Hazard Ratio Statement 2' Age / unit=10;
1287       hazardratio 'Hazard Ratio Statement 3' Cell;
1288       run;

