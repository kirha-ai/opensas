2710       ods path work.templat(update) sashelp.tmplmst(read);
2711       
2712       ods trace on;
2713       data a (drop=i);
2714       do i=1 to 1000;
2715       x1=rannor(1234);
2716       x2=rannor(1234);
2717       e=rannor(1234);
2718       if i > 950 then y=100 + 10*e;
2719       else y=10 + 5*x1 + 3*x2 + 0.5 * e;
2720       output;
2721       end;
2722       run;

NOTE: The data set WORK.A has 1000 observations and 4 variables.

2723       proc quantreg data=a;
2724       model y = x1 x2 / seed=314159;
2725       run;

NOTE: No valid quantiles are specified. PROC QUANTREG computes median regression.

