2703       options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
2703     ! validmemname=compatible locale=en_US;
2704       %let syscc=0;
2705       title; footnote;
2706       ods _all_ close;
2707       ods listing gpath="%sysfunc(pathname(work))";
2708       ods graphics off;
2709       proc datasets library=work kill nolist;
NOTE: Deleting WORK.A (memtype=DATA).
