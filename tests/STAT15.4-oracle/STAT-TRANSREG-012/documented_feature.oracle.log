27715      title 'Introductory Main-Effects ANOVA Example';
27716      data a;
27717      input y x1 $ x2 $;
27718      datalines;

NOTE: The data set WORK.A has 12 observations and 3 variables.

27731      ;
27732      * Fit a main-effects ANOVA model with 1, 0, -1 coding;
27733      proc transreg ss2;
27734      model identity(y) = class(x1 x2 / effects);
27735      output coefficients replace;
27736      run;

