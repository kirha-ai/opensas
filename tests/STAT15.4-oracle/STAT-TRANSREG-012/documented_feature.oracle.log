27691      title 'Gasoline and Emissions Data';
27692      data gas;
27693      set sashelp.gas;
27694      if fuel in ('Ethanol', '82rongas', 'Gasohol');
27695      run;

NOTE: There were 171 observations read from the data set SASHELP.GAS.
