683        options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
683      ! validmemname=compatible locale=en_US;
684        %let syscc=0;
685        title; footnote;
686        ods _all_ close;
687        ods listing gpath="%sysfunc(pathname(work))";
688        ods graphics off;
689        proc datasets library=work kill nolist;
NOTE: Deleting WORK.MULTICENTER (memtype=DATA).
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK.TEMPLAT (memtype=ITEMSTOR).
NOTE: File WORK.TEMPLAT (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK._ORACLE_SCORED (memtype=DATA).
689      !                                         quit;


690        ods path work.templat(update) sashelp.tmplmst(read);
