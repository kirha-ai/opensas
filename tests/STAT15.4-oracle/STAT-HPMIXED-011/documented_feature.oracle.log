5182     !                                         quit;


5183       ods path work.templat(update) sashelp.tmplmst(read);
5184       
5185       data Sim;
5186       keep Species Farm Animal Yield;
5187       array AnimalEffect{3000};
5188       array AnimalFarm{3000};
5189       array AnimalSpecies{3000};
5190       do i = 1 to dim(AnimalEffect);
5191       AnimalEffect{i} = sqrt(4.0) *rannor(12345);
5192       AnimalFarm{i} = 1 + int(100 *ranuni(12345));
5193       AnimalSpecies{i} = 1 + int(5*ranuni(12345));
5194       end;
5195       do i = 1 to 40000;
5196       Animal = 1 + int(3000 *ranuni(12345));
5197       Species = AnimalSpecies{Animal};
5198       Farm = AnimalFarm{Animal};
5199       Yield = 1 + Species + Farm/10 + AnimalEffect{Animal}
5200       + sqrt(8.0)*rannor(12345);
5201       output;
5202       end;
5203       run;

NOTE: The data set WORK.SIM has 40000 observations and 4 variables.

5204       proc hpmixed data=Sim;
5205       class Species Farm Animal;
5206       model Yield = Species Species*Farm;
5207       random Animal;
5208       test Species*Farm;
5209       contrast 'Species1 = Species2 = Species3'
5210       Species 1 0 -1,
5211       Species 0 1 -1;
5212       run;

NOTE: Convergence criterion (GCONV=1E-8) satisfied.
