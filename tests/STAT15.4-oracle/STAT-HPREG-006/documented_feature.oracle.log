5769       ods path work.templat(update) sashelp.tmplmst(read);
5770       
5771       data analysisData;
5772       drop i j c3Num;
5773       length c3$ 7;
5774       array x{20} x1-x20;
5775       do i=1 to 15000;
5776       do j=1 to 20;
5777       x{j} = ranuni(1);
5778       end;
5779       c1 = 1 + mod(i,8);
5780       c2 = ranbin(1,3,.6);
5781       if i < 50 then do;
5782       c3 = 'tiny';
5783       c3Num=1;
5784       end;
5785       else if i < 250 then do;
5786       c3 = 'small';
5787       c3Num=1;
5788       end;
5789       else if i < 600 then do;
5790       c3 = 'average';
5791       c3Num=2;
5792       end;
5793       else if i < 1200 then do;
5794       c3 = 'big';
5795       c3Num=3;
5796       end;
5797       else do;
5798       c3 = 'huge';
5799       c3Num=5;
5800       end;
5801       yTrue = 10 + x1 + 2*x5 + 3*x10 + 4*x20 + 3 *x1*x7 + 8*x6*x7
5802       + 5*(c1=3)*c3Num + 8*(c1=7);
5803       error = 5*rannor(1);
5804       y = yTrue + error;
5805       if mod(i,3)=1 then Role = 'TRAIN';
5806       else if mod(i,3)=2 then Role = 'VAL';
5807       else Role = 'TEST';
5808       output;
5809       end;
5810       run;

NOTE: The data set WORK.ANALYSISDATA has 15000 observations and 27 variables.

5811       proc summary data=analysisData;
5812       class role;
5813       ways 1;
5814       var error;
5815       output out=ASE uss=uss n=n;

