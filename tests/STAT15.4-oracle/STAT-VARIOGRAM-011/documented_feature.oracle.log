NOTE: The PROCEDURE VARIOGRAM printed page 1915.

30819      proc variogram data=gmout plot(only)=semivar;
30820      compute lagd=4 maxlag=16 ndir=12 atol=22.5 bandw=20;
30821      coord xc=East yc=North;
30822      var ResidualOzone;
30823      run;

NOTE: The PROCEDURE VARIOGRAM printed pages 1916-1917.

30824      proc variogram data=gmout plot(only)=fit;
30825      compute lagd=4 maxlag=16;
30826      directions 0(22.5,10) 90(22.5,10);
30827      coord xc=East yc=North;
30828      model form=exp;
30829      parms (0.) (2 to 3 by 0.5) (5 to 25 by 10) / hold=(1);
30830      var ResidualOzone;
