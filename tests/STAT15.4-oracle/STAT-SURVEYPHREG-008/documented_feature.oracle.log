23110      ods path work.templat(update) sashelp.tmplmst(read);
23111      
23112      data survey;
23113      call streaminit(722);
23114      do stratum=1 to 2;
23115      do cluster=1 to 4;
23116      do id=1 to 12;
23117      age=20+mod(id*7+cluster,45);
23118      time=1+rand('exponential')*10;
23119      status=(mod(id,4) ne 0);
23120      weight=2+stratum+cluster/10;
23121      output;
23122      end;
23123      end;
23124      end;
23125      run;

NOTE: The data set WORK.SURVEY has 96 observations and 7 variables.

23126      proc surveyphreg data=survey;
23127      strata stratum;
23128      cluster cluster;
23129      weight weight;
23130      model time*status(0)=age;
23131      run;

NOTE: Convergence criterion (GCONV=1E-8) satisfied.
