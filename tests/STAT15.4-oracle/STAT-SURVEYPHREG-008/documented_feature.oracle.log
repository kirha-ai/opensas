23103      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
23103    ! validmemname=compatible locale=en_US;
23104      %let syscc=0;
23105      title; footnote;
23106      ods _all_ close;
23107      ods listing gpath="%sysfunc(pathname(work))";
23108      ods graphics off;
23109      proc datasets library=work kill nolist;
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
