2983       %let NCenter = 100;
2984       %let NPatient = %eval(&NCenter*50);
2985       %let NTime = 3;
2986       %let SigmaC = 2.0;
2987       %let SigmaP = 4.0;
2988       %let SigmaE = 8.0;
2989       %let Seed = 12345;
2990       data WeekSim;
2991       keep Gender Center Patient Time Measurement;
2992       array PGender{&NPatient};
2993       array PCenter{&NPatient};
2994       array PEffect{&NPatient};
2995       array CEffect{&NCenter};
2996       array GEffect{2};
2997       do Center = 1 to &NCenter;
2998       CEffect{Center} = sqrt(&SigmaC)*rannor(&Seed);
2999       end;
3000       GEffect{1} = 10*ranuni(&Seed);
3001       GEffect{2} = 10*ranuni(&Seed);
3002       do Patient = 1 to &NPatient;
3003       PGender{Patient} = 1 + int(2 *ranuni(&Seed));
3004       PCenter{Patient} = 1 + int(&NCenter*ranuni(&Seed));
3005       PEffect{Patient} = sqrt(&SigmaP)*rannor(&Seed);
3006       end;
3007       do Patient = 1 to &NPatient;
3008       Gender = PGender{Patient};
3009       Center = PCenter{Patient};
3010       Mean = 1 + GEffect{Gender} + CEffect{Center} + PEffect{Patient};
3011       do Time = 1 to &nTime;
3012       Measurement = Mean + sqrt(&SigmaE)*rannor(&Seed);
3013       output;
3014       end;
3015       end;
3016       run;

NOTE: The data set WORK.WEEKSIM has 15000 observations and 5 variables.

