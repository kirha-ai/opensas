13475      ods path work.templat(update) sashelp.tmplmst(read);
13476      
13477      data survival;
13478      call streaminit(218);
13479      do id=1 to 100;
13480      age=25+mod(id*7,40);
13481      x=mod(id,2);
13482      time=exp(0.5+0.15*x+0.01*age+rand('normal')*0.7);
13483      status=(mod(id,4) ne 0);
13484      output;
13485      end;
13486      run;

NOTE: The data set WORK.SURVIVAL has 100 observations and 5 variables.

13487      proc rmstreg data=survival tau=5;
13488      model time*status(0)=age x / link=linear method=pv;
13489      run;

NOTE: Algorithm converged.
