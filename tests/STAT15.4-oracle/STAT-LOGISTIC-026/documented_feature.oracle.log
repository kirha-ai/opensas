15491      label remiss='Complete Remission';
15492      datalines;

NOTE: The data set WORK.REMISSION has 27 observations and 7 variables.

15520      ;
15521      title 'Stepwise Regression on Cancer Remission Data';
15522      proc logistic data=Remission outest=betas covout;
15523      model remiss(event='1')=cell smear infil li blast temp
15524      / selection=stepwise
15525      slentry=0.3
15526      slstay=0.35
15527      details
15528      lackfit;
15529      output out=pred p=phat lower=lcl upper=ucl
15530      predprob=(individual crossvalidate);
15531      ods output Association=Association;
15532      run;

