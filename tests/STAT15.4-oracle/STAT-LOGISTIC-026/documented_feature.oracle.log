15548      title 'Backward Elimination on Cancer Remission Data';
15549      proc logistic data=Remission;
15550      model remiss(event='1')=temp cell li smear blast
15551      / selection=backward fast slstay=0.2
15552      ctable pprob=(0 to 1 by 0.05);
15553      run;

