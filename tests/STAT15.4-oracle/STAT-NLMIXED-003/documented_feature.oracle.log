6400       options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
6400     ! validmemname=compatible locale=en_US;
6401       %let syscc=0;
6402       title; footnote;
6403       ods _all_ close;
6404       ods listing gpath="%sysfunc(pathname(work))";
