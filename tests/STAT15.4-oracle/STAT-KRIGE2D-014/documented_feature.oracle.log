10781      ods path work.templat(update) sashelp.tmplmst(read);
10782      
10783      title 'Spatial Prediction With Kriging';
10784      data thick;
10785      input East North Thick @@;
10786      label Thick='Coal Seam Thickness';
10787      datalines;

NOTE: SAS went to a new line when INPUT statement reached past the end of a line.
NOTE: The data set WORK.THICK has 75 observations and 3 variables.

10813      ;
10814      ods graphics on;
10815      proc krige2d data=thick;
10816      coordinates xc=East yc=North;
10817      predict var=Thick radius=60;
10818      model scale=7.4599 range=30.1111 form=gauss;
10819      grid x=0 to 100 by 2.5 y=0 to 100 by 2.5;
10820      run;

NOTE: The data set WORK.DATA14 has 1681 observations and 7 variables.
NOTE: The PROCEDURE KRIGE2D printed pages 755-756.

10821      ods graphics off;
10822      run;
10823      quit;
