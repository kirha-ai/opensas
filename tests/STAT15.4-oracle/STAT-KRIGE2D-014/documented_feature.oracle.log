10774      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
10774    ! validmemname=compatible locale=en_US;
10775      %let syscc=0;
10776      title; footnote;
10777      ods _all_ close;
10778      ods listing gpath="%sysfunc(pathname(work))";
10779      ods graphics off;
10780      proc datasets library=work kill nolist;
NOTE: Deleting WORK.DATA13 (memtype=DATA).
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
