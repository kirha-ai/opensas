13790      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
13790    ! validmemname=compatible locale=en_US;
13791      %let syscc=0;
13792      title; footnote;
13793      ods _all_ close;
13794      ods listing gpath="%sysfunc(pathname(work))";
13795      ods graphics off;
13796      proc datasets library=work kill nolist;
NOTE: Deleting WORK.DRUGS (memtype=DATA).
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
