12402      data USPopulation;
12403      input Population @@;
12404      retain Year 1780;
12405      Year = Year+10;
12406      YearSq = Year *Year;
12407      Population = Population/1000;
12408      datalines;

NOTE: SAS went to a new line when INPUT statement reached past the end of a line.
NOTE: The data set WORK.USPOPULATION has 22 observations and 3 variables.

12412      ;
12413      proc reg data=USPopulation plots=ResidualByPredicted;
12414      var YearSq;
12415      model Population=Year / r clm cli;
12416      run;

WARNING: You must enable ODS graphics before requesting plots with the PLOTS option in the PROC REG statement.
12417      add YearSq;
12418      print;
12419      run;

