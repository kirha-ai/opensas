13375      data survival;
13376      call streaminit(218);
13377      do id=1 to 100;
13378      age=25+mod(id*7,40);
13379      x=mod(id,2);
13380      time=exp(0.5+0.15*x+0.01*age+rand('normal')*0.7);
13381      status=(mod(id,4) ne 0);
13382      output;
13383      end;
13384      run;

NOTE: The data set WORK.SURVIVAL has 100 observations and 5 variables.

13385      proc rmstreg data=survival tau=5;
13386      model time*status(0)=age x / link=linear method=pv;
13387      run;

NOTE: Algorithm converged.
