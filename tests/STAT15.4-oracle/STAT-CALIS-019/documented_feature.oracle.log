796        proc calis data=Kinzer nobs=326 nose;
797        cosan
798        var= var1-var6,
799        D(6,DIA) * B(2,GEN) + D(6,DIA) * Psi(6,DIA);
800        matrix B
801        [ ,1] = b11 b21 b31 b41 b51 b61,
802        [ ,2] = b12 b22 b32 b42 b52 b62;
803        matrix Psi
804        [1,1] = psi1-psi6;
805        matrix D
806        [1,1] = d1-d6;
807        parameters alpha (1.);
808        /* SAS Programming Statements to Define Dependent Parameters*/
809        /* 6 constraints on the factor loadings */
810        b12 = alpha - b11;
811        b22 = alpha - b21;
812        b32 = alpha - b31;
813        b42 = alpha - b41;
814        b52 = alpha - b51;
815        b62 = alpha - b61;
816        /* 6 Constraints on Correlation structures */
817        psi1 = 1. - b11 * b11 - b12 * b12;
818        psi2 = 1. - b21 * b21 - b22 * b22;
819        psi3 = 1. - b31 * b31 - b32 * b32;
820        psi4 = 1. - b41 * b41 - b42 * b42;
821        psi5 = 1. - b51 * b51 - b52 * b52;
822        psi6 = 1. - b61 * b61 - b62 * b62;
823        vnames
824        D = [var1-var6],
825        B = [factor1 factor2],
826        Psi = D;
