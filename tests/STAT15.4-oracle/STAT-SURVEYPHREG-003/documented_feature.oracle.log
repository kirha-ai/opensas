22907      data survey;
22908      call streaminit(722);
22909      do stratum=1 to 2;
22910      do cluster=1 to 4;
22911      do id=1 to 12;
22912      age=20+mod(id*7+cluster,45);
22913      time=1+rand('exponential')*10;
22914      status=(mod(id,4) ne 0);
22915      weight=2+stratum+cluster/10;
22916      output;
22917      end;
22918      end;
22919      end;
22920      run;

NOTE: The data set WORK.SURVEY has 96 observations and 7 variables.

22921      proc surveyphreg data=survey;
22922      strata stratum;
22923      cluster cluster;
22924      weight weight;
22925      model time*status(0)=age;
22926      run;

