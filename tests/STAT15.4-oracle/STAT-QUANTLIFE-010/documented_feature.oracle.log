10441      data survival;
10442      call streaminit(518);
10443      do id=1 to 80;
10444      drug=mod(id,2);
10445      age=25+mod(id*7,40);
10446      time=exp(2+0.25*drug+0.008*age+rand('normal')*0.4);
10447      status=(mod(id,5) ne 0);
10448      output;
10449      end;
10450      run;

NOTE: The data set WORK.SURVIVAL has 80 observations and 5 variables.

10451      proc quantlife data=survival seed=1268;
10452      class drug;
10453      model time*status(0)=drug age / quantile=0.5;
10454      run;

