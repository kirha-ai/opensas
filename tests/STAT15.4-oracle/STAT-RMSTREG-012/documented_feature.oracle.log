13681      ods path work.templat(update) sashelp.tmplmst(read);
13682      
13683      ods graphics on;
13684      ods trace on;
13685      ods trace on;
13686      data survival;
13687      call streaminit(218);
13688      do id=1 to 100;
13689      age=25+mod(id*7,40);
13690      x=mod(id,2);
13691      time=exp(0.5+0.15*x+0.01*age+rand('normal')*0.7);
13692      status=(mod(id,4) ne 0);
13693      output;
13694      end;
13695      run;

NOTE: The data set WORK.SURVIVAL has 100 observations and 5 variables.

13696      proc rmstreg data=survival tau=5;
13697      model time*status(0)=age x / link=linear method=pv;
13698      run;


