990        proc bchoice data=Travel2 seed=124 nmc=1000 nthin=2 dic nbi=200;
991        class Mode Subject / param=ref order=data;
992        model Choice = Mode TravTime / choiceset=(Subject) type=nlogit nest=(1 2 1);
993        run;

