978        data Travel2(keep=Subject Mode TravTime Age AgeCtr Choice);
979        array Times[3] AutoTime PlanTime TranTime;
980        array Allmodes[3] $ _temporary_ ('Auto' 'Plane' 'Transit');
981        set Travel;
982        Subject = _n_;
983        do i = 1 to 3;
984        Mode = Allmodes[i];
985        TravTime = Times[i];
986        Choice = (Chosen eq Mode);
987        output;
988        end;
