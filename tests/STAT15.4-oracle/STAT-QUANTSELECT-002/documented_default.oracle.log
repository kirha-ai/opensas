11233      proc quantselect data=sashelp.baseball;
11234      class Div;
11235      model Salary = nAtBat nHits nHome nRuns nRBI nBB yrMajor crAtBat
11236      crHits crHome crRuns crRbi crBB nAssts nError nOuts
11237      Div
11238      / selection=lasso(adaptive stop=aic choose=sbc sh=7);
11239      run;

