17595      proc spp data=sashelp.bei plots(equate)=(trends observations);
17596      process trees = (x, y /area=(0,0,1000,500) Event=Trees);
17597      trend grad = field(x,y, gradient);
17598      trend elev = field(x,y, elevation);
17599      run;

