17600      proc spp data=sashelp.bei plots(equate)=(residual intensity);
17601      process trees = (x,y /area=(0,0,1000,500) event=Trees);
17602      trend elev = field(x,y,elevation);
17603      trend grad = field(x,y,gradient);
17604      model trees = elev grad / grid(64,64) residual(B=70) ;
17605      run;

