30674      ods path work.templat(update) sashelp.tmplmst(read);
30675      
30676      title 'Spatial Correlation Analysis with PROC VARIOGRAM';
30677      ods graphics on;
30678      proc variogram data=sashelp.thick plots=pairs(thr=30);
30679      compute novariogram nhc=20;
30680      coordinates xc=East yc=North;
30681      var Thick;
30682      run;

NOTE: The PROCEDURE VARIOGRAM printed page 1903.

30683      proc variogram data=sashelp.thick outv=outv;
30684      compute lagd=7 maxlag=10 cl robust;
30685      coordinates xc=East yc=North;
30686      var Thick;
30687      run;

NOTE: No DIRECTIONS statement and no NDIRECTIONS=, or NDIRECTIONS=0 specified: Computing omnidirectional semivariogram.
NOTE: The data set WORK.OUTV has 12 observations and 9 variables.
NOTE: The PROCEDURE VARIOGRAM printed pages 1904-1905.

30688      proc variogram data=sashelp.thick outv=outv plots(only)=moran;
30689      compute lagd=7 maxlag=10 autocorr(assum=random);
30690      coordinates xc=East yc=North;
30691      var Thick;
30692      run;

NOTE: No DIRECTIONS statement and no NDIRECTIONS=, or NDIRECTIONS=0 specified: Computing omnidirectional semivariogram.
NOTE: The autocorrelation statistics exclude 33 observation(s) that have no neighbors within the specified LAGDISTANCE= distance.
NOTE: The Moran scatter plot excludes 33 observation(s) because they have no neighbors within the specified LAGDISTANCE= distance.
NOTE: The data set WORK.OUTV has 12 observations and 8 variables.
NOTE: The PROCEDURE VARIOGRAM printed pages 1906-1907.

30693      proc variogram data=sashelp.thick outv=outv;
30694      store out=SemivStoreGau / label='Thickness Gaussian WLS Fit';
30695      compute lagd=7 maxlag=10;
30696      coordinates xc=East yc=North;
30697      model form=gau cl / covb;
30698      var Thick;
30699      run;

NOTE: No DIRECTIONS statement and no NDIRECTIONS=, or NDIRECTIONS=0 specified: Computing omnidirectional semivariogram.
NOTE: Convergence criterion (GCONV=1E-8) satisfied.
NOTE: The data set WORK.OUTV has 12 observations and 8 variables.
NOTE: The PROCEDURE VARIOGRAM printed pages 1908-1911.

30700      ods graphics off;
30701      run;
30702      quit;
