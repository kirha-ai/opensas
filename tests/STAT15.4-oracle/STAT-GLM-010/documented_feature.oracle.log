2408       ;
2409       proc glm;
2410       class Drug Depleted;
2411       model LogHistamine0--LogHistamine5 =
2412       Drug Depleted Drug*Depleted / nouni;
2413       repeated Time 4 (0 1 3 5) polynomial / summary printe;
2414       run;

