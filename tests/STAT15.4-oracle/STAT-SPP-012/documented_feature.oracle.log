17907      proc spp data=sashelp.bei plots(equate)=(trends observations);
17908      process trees = (x, y /area=(0,0,1000,500) Event=Trees);
17909      trend grad = field(x,y, gradient);
17910      trend elev = field(x,y, elevation);
17911      run;

