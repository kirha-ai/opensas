17912      proc spp data=sashelp.bei plots(equate)=(residual intensity);
17913      process trees = (x,y /area=(0,0,1000,500) event=Trees);
17914      trend elev = field(x,y,elevation);
17915      trend grad = field(x,y,gradient);
17916      model trees = elev grad / grid(64,64) residual(B=70) ;
17917      run;

