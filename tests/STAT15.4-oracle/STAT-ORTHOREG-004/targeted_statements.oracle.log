832        data sample;
833        call streaminit(314159);
834        do id=1 to 90;
835         x=rand('normal'); z=rand('normal'); w=rand('normal');
836         group=1+mod(id,3); block=1+mod(id,5);
837         y=5+1.5*x-0.6*z+0.4*group+rand('normal');
838         y2=2+0.5*x+0.8*z+rand('normal'); output;
839        end;
840        run;

NOTE: The data set WORK.SAMPLE has 90 observations and 8 variables.

841        proc orthoreg data=sample; model y=x z; estimate 'x coefficient' x 1; test x z; run;

