13422      ods path work.templat(update) sashelp.tmplmst(read);
13423      
13424      proc causalmed data=sashelp.birthwgt decomp;
13425      class LowBirthWgt Smoking Death AgeGroup Married Race
13426      Drinking SomeCollege /descending;
13427      mediator LowBirthWgt = Smoking;
13428      model Death = LowBirthWgt | Smoking;
13429      covar AgeGroup Married Race Drinking SomeCollege;
13430      evaluate 'Low Birth-Weight' LowBirthWgt='Yes' / nodecomp;
13431      evaluate 'Normal Birth-Weight' LowBirthWgt='No' / nodecomp;
13432      run;

NOTE: PROC CAUSALMED is modeling the probability that Death='Yes' in the outcome model.
NOTE: PROC CAUSALMED is modeling the probability that LowBirthWgt='Yes' in the mediator model.
NOTE: The PROCEDURE CAUSALMED printed pages 1834-1839.

13433      quit;
