2260       data theop;
2261       input time dose conc @@;
2262       if (dose = 4) then group=1;
2263       else group=2;
2264       datalines;

NOTE: SAS went to a new line when INPUT statement reached past the end of a line.
NOTE: The data set WORK.THEOP has 98 observations and 4 variables.

2314       ;
2315       proc nlin data=theop outest=cov;
2316       parms beta1_1=-3.22 beta2_1=0.47 beta3_1=-2.45
2317       beta1_2=-3.22 beta2_2=0.47 beta3_2=-2.45;
2318       if (group=1) then do;
2319       cl = exp(beta1_1);
2320       ka = exp(beta2_1);
2321       ke = exp(beta3_1);
2322       end;
2323       else do;
2324       cl = exp(beta1_2);
2325       ka = exp(beta2_2);
2326       ke = exp(beta3_2);
2327       end;
2328       mean = dose*ke*ka*(exp(-ke*time)-exp(-ka*time))/cl/(ka-ke);
2329       model conc = mean;
2330       ods output ParameterEstimates=ests;
2331       run;

