2342       proc glimmix data=ests order=data;
2343       class Parameter;
2344       model Estimate = Parameter / noint df=92 s;
2345       random _residual_ / type=lin(1) ldata=covb v;
2346       parms (1) / noiter;
2347       lsmeans parameter / cl;
2348       lsmestimate Parameter
2349       'beta1 eq. across groups' 1 0 0 -1,
