8018       options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
8018     ! validmemname=compatible locale=en_US;
8019       %let syscc=0;
8020       title; footnote;
8021       ods _all_ close;
8022       ods listing gpath="%sysfunc(pathname(work))";
8023       ods graphics off;
8024       proc datasets library=work kill nolist;
NOTE: Deleting WORK.CRIME (memtype=DATA).
NOTE: Deleting WORK.CRIME_COMPONENTS (memtype=DATA).
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK.SASMAC2 (memtype=CATALOG).
8024     !                                         quit;


8025       ods path work.templat(update) sashelp.tmplmst(read);
