8028       ods trace on;
8029       ods trace on;
8030       title 'Crime Rates per 100,000 Population by State';
8031       data Crime;
8032       input State $1-15 Murder Rape Robbery Assault
8033       Burglary Larceny Auto_Theft;
8034       datalines;

NOTE: The data set WORK.CRIME has 50 observations and 8 variables.

8085       ;
