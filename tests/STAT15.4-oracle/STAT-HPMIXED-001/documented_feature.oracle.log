4690       ods path work.templat(update) sashelp.tmplmst(read);
4691       
4692       data Sim;
4693       keep Species Farm Animal Yield;
4694       array AnimalEffect{3000};
4695       array AnimalFarm{3000};
4696       array AnimalSpecies{3000};
4697       do i = 1 to dim(AnimalEffect);
4698       AnimalEffect{i} = sqrt(4.0) *rannor(12345);
4699       AnimalFarm{i} = 1 + int(100 *ranuni(12345));
4700       AnimalSpecies{i} = 1 + int(5*ranuni(12345));
4701       end;
4702       do i = 1 to 40000;
4703       Animal = 1 + int(3000 *ranuni(12345));
4704       Species = AnimalSpecies{Animal};
4705       Farm = AnimalFarm{Animal};
4706       Yield = 1 + Species + Farm/10 + AnimalEffect{Animal}
4707       + sqrt(8.0)*rannor(12345);
4708       output;
4709       end;
4710       run;

NOTE: The data set WORK.SIM has 40000 observations and 4 variables.

4711       proc hpmixed data=Sim;
4712       class Species Farm Animal;
4713       model Yield = Species Species*Farm;
4714       random Animal;
4715       test Species*Farm;
4716       contrast 'Species1 = Species2 = Species3'
4717       Species 1 0 -1,
4718       Species 0 1 -1;
4719       run;

NOTE: Convergence criterion (GCONV=1E-8) satisfied.
