NOTE: Deleting WORK.WHEATON (memtype=DATA).
10775    !                                         quit;


10776      ods path work.templat(update) sashelp.tmplmst(read);
10777      
10778      ods graphics on;
10779      ods trace on;
10780      title "Stability of Alienation";
10781      title2 "Data Matrix of WHEATON, MUTHEN, ALWIN & SUMMERS (1977)";
10782      data Wheaton(TYPE=COV);
10783      length _name_ $32 _type_ $8;
10784      infile datalines truncover;
10785      
10786      _type_ = 'cov';
10787      input _name_ :$32. Anomie67 Powerless67 Anomie71 Powerless71
10788      Education SEI;
10789      label Anomie67='Anomie (1967)' Powerless67='Powerlessness (1967)'
10790      Anomie71='Anomie (1971)' Powerless71='Powerlessness (1971)'
10791      Education='Education' SEI='Occupational Status Index';
10792      datalines;

NOTE: The data set WORK.WHEATON has 6 observations and 8 variables.

10799      ;
10800      ods graphics on;
10801      proc calis nobs=932 data=Wheaton plots=residuals;
10802      path
10803      Anomie67 Powerless67 <=== Alien67 = 1.0 0.833,
10804      Anomie71 Powerless71 <=== Alien71 = 1.0 0.833,
10805      Education SEI <=== SES = 1.0 lambda,
10806      Alien67 Alien71 <=== SES = gamma1 gamma2,
10807      Alien71 <=== Alien67 = beta;
10808      pvar
10809      Anomie67 = theta1,
10810      Powerless67 = theta2,
10811      Anomie71 = theta1,
10812      Powerless71 = theta2,
10813      Education = theta3,
10814      SEI = theta4,
10815      Alien67 = psi1,
10816      Alien71 = psi2,
10817      SES = phi;
10818      pcov
10819      Anomie67 Anomie71 = theta5,
10820      Powerless67 Powerless71 = theta5;
10821      pathdiagram title='Stability of Alienation';
10822      run;

NOTE: The means of one or more variables in the input data set WORK.WHEATON are missing and are assumed to be 0.

