4622       options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
4622     ! validmemname=compatible locale=en_US;
4623       %let syscc=0;
4624       title; footnote;
4625       ods _all_ close;
4626       ods listing gpath="%sysfunc(pathname(work))";
4627       ods graphics off;
4628       proc datasets library=work kill nolist;
NOTE: Deleting WORK.BLOCKANALYSIS (memtype=ITEMSTOR).
NOTE: Deleting WORK.BLOCKDESIGN (memtype=DATA).
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
