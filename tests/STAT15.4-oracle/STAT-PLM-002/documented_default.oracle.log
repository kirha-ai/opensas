4631       data BlockDesign;
4632       input block a b y @@;
4633       datalines;

NOTE: SAS went to a new line when INPUT statement reached past the end of a line.
NOTE: The data set WORK.BLOCKDESIGN has 24 observations and 4 variables.

4646       ;
4647       proc glm data=BlockDesign;
4648       class block a b;
4649       model y = block a b a*b / solution;
4650       store work.BlockAnalysis / label='PLM: Getting Started';
4651       run;


NOTE: The GLM procedure generated the model item store WORK.BLOCKANALYSIS.
NOTE: The PROCEDURE GLM printed pages 349-350.

4652       proc plm restore=work.BlockAnalysis;
4653       run;

NOTE: The PROCEDURE PLM printed page 351.

4654       proc plm restore=work.BlockAnalysis;
4655       show fit parms;
4656       test a b a*b;
4657       run;

NOTE: The PROCEDURE PLM printed page 352.

4658       proc plm restore=work.BlockAnalysis seed=3;
4659       lsmeans a / diff;
4660       lsmestimate a -1 1,
4661       1 1 -2 / uppertailed ftest;
4662       run;

NOTE: Random number seed for this analysis set to 3.
NOTE: The PROCEDURE PLM printed page 353.

4663       ods graphics on;
4664       proc plm restore=work.BlockAnalysis;
4665       slice a*b / sliceby(b='1') diff;
4666       run;

NOTE: The PROCEDURE PLM printed page 354.

4667       ods graphics off;
