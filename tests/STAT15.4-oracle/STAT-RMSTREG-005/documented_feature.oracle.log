13441      ods path work.templat(update) sashelp.tmplmst(read);
13442      
13443      data survival;
13444      call streaminit(218);
13445      do id=1 to 100;
13446      age=25+mod(id*7,40);
13447      x=mod(id,2);
13448      time=exp(0.5+0.15*x+0.01*age+rand('normal')*0.7);
13449      status=(mod(id,4) ne 0);
13450      output;
13451      end;
13452      run;

NOTE: The data set WORK.SURVIVAL has 100 observations and 5 variables.

13453      proc rmstreg data=survival tau=5;
13454      model time*status(0)=age x / link=linear method=pv;
13455      run;

NOTE: Algorithm converged.
