17628      proc spp data=sashelp.bei plots(equate)=(trends observations);
17629      process trees = (x, y /area=(0,0,1000,500) Event=Trees);
17630      trend grad = field(x,y, gradient);
17631      trend elev = field(x,y, elevation);
17632      run;

