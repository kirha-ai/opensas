17633      proc spp data=sashelp.bei plots(equate)=(residual intensity);
17634      process trees = (x,y /area=(0,0,1000,500) event=Trees);
17635      trend elev = field(x,y,elevation);
17636      trend grad = field(x,y,gradient);
17637      model trees = elev grad / grid(64,64) residual(B=70) ;
17638      run;

NOTE: Convergence criterion (Absolute gradient, ABSGCONV=0.00001) satisfied.
