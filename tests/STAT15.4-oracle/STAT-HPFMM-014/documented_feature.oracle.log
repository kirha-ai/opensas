8274       data assay;
8275       label dose = 'Dose of quinoline (microg/plate)'
8276       num = 'Observed number of colonies';
8277       input dose @;
8278       logd = log(dose+10);
8279       do i=1 to 3;
8280       input num@;
8281       output;
8282       end;
8283       datalines;

NOTE: The data set WORK.ASSAY has 18 observations and 4 variables.

