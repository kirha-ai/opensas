10399      
10400      ods graphics on;
10401      ods trace on;
10402      ods trace on;
10403      data survival;
10404      call streaminit(518);
10405      do id=1 to 80;
10406      drug=mod(id,2);
10407      age=25+mod(id*7,40);
10408      time=exp(2+0.25*drug+0.008*age+rand('normal')*0.4);
10409      status=(mod(id,5) ne 0);
10410      output;
10411      end;
10412      run;

NOTE: The data set WORK.SURVIVAL has 80 observations and 5 variables.

10413      proc quantlife data=survival seed=1268;
10414      class drug;
10415      model time*status(0)=drug age / quantile=0.5;
10416      run;


