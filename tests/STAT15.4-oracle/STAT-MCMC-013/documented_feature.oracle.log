16490      title 'Logistic Regression Random-Effects Model';
16491      data seeds;
16492      input r n seed extract @@;
16493      ind = _N_;
16494      datalines;

NOTE: SAS went to a new line when INPUT statement reached past the end of a line.
NOTE: The data set WORK.SEEDS has 21 observations and 5 variables.

16501      ;
16502      proc mcmc data=seeds outpost=postout seed=332786 nmc=1000 nbi=200;
16503      ods select PostSumInt;
16504      parms beta0 0 beta1 0 beta2 0 beta3 0 s2 1;
16505      prior s2 ~ igamma(0.01, s=0.01);
16506      prior beta: ~ general(0);
16507      w = beta0 + beta1*seed + beta2*extract + beta3*seed*extract;
16508      random delta ~ normal(w, var=s2) subject=ind;
16509      pi = logistic(delta);
16510      model r ~ binomial(n = n, p = pi);
16511      run;

NOTE: Tuning the proposal distribution.
NOTE: Generating the burn-in samples.
