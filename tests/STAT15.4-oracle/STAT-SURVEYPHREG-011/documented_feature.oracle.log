23235      data survey;
23236      call streaminit(722);
23237      do stratum=1 to 2;
23238      do cluster=1 to 4;
23239      do id=1 to 12;
23240      age=20+mod(id*7+cluster,45);
23241      time=1+rand('exponential')*10;
23242      status=(mod(id,4) ne 0);
23243      weight=2+stratum+cluster/10;
23244      output;
23245      end;
23246      end;
23247      end;
23248      run;

