21427      ods trace on;
21428      data survey;
21429      call streaminit(722);
21430      do stratum=1 to 2;
21431      do cluster=1 to 4;
21432      do id=1 to 12;
21433      age=20+mod(id*7+cluster,45);
21434      event=rand('bernoulli',0.3);
21435      weight=2+stratum+cluster/10;
21436      output;
21437      end;
21438      end;
21439      end;
21440      run;

NOTE: The data set WORK.SURVEY has 96 observations and 6 variables.

21441      proc surveylogistic data=survey;
21442      strata stratum;
21443      cluster cluster;
21444      weight weight;
21445      model event(event='1')=age;
21446      run;


