14406      ;
14407      ods graphics on;
14408      proc logistic data=roc plots=roc(id=prob);
14409      model popind(event='0') = alb tp totscore / nofit;
14410      roc 'Albumin' alb;
14411      roc 'K-G Score' totscore;
14412      roc 'Total Protein' tp;
14413      roccontrast reference('K-G Score') / estimate e;
14414      run;

