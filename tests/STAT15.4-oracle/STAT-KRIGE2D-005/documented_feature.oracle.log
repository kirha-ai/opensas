10123      ;
10124      ods graphics on;
10125      proc variogram data=thick noprint;
10126      store out=SemivStoreGau / label='Thickness Gaussian Model';
10127      compute lagd=7 maxlag=10;
10128      coord xc=East yc=North;
10129      model form=gau;
10130      var Thick;
10131      run;

NOTE: No DIRECTIONS statement and no NDIRECTIONS=, or NDIRECTIONS=0 specified: Computing omnidirectional semivariogram.

10132      proc krige2d data=thick outest=pred1 noprint;
10133      restore in=SemivStoreGau;
10134      coordinates xc=East yc=North;
10135      predict var=Thick r=60;
10136      model storeselect;
10137      grid x=0 to 100 by 10 y=0 to 100 by 10;
10138      run;

NOTE: The data set WORK.PRED1 has 121 observations and 7 variables.

10139      proc variogram data=thick plots(only)=fit;
