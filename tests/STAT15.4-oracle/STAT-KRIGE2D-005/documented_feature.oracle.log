10153      data compare;
10154      merge pred1(rename=(estimate=g_prd stderr=g_std))
10155      pred2(rename=(estimate=s_prd stderr=s_std));
10156      prdRelDif = ((g_prd-s_prd) / s_prd) * 100;
10157      stdRelDif = ((g_std-s_std) / s_std) * 100;
10158      run;

