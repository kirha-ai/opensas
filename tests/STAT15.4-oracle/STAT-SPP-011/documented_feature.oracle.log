17873      ods graphics on;
17874      proc spp data=sashelp.bei plots(equate)=(trends observations);
17875      process trees = (x, y /area=(0,0,1000,500) Event=Trees);
17876      trend grad = field(x,y, gradient);
17877      trend elev = field(x,y, elevation);
17878      run;

NOTE: The PROCEDURE SPP printed page 1225.

17879      proc spp data=sashelp.bei plots(equate)=(residual intensity);
17880      process trees = (x,y /area=(0,0,1000,500) event=Trees);
17881      trend elev = field(x,y,elevation);
17882      trend grad = field(x,y,gradient);
17883      model trees = elev grad / grid(64,64) residual(B=70) ;
17884      run;

NOTE: Convergence criterion (Absolute gradient, ABSGCONV=0.00001) satisfied.
