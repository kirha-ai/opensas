2222       proc glimmix data=clinical_uv method=laplace;
2223       class center id drug;
2224       model rating = drug t0 age drug*age drug*t0 /
2225       dist=multinomial link=cumlogit;
2226       random intercept / subject=id(center);
2227       covtest 0;
2228       estimate %contrast(20,60,20,2)
2229       / adjust=simulate(seed=1)
2230       stepdown(type=logical);
2231       ods output Estimates=EstStepDownMulti;
2232       run;



