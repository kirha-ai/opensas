2168       %macro Contrast(from,to,byA,byT);
2169       %let nCmp=0;
2170       %do age=&from %to &to %by &byA;
2171       %do t0=0 %to 4 %by &byT;
2172       %let nCmp=%eval(&nCmp+1);
2173       %end; %end;
2174       %let iCmp=0;
2175       %do age=&from %to &to %by &byA;
2176       %do t0=0 %to 4 %by &byT;
2177       %let iCmp=%eval(&iCmp+1);
2178       "&age &t0" drug 1 -1 drug*age &age -&age drug*t0 &t0 -&t0
2179       %if &iCmp < &nCmp %then %do; , %end;
2180       %end; %end;
2181       %mend;
2182       
2183       proc glimmix data=clinical;
2184       t = (t3+t4)/2;
2185       class drug;
2186       model t = drug t0 age drug*age drug*t0;
2187       estimate %contrast(20,60,20,2)
2188       / adjust=simulate(seed=1)
2189       stepdown(type=logical);
2190       ods output Estimates=EstStepDown;
2191       run;




