3373       ;
3374       ods graphics on;
3375       proc sim2d data=thick outsim=sim plot=(observ sim);
3376       coordinates xc=East yc=North;
3377       simulate var=Thick numreal=100 seed=79931
3378       scale=7.4599 range=30.1111 nugget=1e-8 form=gauss;
3379       mean 40.1173;
3380       grid x=0 to 100 by 25 y=0 to 100 by 25;
3381       run;


