27503      title 'Gasoline and Emissions Data';
27504      data gas;
27505      set sashelp.gas;
27506      if fuel in ('Ethanol', '82rongas', 'Gasohol');
27507      run;

NOTE: There were 171 observations read from the data set SASHELP.GAS.
