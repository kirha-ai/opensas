27527      title 'Introductory Main-Effects ANOVA Example';
27528      data a;
27529      input y x1 $ x2 $;
27530      datalines;

NOTE: The data set WORK.A has 12 observations and 3 variables.

27543      ;
27544      * Fit a main-effects ANOVA model with 1, 0, -1 coding;
27545      proc transreg ss2;
27546      model identity(y) = class(x1 x2 / effects);
27547      output coefficients replace;
27548      run;

