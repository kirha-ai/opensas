88         data Mixture;
89         drop i;
90         do i=1 to 1000;
91         X1 = ranuni(1);
92         C1 = int(3*ranuni(1));
93         if C1=0 then Y=exp(5*(X1-0.3)**2)+rannor(1);
94         else if C1=1 then Y=log(X1*(1-X1))+rannor(1);
95         else Y=7*X1+rannor(1);
96         output;
97         end;
98         run;

