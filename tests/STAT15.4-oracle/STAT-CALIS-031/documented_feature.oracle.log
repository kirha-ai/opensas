10942      E4 = theta2,
10943      E5 = theta3,
10944      E6 = theta4,
10945      D1 = psi1,
10946      D2 = psi2,
10947      f_SES = phi;
10948      cov
10949      E1 E3 = theta5,
10950      E2 E4 = theta5;
10951      run;

