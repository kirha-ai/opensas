10840      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
10840    ! validmemname=compatible locale=en_US;
10841      %let syscc=0;
10842      title; footnote;
10843      ods _all_ close;
10844      ods listing gpath="%sysfunc(pathname(work))";
10845      ods graphics off;
10846      proc datasets library=work kill nolist;
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK.SASGOPT (memtype=CATALOG).
NOTE: File WORK.SASGOPT (memtype=CATALOG) cannot be deleted because it is in use.
NOTE: Deleting WORK.SASMAC1 (memtype=CATALOG).
NOTE: File WORK.SASMAC1 (memtype=CATALOG) cannot be deleted because it is in use.
NOTE: Deleting WORK.SASMAC2 (memtype=CATALOG).
NOTE: Deleting WORK.TEMPLAT (memtype=ITEMSTOR).
NOTE: File WORK.TEMPLAT (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK.WHEATON (memtype=DATA).
10846    !                                         quit;


10847      ods path work.templat(update) sashelp.tmplmst(read);
10848      
10849      ods graphics on;
10850      ods trace on;
10851      ods trace on;
10852      data Wheaton(TYPE=COV);
10853      length _name_ $32 _type_ $8;
10854      infile datalines truncover;
10855      
10856      _type_ = 'cov';
10857      input _name_ :$32. Anomie67 Powerless67 Anomie71 Powerless71
10858      Education SEI;
10859      label Anomie67='Anomie (1967)' Powerless67='Powerlessness (1967)'
10860      Anomie71='Anomie (1971)' Powerless71='Powerlessness (1971)'
10861      Education='Education' SEI='Occupational Status Index';
10862      datalines;

NOTE: The data set WORK.WHEATON has 6 observations and 8 variables.

10869      ;
10870      run;
10871      proc calis nobs=932 data=Wheaton;
10872      path
10873      Anomie67 <=== Alien67 = 1.0,
10874      Powerless67 <=== Alien67 = 0.833,
10875      Anomie71 <=== Alien71 = 1.0,
10876      Powerless71 <=== Alien71 = 0.833,
10877      Education <=== SES = 1.0,
10878      SEI <=== SES = lambda,
10879      Alien67 <=== SES = gamma1,
10880      Alien71 <=== SES = gamma2,
10881      Alien71 <=== Alien67 = beta;
10882      pvar
10883      Anomie67 = theta1,
10884      Powerless67 = theta2,
10885      Anomie71 = theta1,
10886      Powerless71 = theta2,
10887      Education = theta3,
10888      SEI = theta4,
10889      Alien67 = psi1,
10890      Alien71 = psi2,
10891      SES = phi;
10892      pcov
10893      Anomie67 Anomie71 = theta5,
10894      Powerless67 Powerless71 = theta5;
10895      run;

NOTE: The means of one or more variables in the input data set WORK.WHEATON are missing and are assumed to be 0.

