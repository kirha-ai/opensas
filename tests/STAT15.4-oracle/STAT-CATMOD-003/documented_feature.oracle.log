12211      proc catmod data=fbeing;
12212      title 'Complex Sample Survey Analysis';
12213      response read b1-b10;
12214      factors sex $ 2, age $ 5 / _response_=sex age
12215      profile=(male '25-34',
12216      male '35-44',
12217      male '45-54',
12218      male '55-64',
12219      male '65-74',
12220      female '25-34',
12221      female '35-44',
12222      female '45-54',
12223      female '55-64',
12224      female '65-74');
12225      model _f_=_response_
12226      / design title='Main Effects for Sex and Age';
12227      run;

12228      contrast 'No Age Effect for Age<65' all_parms 0 0 1 0 0 -1,
12229      all_parms 0 0 0 1 0 -1,
12230      all_parms 0 0 0 0 1 -1;
12231      run;

