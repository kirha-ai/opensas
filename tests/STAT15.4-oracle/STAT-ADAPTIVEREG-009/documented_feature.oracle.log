522        /* STAT-ADAPTIVEREG-009: ADAPTIVEREG — ODS Graphics
523         * Source: S154 / Chapter 28 / `ODS Graphics` (PDF pp. 1083–1084).
524         * Discriminates: Example 28.2: Fitting Data with Mixture Structures
525         */
526        options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
526      ! validmemname=compatible locale=en_US;
527        %let syscc=0;
528        title; footnote;
529        ods _all_ close;
530        ods listing gpath="%sysfunc(pathname(work))";
531        ods graphics off;
532        proc datasets library=work kill nolist;
NOTE: Deleting WORK.MIXTURE (memtype=DATA).
NOTE: Deleting WORK.NEW (memtype=DATA).
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK.SASMAC2 (memtype=CATALOG).
532      !                                         quit;


533        ods path work.templat(update) sashelp.tmplmst(read);
534        
535        ods graphics on;
536        ods trace on;
537        ods trace on;
538        data Mixture;
539        drop i;
540        do i=1 to 1000;
541        X1 = ranuni(1);
542        C1 = int(3*ranuni(1));
543        if C1=0 then Y=exp(5*(X1-0.3)**2)+rannor(1);
544        else if C1=1 then Y=log(X1*(1-X1))+rannor(1);
545        else Y=7*X1+rannor(1);
546        output;
547        end;
548        run;

NOTE: The data set WORK.MIXTURE has 1000 observations and 3 variables.

549        ods graphics on;
550        proc adaptivereg data=Mixture plots=fit;
551        class c1;
552        model y=c1 x1;
553        run;


