558        data New;
559        set Mixture;
560        basis1 = (c1=1 OR c1=0);
561        basis3 = (c1=1);
562        basis5 = NOT(c1=1) *MAX(x1-0.7665019053,0);
563        basis7 = NOT(c1=1 OR c1=0) *MAX(x1-0.7665019053,0);
564        basis8 = NOT(c1=1 OR c1=0) *MAX(0.7665019053-x1,0);
565        basis9 = (c1=1) *MAX(x1-0.5530566455,0);
566        basis10 = (c1=1)*MAX(0.5530566455-x1,0);
567        basis11 = (c1=1)*MAX(x1-0.045800759,0);
568        basis13 = (c1=1)*MAX(x1-0.9526330293,0);
569        basis15 = (c1=1 OR c1=0)*MAX(x1-0.9499325226,0);
570        basis17 = (c1=1 OR c1=0)*MAX(x1-0.5142821095,0);
571        basis19 = (c1=1 OR c1=0)*MAX(x1-0.9889635476,0);
572        pred = 5.3829 - 4.3871 *basis1 + 32.7761*basis3 +
573        20.2859*basis5 - 11.4183*basis7 - 7.0758*basis8 +
574        58.4911*basis9 - 71.6388*basis10 - 69.0764*basis11 -
575        119.71*basis13 + 66.5733*basis15 + 6.6681*basis17 -
576        185.21*basis19;
577        run;

