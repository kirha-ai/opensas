15228      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
15228    ! validmemname=compatible locale=en_US;
15229      %let syscc=0;
15230      title; footnote;
15231      ods _all_ close;
