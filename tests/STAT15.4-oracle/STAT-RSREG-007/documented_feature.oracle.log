15237      ods trace on;
15238      title 'Response Surface with a Simple Optimum';
15239      data smell;
15240      input Odor T R H @@;
15241      label
15242      T = "Temperature"
15243      R = "Gas-Liquid Ratio"
15244      H = "Packing Height";
15245      datalines;

NOTE: SAS went to a new line when INPUT statement reached past the end of a line.
NOTE: The data set WORK.SMELL has 15 observations and 4 variables.

15250      ;
15251      proc rsreg data=smell;
15252      model Odor = T R H / lackfit;
15253      run;


