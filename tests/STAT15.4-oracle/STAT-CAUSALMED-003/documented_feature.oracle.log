13331      proc causalmed data=sashelp.birthwgt decomp;
13332      class LowBirthWgt Smoking Death AgeGroup Married Race
13333      Drinking SomeCollege /descending;
13334      mediator LowBirthWgt = Smoking;
13335      model Death = LowBirthWgt | Smoking;
13336      covar AgeGroup Married Race Drinking SomeCollege;
13337      evaluate 'Low Birth-Weight' LowBirthWgt='Yes' / nodecomp;
13338      evaluate 'Normal Birth-Weight' LowBirthWgt='No' / nodecomp;
13339      run;

NOTE: PROC CAUSALMED is modeling the probability that Death='Yes' in the outcome model.
NOTE: PROC CAUSALMED is modeling the probability that LowBirthWgt='Yes' in the mediator model.
