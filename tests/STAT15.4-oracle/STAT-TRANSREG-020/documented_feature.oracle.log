28263      title 'Introductory Main-Effects ANOVA Example';
28264      data a;
28265      input y x1 $ x2 $;
28266      datalines;

NOTE: The data set WORK.A has 12 observations and 3 variables.

28279      ;
28280      * Fit a main-effects ANOVA model with 1, 0, -1 coding;
28281      proc transreg ss2;
28282      model identity(y) = class(x1 x2 / effects);
28283      output coefficients replace;
28284      run;


