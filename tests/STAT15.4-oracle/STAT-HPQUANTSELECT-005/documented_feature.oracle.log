4842     !  Level` (PDF pp. 5000–5002); S154 / Chapter 66 / `Classification Variables and the SPLIT Option` (PDF pp. 5002–5003).
4843        * Discriminates: Seeded synthetic quantile-regression fixture: Quasi-likelihood Information Criteria / Statistical Tests for Significance Level /
4843     ! Classification Variables and the SPLIT Option
4844        */
4845       options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
4845     ! validmemname=compatible locale=en_US;
4846       %let syscc=0;
4847       title; footnote;
4848       ods _all_ close;
4849       ods listing gpath="%sysfunc(pathname(work))";
4850       ods graphics off;
4851       proc datasets library=work kill nolist;
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK.SAMPLE (memtype=DATA).
NOTE: Deleting WORK.TEMPLAT (memtype=ITEMSTOR).
NOTE: File WORK.TEMPLAT (memtype=ITEMSTOR) cannot be deleted because it is in use.
4851     !                                         quit;


4852       ods path work.templat(update) sashelp.tmplmst(read);
4853       
4854       data sample;
4855       call streaminit(314159);
4856       do id=1 to 120;
4857        x=rand('normal'); z=rand('normal'); w=rand('normal'); group=1+mod(id,3);
4858        y=2+1.5*x-0.6*z+0.4*group+rand('normal');
4859        role=mod(id,4); output;
4860       end;
4861       run;

NOTE: The data set WORK.SAMPLE has 120 observations and 7 variables.

4862       
4863       proc hpquantselect data=sample;
4864       class group(split);
4865       model y=x z w group / quantile=0.5 clb;
4866       selection method=forward(select=sbc choose=sbc);
4867       performance nthreads=1;
4868       run;

NOTE: The HPQUANTSELECT procedure is executing in single-machine mode.
NOTE: The PROCEDURE HPQUANTSELECT printed pages 181-183.

