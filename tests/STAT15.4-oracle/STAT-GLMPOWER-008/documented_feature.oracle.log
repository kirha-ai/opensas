27267      data Exemplary;
27268      do Variety = 1 to 2;
27269      do Exposure = 1 to 3;
27270      input Height @@;
27271      output;
27272      end;
27273      end;
27274      datalines;

NOTE: SAS went to a new line when INPUT statement reached past the end of a line.
NOTE: The data set WORK.EXEMPLARY has 6 observations and 3 variables.

27277      ;
27278      proc glmpower data=Exemplary;
27279      class Variety Exposure;
27280      model Height = Variety | Exposure;
27281      power
27282      stddev = 5
27283      ntotal = 60
27284      power = .;
27285      run;

