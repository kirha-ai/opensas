27306      ;
27307      proc glmpower data=Exemplary;
27308      class Variety Exposure;
27309      model HeightOrig HeightNew = Variety | Exposure;
27310      weight Weight;
27311      contrast 'Exposure=1 vs Exposure=3' Exposure 1 0 -1;
27312      power
27313      stddev = 5
27314      ntotal = 60
27315      power = .;
27316      run;

