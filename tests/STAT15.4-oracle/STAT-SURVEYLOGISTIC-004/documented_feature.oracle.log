20715      data survey;
20716      call streaminit(722);
20717      do stratum=1 to 2;
20718      do cluster=1 to 4;
20719      do id=1 to 12;
20720      age=20+mod(id*7+cluster,45);
20721      event=rand('bernoulli',0.3);
20722      weight=2+stratum+cluster/10;
20723      output;
20724      end;
20725      end;
20726      end;
20727      run;

NOTE: The data set WORK.SURVEY has 96 observations and 6 variables.

20728      proc surveylogistic data=survey;
20729      strata stratum;
20730      cluster cluster;
20731      weight weight;
20732      model event(event='1')=age;
20733      run;

NOTE: PROC SURVEYLOGISTIC is modeling the probability that event=1.
