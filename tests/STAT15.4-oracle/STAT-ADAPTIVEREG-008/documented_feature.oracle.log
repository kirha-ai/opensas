472        ods trace on;
473        data Mixture;
474        drop i;
475        do i=1 to 1000;
476        X1 = ranuni(1);
477        C1 = int(3*ranuni(1));
478        if C1=0 then Y=exp(5*(X1-0.3)**2)+rannor(1);
479        else if C1=1 then Y=log(X1*(1-X1))+rannor(1);
480        else Y=7*X1+rannor(1);
481        output;
482        end;
483        run;

NOTE: The data set WORK.MIXTURE has 1000 observations and 3 variables.

484        ods graphics on;
485        proc adaptivereg data=Mixture plots=fit;
486        class c1;
487        model y=c1 x1;
488        run;


