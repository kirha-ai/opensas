493        data New;
494        set Mixture;
495        basis1 = (c1=1 OR c1=0);
496        basis3 = (c1=1);
497        basis5 = NOT(c1=1) *MAX(x1-0.7665019053,0);
498        basis7 = NOT(c1=1 OR c1=0) *MAX(x1-0.7665019053,0);
499        basis8 = NOT(c1=1 OR c1=0) *MAX(0.7665019053-x1,0);
500        basis9 = (c1=1) *MAX(x1-0.5530566455,0);
501        basis10 = (c1=1)*MAX(0.5530566455-x1,0);
502        basis11 = (c1=1)*MAX(x1-0.045800759,0);
503        basis13 = (c1=1)*MAX(x1-0.9526330293,0);
504        basis15 = (c1=1 OR c1=0)*MAX(x1-0.9499325226,0);
505        basis17 = (c1=1 OR c1=0)*MAX(x1-0.5142821095,0);
506        basis19 = (c1=1 OR c1=0)*MAX(x1-0.9889635476,0);
507        pred = 5.3829 - 4.3871 *basis1 + 32.7761*basis3 +
508        20.2859*basis5 - 11.4183*basis7 - 7.0758*basis8 +
509        58.4911*basis9 - 71.6388*basis10 - 69.0764*basis11 -
510        119.71*basis13 + 66.5733*basis15 + 6.6681*basis17 -
511        185.21*basis19;
512        run;

