1561       proc datasets library=work kill nolist;
NOTE: Deleting WORK.LONGLEY (memtype=DATA).
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
1561     !                                         quit;


1562       ods path work.templat(update) sashelp.tmplmst(read);
1563       
1564       ods graphics on;
1565       ods trace on;
1566       ods trace on;
1567       title 'Polynomial Data';
1568       data Polynomial;
1569       do i = 1 to 101;
1570       x = (i-1)/(101-1);
1571       y = 10**(9/2);
1572       do j = 0 to 8;
1573       y = y * (x - j/8);
1574       end;
1575       output;
1576       end;
1577       run;

NOTE: The data set WORK.POLYNOMIAL has 101 observations and 4 variables.

1578       ods graphics on;
1579       proc orthoreg data=Polynomial;
1580       effect xMod = polynomial(x / degree=9);
1581       model y = xMod;
1582       effectplot fit / obs;
1583       store OStore;
1584       run;


