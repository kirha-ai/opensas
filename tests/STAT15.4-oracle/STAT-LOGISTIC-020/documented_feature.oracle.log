15109      data Crops;
15110      length Crop $ 10;
15111      infile datalines truncover;
15112      input Crop $ @@;
15113      do i=1 to 3;
15114      input x1-x4 @@;
15115      if (x1 ^= .) then output;
15116      end;
15117      input;
15118      datalines;

NOTE: The data set WORK.CROPS has 36 observations and 6 variables.

15132      ;
15133      ods graphics on;
15134      proc logistic data=Crops;
15135      model Crop=x1-x4 / link=glogit;
15136      score out=Score1;
15137      effectplot slicefit(x=x3);
15138      run;

