11835      data predict;
11836      drop lambda _scale_ _prob_;
11837      set out;
11838      if _n_ eq 1 then set outest;
11839      lambda = pdf('NORMAL',Xbeta/_scale_)
11840      / cdf('NORMAL',Xbeta/_scale_);
11841      Predict = cdf('NORMAL', Xbeta/_scale_)
11842      * (Xbeta + _scale_*lambda);
11843      label Xbeta='MEAN OF UNCENSORED VARIABLE'
11844      Predict = 'MEAN OF CENSORED VARIABLE';
11845      run;

