14887      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
14887    ! validmemname=compatible locale=en_US;
14888      %let syscc=0;
14889      title; footnote;
14890      ods _all_ close;
14891      ods listing gpath="%sysfunc(pathname(work))";
14892      ods graphics off;
14893      proc datasets library=work kill nolist;
NOTE: Deleting WORK.RECOVER (memtype=DATA).
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK.ROBOUT (memtype=DATA).
NOTE: Deleting WORK.SASGOPT (memtype=CATALOG).
