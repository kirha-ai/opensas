NOTE: Deleting WORK.TEMPLAT (memtype=ITEMSTOR).
NOTE: File WORK.TEMPLAT (memtype=ITEMSTOR) cannot be deleted because it is in use.
14893    !                                         quit;


14894      ods path work.templat(update) sashelp.tmplmst(read);
14895      
14896      title 'Response Surface with a Simple Optimum';
14897      data smell;
14898      input Odor T R H @@;
14899      label
14900      T = "Temperature"
14901      R = "Gas-Liquid Ratio"
14902      H = "Packing Height";
14903      datalines;

NOTE: SAS went to a new line when INPUT statement reached past the end of a line.
NOTE: The data set WORK.SMELL has 15 observations and 4 variables.

14908      ;
14909      proc rsreg data=smell;
14910      model Odor = T R H / lackfit;
14911      run;

NOTE: The PROCEDURE RSREG printed pages 1100-1101.

14912      ods graphics on;
14913      proc rsreg data=smell
14914      plots(unpack)=surface(3d at(H=7.541050));
14915      model Odor = T R H;
14916      ods select 'T * R = Pred';
14917      run;


14918      ods graphics off;
14919      run;
14920      quit;
