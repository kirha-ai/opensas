251        %macro _oracle_descriptor(ds);
252        proc contents data=&ds out=_oracle_descriptor(keep=name type length varnum label format informat) noprint; run;
253        proc sort data=_oracle_descriptor; by varnum; run;
254        proc print data=_oracle_descriptor noobs; run;
255        data _oracle_member;
256        length Dataset $64 DatasetType $16;
257        Dataset="&ds"; _handle=open("&ds");
258        DatasetType=attrc(_handle,'TYPE'); NObs=attrn(_handle,'NOBS'); NVars=attrn(_handle,'NVARS');
259        _close=close(_handle); drop _handle _close;
260        run;
261        proc print data=_oracle_member noobs; run;
