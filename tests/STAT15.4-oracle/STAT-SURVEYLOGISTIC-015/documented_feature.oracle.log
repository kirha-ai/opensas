21193      do stratum=1 to 2;
21194      do cluster=1 to 4;
21195      do id=1 to 12;
21196      age=20+mod(id*7+cluster,45);
21197      event=rand('bernoulli',0.3);
21198      weight=2+stratum+cluster/10;
21199      output;
21200      end;
21201      end;
21202      end;
21203      run;

