3951       data line;
3952       length Cult$ 8;
3953       input Block Cult$ @;
3954       row = _n_;
3955       do Sbplt=1 to 12;
3956       if Sbplt le 6 then do;
3957       Irrig = Sbplt;
3958       Dir = 'North';
3959       end;
3960       else do;
3961       Irrig = 13 - Sbplt;
3962       Dir = 'South';
3963       end;
3964       input Y @;
3965       output;
3966       end;
3967       datalines;

NOTE: The data set WORK.LINE has 108 observations and 7 variables.

3977       ;
3978       proc mixed;
3979       class Block Cult Dir Irrig;
3980       model Y = Cult|Dir|Irrig@2;
3981       random Block Block*Dir Block*Irrig;
3982       repeated / type=toep(4) sub=Block*Cult r;
3983       lsmeans Cult|Irrig;
3984       estimate 'Bridger vs Luke' Cult 1 -1 0;
3985       estimate 'Linear Irrig' Irrig -5 -3 -1 1 3 5;
3986       estimate 'B vs L x Linear Irrig' Cult*Irrig
3987       -5 -3 -1 1 3 5 5 3 1 -1 -3 -5;
3988       run;

NOTE: Convergence criteria met.
