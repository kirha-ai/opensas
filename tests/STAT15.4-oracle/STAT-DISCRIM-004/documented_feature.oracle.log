14979      contourplotparm x=petallength y=petalwidth z=z /
14980      contourtype=fill nhint=30;
14981      scatterplot x=pl y=pw / group=species name='iris'
14982      includemissinggroup=false primary=true;
14983      layout gridded / autoalign=(topleft);
14984      discretelegend 'iris' / border=false opaque=false;
14985      endlayout;
14986      endlayout;
14987      endgraph;
14988      end;
NOTE: STATGRAPH 'Contour' has been saved to: WORK.TEMPLAT
