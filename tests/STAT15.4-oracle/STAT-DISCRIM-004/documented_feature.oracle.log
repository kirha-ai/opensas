14949      title 'Discriminant Analysis of Fisher (1936) Iris Data';
14950      proc template;
14951      define statgraph scatter;
14952      begingraph;
14953      entrytitle 'Fisher (1936) Iris Data';
14954      layout overlayequated / equatetype=fit;
14955      scatterplot x=petallength y=petalwidth /
14956      group=species name='iris';
14957      layout gridded / autoalign=(topleft);
14958      discretelegend 'iris' / border=false opaque=false;
14959      endlayout;
14960      endlayout;
14961      endgraph;
14962      end;
NOTE: Overwriting existing template/link: Scatter
