14990      %macro contden;
14991      data contour(keep=PetalWidth PetalLength species z pl pw);
14992      merge plotd(in=d) sashelp.iris(keep=PetalWidth PetalLength species
14993      rename=(PetalWidth=pw PetalLength=pl));
14994      if d then z = max(setosa,versicolor,virginica);
14995      run;
14996      title3 'Plot of Estimated Densities';
14997      proc sgrender data=contour template=contour;
14998      run;
14999      %mend;
15000      %macro contprob;
15001      data posterior(keep=PetalWidth PetalLength species z pl pw into);
15002      merge plotp(in=d) sashelp.iris(keep=PetalWidth PetalLength species
15003      rename=(PetalWidth=pw PetalLength=pl));
15004      if d then z = max(setosa,versicolor,virginica);
15005      into = 1 * (_into_ =: 'Set') + 2 * (_into_ =: 'Ver') +
15006      3 * (_into_ =: 'Vir');
15007      run;
15008      title3 'Plot of Posterior Probabilities ';
15009      proc sgrender data=posterior template=contour;
15010      run;
15011      %mend;
15012      %macro contclass;
15013      title3 'Plot of Classification Results';
15014      proc sgrender data=posterior(drop=z rename=(into=z)) template=contour;
15015      run;
15016      %mend;
