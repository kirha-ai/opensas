202        options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
202      ! validmemname=compatible locale=en_US;
203        %let syscc=0;
204        title; footnote;
205        ods _all_ close;
206        ods listing gpath="%sysfunc(pathname(work))";
207        ods graphics off;
208        proc datasets library=work kill nolist;
NOTE: Deleting WORK.EST (memtype=DATA).
