10574      /* STAT-CALIS-029: CALIS — Displayed Output / ODS Table Names
10575       * Source: S154 / Chapter 33 / `Displayed Output` (PDF pp. 1817–1822); S154 / Chapter 33 / `ODS Table Names` (PDF pp. 1822–1836).
10576       * Discriminates: Getting Started: CALIS Procedure
10577       */
10578      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
10578    ! validmemname=compatible locale=en_US;
10579      %let syscc=0;
10580      title; footnote;
10581      ods _all_ close;
10582      ods listing gpath="%sysfunc(pathname(work))";
10583      ods graphics off;
10584      proc datasets library=work kill nolist;
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK.SASGOPT (memtype=CATALOG).
NOTE: File WORK.SASGOPT (memtype=CATALOG) cannot be deleted because it is in use.
NOTE: Deleting WORK.SASMAC1 (memtype=CATALOG).
NOTE: File WORK.SASMAC1 (memtype=CATALOG) cannot be deleted because it is in use.
NOTE: Deleting WORK.TEMPLAT (memtype=ITEMSTOR).
NOTE: File WORK.TEMPLAT (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK.WHEATON (memtype=DATA).
10584    !                                         quit;


10585      ods path work.templat(update) sashelp.tmplmst(read);
10586      
10587      ods trace on;
10588      data Wheaton(TYPE=COV);
10589      length _name_ $32 _type_ $8;
10590      infile datalines truncover;
10591      
10592      _type_ = 'cov';
10593      input _name_ :$32. Anomie67 Powerless67 Anomie71 Powerless71
10594      Education SEI;
10595      label Anomie67='Anomie (1967)' Powerless67='Powerlessness (1967)'
10596      Anomie71='Anomie (1971)' Powerless71='Powerlessness (1971)'
10597      Education='Education' SEI='Occupational Status Index';
10598      datalines;

NOTE: The data set WORK.WHEATON has 6 observations and 8 variables.

10605      ;
10606      run;
10607      proc calis nobs=932 data=Wheaton;
10608      path
10609      Anomie67 <=== Alien67 = 1.0,
10610      Powerless67 <=== Alien67 = 0.833,
10611      Anomie71 <=== Alien71 = 1.0,
10612      Powerless71 <=== Alien71 = 0.833,
10613      Education <=== SES = 1.0,
10614      SEI <=== SES = lambda,
10615      Alien67 <=== SES = gamma1,
10616      Alien71 <=== SES = gamma2,
10617      Alien71 <=== Alien67 = beta;
10618      pvar
10619      Anomie67 = theta1,
10620      Powerless67 = theta2,
10621      Anomie71 = theta1,
10622      Powerless71 = theta2,
10623      Education = theta3,
10624      SEI = theta4,
10625      Alien67 = psi1,
10626      Alien71 = psi2,
10627      SES = phi;
10628      pcov
10629      Anomie67 Anomie71 = theta5,
10630      Powerless67 Powerless71 = theta5;
10631      run;

NOTE: The means of one or more variables in the input data set WORK.WHEATON are missing and are assumed to be 0.

