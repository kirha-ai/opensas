10664      proc calis nobs=932 data=Wheaton;
10665      lineqs
10666      Anomie67 = 1.0 * f_Alien67 + E1,
10667      Powerless67 = 0.833 * f_Alien67 + E2,
10668      Anomie71 = 1.0 * f_Alien71 + E3,
10669      Powerless71 = 0.833 * f_Alien71 + E4,
10670      Education = 1.0 * f_SES + E5,
10671      SEI = lambda * f_SES + E6,
10672      f_Alien67 = gamma1 * f_SES + D1,
10673      f_Alien71 = gamma2 * f_SES + beta * f_Alien67 + D2;
10674      std
10675      E1 = theta1,
10676      E2 = theta2,
10677      E3 = theta1,
10678      E4 = theta2,
10679      E5 = theta3,
10680      E6 = theta4,
10681      D1 = psi1,
10682      D2 = psi2,
10683      f_SES = phi;
10684      cov
10685      E1 E3 = theta5,
10686      E2 E4 = theta5;
10687      run;

