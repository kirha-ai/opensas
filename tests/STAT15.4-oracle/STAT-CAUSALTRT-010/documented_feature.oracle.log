13834      ods graphics on;
13835      ods trace on;
13836      ods trace on;
13837      data drugs; call streaminit(193); length Drug $6 Gender $1 Diabetes2 $3; do ID=1 to 200; Age=20+mod(id*7,45); BMI=20+mod(id,12); if mod(id,2) then
13837    ! Gender='F'; else Gender='M'; if rand('bernoulli',0.5) then Drug='Drug_A'; else Drug='Drug_B'; if rand('bernoulli',0.3+0.1*(Drug='Drug_A')) then
13837    ! Diabetes2='Yes'; else Diabetes2='No'; output; end; run;

NOTE: The data set WORK.DRUGS has 200 observations and 6 variables.

13838      
13839      proc causaltrt data=drugs method=ipwr ppsmodel;
13840      class Gender;
13841      psmodel Drug(ref='Drug_A') = Age Gender BMI;
13842      model Diabetes2(ref='No') / dist = bin;
13843      run;


