2514     !                                         quit;


2515       ods path work.templat(update) sashelp.tmplmst(read);
2516       
2517       data a (drop=i);
2518       do i=1 to 1000;
2519       x1=rannor(1234);
2520       x2=rannor(1234);
2521       e=rannor(1234);
2522       if i > 950 then y=100 + 10*e;
2523       else y=10 + 5*x1 + 3*x2 + 0.5 * e;
2524       output;
2525       end;
2526       run;

NOTE: The data set WORK.A has 1000 observations and 4 variables.

2527       proc quantreg data=a;
2528       model y = x1 x2 / seed=314159;
2529       run;

NOTE: No valid quantiles are specified. PROC QUANTREG computes median regression.
NOTE: The PROCEDURE QUANTREG printed page 134.

2530       proc quantreg algorithm=interior(tolerance=1e-6)
2531       ci=none data=a;
2532       model y = x1 x2 / itprint nosummary seed=314159;
2533       run;

NOTE: No valid quantiles are specified. PROC QUANTREG computes median regression.
NOTE: The PROCEDURE QUANTREG printed pages 135-136.

2534       proc quantreg algorithm=smooth(rratio=.5) ci=none data=a;
2535       model y = x1 x2 / itprint nosummary seed=314159;
2536       run;

NOTE: No valid quantiles are specified. PROC QUANTREG computes median regression.
NOTE: The PROCEDURE QUANTREG printed pages 137-138.

