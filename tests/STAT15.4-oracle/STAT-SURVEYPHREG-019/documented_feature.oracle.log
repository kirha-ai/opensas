23560    !                                         quit;


23561      ods path work.templat(update) sashelp.tmplmst(read);
23562      
23563      ods trace on;
23564      data survey;
23565      call streaminit(722);
23566      do stratum=1 to 2;
23567      do cluster=1 to 4;
23568      do id=1 to 12;
23569      age=20+mod(id*7+cluster,45);
23570      time=1+rand('exponential')*10;
23571      status=(mod(id,4) ne 0);
23572      weight=2+stratum+cluster/10;
23573      output;
23574      end;
23575      end;
23576      end;
23577      run;

NOTE: The data set WORK.SURVEY has 96 observations and 7 variables.

23578      proc surveyphreg data=survey;
23579      strata stratum;
23580      cluster cluster;
23581      weight weight;
23582      model time*status(0)=age;
23583      run;


