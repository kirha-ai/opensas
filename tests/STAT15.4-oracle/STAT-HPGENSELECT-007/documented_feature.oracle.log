2435       
2436       %let nObs = 1500;
2437       %let nContIn = 5;
2438       %let nContOut = 10;
2439       %let Seed = 12345;
2440       data ex4Data;
2441       array xIn{&nContIn};
2442       array xOut{&nContOut};
2443       drop i j sign xBeta expXbeta;
2444       seed = &Seed;
2445       do i=1 to &nObs;
2446       sign = -1;
2447       xBeta = 0;
2448       do j=1 to dim(xIn);
2449       call ranuni(seed,xIn[j]);
2450       xBeta = xBeta + j *sign*xIn{j};
2451       sign = -sign;
2452       end;
2453       do j=1 to dim(xOut);
2454       call ranuni(seed,xOut[j]);
2455       end;
2456       call ranuni(seed,xSubtle);
2457       call ranuni(seed,xTiny);
2458       xBeta = xBeta + 0.1*xSubtle + 0.05*xTiny;
2459       expXbeta = exp(xBeta/20);
2460       call ranpoi(seed,expXbeta,yPoisson);
2461       output;
2462       end;
2463       run;

NOTE: The data set WORK.EX4DATA has 1500 observations and 19 variables.

2464       proc hpgenselect data=ex4Data(Obs=10000);
2465       model yPoisson = x: / dist=Poisson;
2466       selection method=Lasso(choose=SBC) details=all;
2467       performance details;
2468       run;

NOTE: The HPGENSELECT procedure is executing in single-machine mode.
