401        /* STAT-ANOVA-004: ANOVA — ABSORB / Using PROC ANOVA Interactively / Computational Method
402         * Source: S154 / Chapter 29 / `ABSORB Statement` (PDF p. 1117); S154 / Chapter 29 / `Using PROC ANOVA Interactively` (PDF p. 1138); S154 / Chapter
402      ! 29 / `Computational Method` (PDF p. 1140).
403         * Discriminates: Explicit ABSORB statement behavior on seeded synthetic inputs.
404         */
405        options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
405      ! validmemname=compatible locale=en_US;
406        %let syscc=0;
407        title; footnote;
408        ods _all_ close;
409        ods listing gpath="%sysfunc(pathname(work))";
410        ods graphics off;
411        proc datasets library=work kill nolist;
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK.SAMPLE (memtype=DATA).
NOTE: Deleting WORK.SASMAC1 (memtype=CATALOG).
