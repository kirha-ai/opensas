NOTE: Deleting WORK._ORACLE_MEMBER (memtype=DATA).
411      !                                         quit;


412        ods path work.templat(update) sashelp.tmplmst(read);
413        
414        data sample;
415        call streaminit(314159);
416        do block=1 to 4; do group=1 to 2; do replicate=1 to 5;
417        y=10+block+2*group+rand('normal');
418        y1=y+rand('normal'); y2=y+1+rand('normal'); y3=y+2+rand('normal');
419        output;
420        end; end; end;
421        run;

NOTE: The data set WORK.SAMPLE has 40 observations and 7 variables.

422        proc anova data=sample; absorb block; class group; model y=group; run;

422      !                                                                        quit;

