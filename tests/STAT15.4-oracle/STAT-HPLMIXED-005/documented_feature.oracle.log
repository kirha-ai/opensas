2820       data SchoolSample;
2821       do SchoolID = 1 to 300;
2822       do nID = 1 to 25;
2823       Neighborhood = (SchoolID-1)*5 + nId;
2824       bInt = 5 *ranuni(1);
2825       bTime = 5 *ranuni(1);
2826       bTime2 = ranuni(1);
2827       do sID = 1 to 2;
2828       do Time = 1 to 4;
2829       Math = bInt + bTime*Time + bTime2*Time*Time + rannor(2);
2830       output;
2831       end;
2832       end;
2833       end;
2834       end;
2835       run;

NOTE: The data set WORK.SCHOOLSAMPLE has 60000 observations and 9 variables.

2836       proc hplmixed data=SchoolSample;
2837       class Neighborhood SchoolID;
2838       model Math = Time Time*Time / solution;
2839       random int Time Time *Time / sub=Neighborhood(SchoolID) type=un;
2840       run;

NOTE: The HPLMIXED procedure is executing in single-machine mode.
NOTE: Convergence criterion (ABSGCONV=0.00001) satisfied.
