13875      proc causaltrt data=drugs method=ipwr ppsmodel;
13876      class Gender;
13877      psmodel Drug(ref='Drug_A') = Age Gender BMI;
13878      model Diabetes2(ref='No') / dist = bin;
13879      run;

NOTE: PROC CAUSALTRT is modeling the probability that Diabetes2='Yes'.
NOTE: PROC CAUSALTRT is modeling the probability that Drug='Drug_B'.
