5231     !                                         quit;


5232       ods path work.templat(update) sashelp.tmplmst(read);
5233       
5234       ods trace on;
5235       data Sim;
5236       keep Species Farm Animal Yield;
5237       array AnimalEffect{3000};
5238       array AnimalSpecies{3000};
5239       array AnimalFarm{3000};
5240       do i = 1 to 3000;
5241       AnimalEffect{i} = sqrt(4.0)*rannor(12345);
5242       AnimalSpecies{i} = 1 + int(5*ranuni(12345));
5243       AnimalFarm{i} = 1 + int(10 *ranuni(12345));
5244       end;
5245       do i = 1 to 40000;
5246       Animal = 1 + int(3000 *ranuni(12345));
5247       Species = AnimalSpecies{Animal};
5248       Farm = AnimalFarm{Animal};
5249       Yield = 1 + Species + int(Farm/2) + AnimalEffect{Animal}
5250       + sqrt(8.0)*rannor(12345);
5251       output;
5252       end;
5253       run;

NOTE: The data set WORK.SIM has 40000 observations and 4 variables.

5254       proc hpmixed data=Sim;
5255       class Species Farm Animal;
5256       model Yield = Farm|Species;
5257       random Animal;
5258       test Species Species*Farm;
5259       ods output CovParms=HPMEstimate;
5260       run;


