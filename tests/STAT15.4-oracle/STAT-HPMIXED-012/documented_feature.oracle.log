5261       ods graphics on;
5262       proc glimmix data=Sim;
5263       class Species Farm Animal;
5264       model Yield = Farm|Species;
5265       random int/sub=Animal;
5266       parms /pdata=HPMEstimate hold=1,2 noiter;
5267       lsmeans Farm / pdiff=all plot=diffplot;
5268       run;




