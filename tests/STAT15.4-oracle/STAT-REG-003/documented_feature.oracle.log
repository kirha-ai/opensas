NOTE: The data set WORK.USPOPULATION has 22 observations and 3 variables.

12218      ;
12219      proc reg data=USPopulation plots=ResidualByPredicted;
12220      var YearSq;
12221      model Population=Year / r clm cli;
12222      run;

