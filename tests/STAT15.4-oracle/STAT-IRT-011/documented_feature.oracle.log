9201       ods path work.templat(update) sashelp.tmplmst(read);
9202       
9203       data responses;
9204       call streaminit(329);
9205       array item[5] item1-item5;
9206       do subject=1 to 150;
9207       theta=rand('normal');
9208       do k=1 to 5;
9209       item[k]=rand('bernoulli',1/(1+exp(-(theta-(k-3)/2))));
9210       end;
9211       output;
9212       end;
9213       keep item1-item5;
9214       run;

NOTE: The data set WORK.RESPONSES has 150 observations and 5 variables.

9215       proc irt data=responses;
9216       var item1-item5;
9217       run;

NOTE: The observed frequency is zero for some response patterns. As a result, the Pearson chi-square model fit statistic is not calculated.
