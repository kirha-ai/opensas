2860       ods path work.templat(update) sashelp.tmplmst(read);
2861       
2862       %let NCenter = 100;
2863       %let NPatient = %eval(&NCenter*50);
2864       %let NTime = 3;
2865       %let SigmaC = 2.0;
2866       %let SigmaP = 4.0;
2867       %let SigmaE = 8.0;
2868       %let Seed = 12345;
2869       data WeekSim;
2870       keep Gender Center Patient Time Measurement;
2871       array PGender{&NPatient};
2872       array PCenter{&NPatient};
2873       array PEffect{&NPatient};
2874       array CEffect{&NCenter};
2875       array GEffect{2};
2876       do Center = 1 to &NCenter;
2877       CEffect{Center} = sqrt(&SigmaC)*rannor(&Seed);
2878       end;
2879       GEffect{1} = 10*ranuni(&Seed);
2880       GEffect{2} = 10*ranuni(&Seed);
2881       do Patient = 1 to &NPatient;
2882       PGender{Patient} = 1 + int(2 *ranuni(&Seed));
2883       PCenter{Patient} = 1 + int(&NCenter*ranuni(&Seed));
2884       PEffect{Patient} = sqrt(&SigmaP)*rannor(&Seed);
2885       end;
2886       do Patient = 1 to &NPatient;
2887       Gender = PGender{Patient};
2888       Center = PCenter{Patient};
2889       Mean = 1 + GEffect{Gender} + CEffect{Center} + PEffect{Patient};
2890       do Time = 1 to &nTime;
2891       Measurement = Mean + sqrt(&SigmaE)*rannor(&Seed);
2892       output;
2893       end;
2894       end;
2895       run;

NOTE: The data set WORK.WEEKSIM has 15000 observations and 5 variables.

2896       ods exclude all;
2897       proc hplmixed data=WeekSim blup;
2898       class Gender Center Patient Time;
2899       model Measurement = Gender;
2900       random Center / s;
2901       repeated Time / sub=Patient type=un;
2902       parms 1.7564
