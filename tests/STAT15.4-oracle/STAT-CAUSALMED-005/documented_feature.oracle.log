13393      proc causalmed data=sashelp.birthwgt decomp;
13394      class LowBirthWgt Smoking Death AgeGroup Married Race
13395      Drinking SomeCollege /descending;
13396      mediator LowBirthWgt = Smoking;
13397      model Death = LowBirthWgt | Smoking;
13398      covar AgeGroup Married Race Drinking SomeCollege;
13399      evaluate 'Low Birth-Weight' LowBirthWgt='Yes' / nodecomp;
13400      evaluate 'Normal Birth-Weight' LowBirthWgt='No' / nodecomp;
13401      run;

NOTE: PROC CAUSALMED is modeling the probability that Death='Yes' in the outcome model.
NOTE: PROC CAUSALMED is modeling the probability that LowBirthWgt='Yes' in the mediator model.
