10328      data survival;
10329      call streaminit(518);
10330      do id=1 to 80;
10331      drug=mod(id,2);
10332      age=25+mod(id*7,40);
10333      time=exp(2+0.25*drug+0.008*age+rand('normal')*0.4);
10334      status=(mod(id,5) ne 0);
10335      output;
10336      end;
10337      run;

NOTE: The data set WORK.SURVIVAL has 80 observations and 5 variables.

10338      proc quantlife data=survival seed=1268;
10339      class drug;
10340      model time*status(0)=drug age / quantile=0.5;
10341      run;

