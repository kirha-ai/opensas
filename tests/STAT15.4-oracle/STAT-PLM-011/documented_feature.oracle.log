5153       ods path work.templat(update) sashelp.tmplmst(read);
5154       
5155       %let nObs = 5000;
5156       %let nVars = 100;
5157       data SimuData;
5158       array x{&nVars};
5159       do obsNum=1 to &nObs;
5160       do j=1 to &nVars;
5161       x{j}=ranuni(1);
5162       end;
5163       linp = 10 + 11 *x1 - 10*sqrt(x2) + 2/x3 - 8*exp(x4) + 7*x5*x5
5164       - 6*x6**1.5 + 5*log(x7) - 4*sin(3.14*x8) + 3*x9 - 2*x10;
5165       TrueProb = 1/(1+exp(-linp));
5166       if ranuni(1) < TrueProb then y=1;
5167       else y=0;
5168       output;
5169       end;
5170       run;

NOTE: The data set WORK.SIMUDATA has 5000 observations and 105 variables.

5171       proc logistic data=SimuData;
5172       effect splines = spline(x1-x&nVars/separate);
5173       model y = splines/selection=stepwise;
5174       store work.SimuModel;
5175       run;

