NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK.RESPONSES (memtype=DATA).
NOTE: Deleting WORK.TEMPLAT (memtype=ITEMSTOR).
NOTE: File WORK.TEMPLAT (memtype=ITEMSTOR) cannot be deleted because it is in use.
9274     !                                         quit;


9275       ods path work.templat(update) sashelp.tmplmst(read);
9276       
9277       ods graphics on;
9278       ods trace on;
9279       ods trace on;
9280       data responses;
9281       call streaminit(329);
9282       array item[5] item1-item5;
9283       do subject=1 to 150;
9284       theta=rand('normal');
9285       do k=1 to 5;
9286       item[k]=rand('bernoulli',1/(1+exp(-(theta-(k-3)/2))));
9287       end;
9288       output;
9289       end;
9290       keep item1-item5;
9291       run;

NOTE: The data set WORK.RESPONSES has 150 observations and 5 variables.

9292       proc irt data=responses;
9293       var item1-item5;
9294       run;


