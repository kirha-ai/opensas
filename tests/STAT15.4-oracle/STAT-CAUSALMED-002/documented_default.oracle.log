13295    !                                         quit;


13296      ods path work.templat(update) sashelp.tmplmst(read);
13297      
13298      proc causalmed data=sashelp.birthwgt decomp;
13299      class LowBirthWgt Smoking Death AgeGroup Married Race
13300      Drinking SomeCollege /descending;
13301      mediator LowBirthWgt = Smoking;
13302      model Death = LowBirthWgt | Smoking;
13303      covar AgeGroup Married Race Drinking SomeCollege;
13304      evaluate 'Low Birth-Weight' LowBirthWgt='Yes' / nodecomp;
13305      evaluate 'Normal Birth-Weight' LowBirthWgt='No' / nodecomp;
13306      run;

NOTE: PROC CAUSALMED is modeling the probability that Death='Yes' in the outcome model.
NOTE: PROC CAUSALMED is modeling the probability that LowBirthWgt='Yes' in the mediator model.
NOTE: The PROCEDURE CAUSALMED printed pages 1808-1813.

13307      quit;
