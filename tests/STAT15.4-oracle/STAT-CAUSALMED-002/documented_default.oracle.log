13288       */
13289      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
13289    ! validmemname=compatible locale=en_US;
13290      %let syscc=0;
13291      title; footnote;
13292      ods _all_ close;
13293      ods listing gpath="%sysfunc(pathname(work))";
13294      ods graphics off;
13295      proc datasets library=work kill nolist;
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
