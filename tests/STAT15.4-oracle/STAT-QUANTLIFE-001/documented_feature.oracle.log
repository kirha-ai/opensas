10130      data survival;
10131      call streaminit(518);
10132      do id=1 to 80;
10133      drug=mod(id,2);
10134      age=25+mod(id*7,40);
10135      time=exp(2+0.25*drug+0.008*age+rand('normal')*0.4);
10136      status=(mod(id,5) ne 0);
10137      output;
10138      end;
10139      run;

NOTE: The data set WORK.SURVIVAL has 80 observations and 5 variables.

10140      proc quantlife data=survival seed=1268;
10141      class drug;
10142      model time*status(0)=drug age / quantile=0.5;
10143      run;

