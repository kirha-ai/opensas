3771       /* Seeded synthetic survey input; not the externally distributed NHANES file. */
3772       data Smoke;
3773       call streaminit(314159);
3774       array reps{4} wtpqrp1-wtpqrp4;
3775       do seqn=1 to 512;
3776        HFA7=6+mod(seqn,12); DMARETHN=1+mod(floor((seqn-1)/2),4); HSSEX=1+mod(seqn,2);
3777        stratum=1+mod(floor((seqn-1)/8),2); psu=1+mod(floor((seqn-1)/16),2);
3778        wtpfqx6=1.5+mod(seqn,3)/2;
3779        HFF1MI=1+rand('bernoulli',0.45); HAN6SRMI=1+rand('bernoulli',0.55);
3780        HAR3RMI=1+rand('bernoulli',0.5); HAT28MI=1+rand('bernoulli',0.4);
3781        HFF1IF=1+rand('bernoulli',0.08); HAN6SRIF=1+rand('bernoulli',0.08);
3782        HAR3RIF=1+rand('bernoulli',0.08); HAT28IF=1+rand('bernoulli',0.08);
3783        do r=1 to 4;
3784         choice=1+mod(floor((r-1)/(2**(stratum-1))),2);
3785         if psu=choice then reps{r}=1.7*wtpfqx6; else reps{r}=0.3*wtpfqx6;
3786        end;
3787        output;
3788       end;
3789       drop r choice;
3790       run;

NOTE: The data set WORK.SMOKE has 512 observations and 19 variables.

3791       data Smoke;
3792       set Smoke;
3793       if HFA7 <=8 then Education='Elementary ';
3794       if HFA7 > 8 and HFA7 <= 12 then Education='High School';
3795       if HFA7 > 12 and HFA7 <= 17 then Education='College ';
3796       if HFA7 > 17 then Education='Unknown ';
3797       if DMARETHN = 1 & HSSEX = 1 then ImputationCells=1;
3798       if DMARETHN = 1 & HSSEX = 2 then ImputationCells=2;
3799       if DMARETHN = 2 & HSSEX = 1 then ImputationCells=3;
3800       if DMARETHN = 2 & HSSEX = 2 then ImputationCells=4;
3801       if DMARETHN = 3 & HSSEX = 1 then ImputationCells=5;
3802       if DMARETHN = 3 & HSSEX = 2 then ImputationCells=6;
3803       if DMARETHN = 4 then ImputationCells=7;
3804       if HFF1IF = 2 then HFF1MI = .;
3805       if HAN6SRIF = 2 then HAN6SRMI = .;
3806       if HAR3RIF = 2 then HAR3RMI = .;
3807       if HAT28IF = 2 then HAT28MI = .;
3808       run;

NOTE: There were 512 observations read from the data set WORK.SMOKE.
NOTE: The data set WORK.SMOKE has 512 observations and 21 variables.

3809       proc surveyimpute data=Smoke method=FEFI varmethod=BRR;
3810       weight wtpfqx6;
3811       repweights wtpqrp:;
3812       id seqn;
3813       class hff1mi han6srmi har3rmi hat28mi;
3814       var hff1mi han6srmi har3rmi hat28mi;
3815       cells ImputationCells;
3816       output out=SmokeImputed;
3817       run;

NOTE: Convergence achieved; maximum relative difference less than 0.001 for fractional weights for the EM algorithm.
NOTE: The data set WORK.SMOKEIMPUTED has 679 observations and 27 variables.
