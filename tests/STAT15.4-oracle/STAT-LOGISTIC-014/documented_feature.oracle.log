14515      ods graphics on;
14516      proc logistic data=Neuralgia plots(only)=(oddsratio(range=clip));
14517      class Treatment Sex /param=ref;
14518      model Pain= Treatment Sex Age / noor;
14519      oddsratio Treatment;
14520      oddsratio Sex;
14521      oddsratio Age;
14522      contrast 'Pairwise A vs P' Treatment 1 0 / estimate=exp;
14523      contrast 'Pairwise B vs P' Treatment 0 1 / estimate=exp;
14524      contrast 'Pairwise A vs B' Treatment 1 -1 / estimate=exp;
14525      contrast 'Female vs Male' Sex 1 / estimate=exp;
14526      effectplot / at(Sex=all) noobs;
14527      effectplot slicefit(sliceby=Sex plotby=Treatment) / noobs;
14528      run;

NOTE: PROC LOGISTIC is modeling the probability that Pain='No'. One way to change this to model the probability that Pain='Yes' is to specify the response 
