15191      title 'Response Surface with a Simple Optimum';
15192      data smell;
15193      input Odor T R H @@;
15194      label
15195      T = "Temperature"
15196      R = "Gas-Liquid Ratio"
15197      H = "Packing Height";
15198      datalines;

NOTE: SAS went to a new line when INPUT statement reached past the end of a line.
NOTE: The data set WORK.SMELL has 15 observations and 4 variables.

15203      ;
15204      proc rsreg data=smell;
15205      model Odor = T R H / lackfit;
15206      run;

NOTE: The PROCEDURE RSREG printed pages 1117-1118.

15207      ods graphics on;
15208      proc rsreg data=smell
15209      plots(unpack)=surface(3d at(H=7.541050));
15210      model Odor = T R H;
15211      ods select 'T * R = Pred';
15212      run;


