9762       data patients;
9763       call streaminit(419);
9764       do patientid=1 to 100;
9765       gender=mod(patientid,2);
9766       age=30+mod(patientid*7,45);
9767       bmi=20+mod(patientid,12);
9768       drug=rand('bernoulli',0.5);
9769       output;
9770       end;
9771       run;

NOTE: The data set WORK.PATIENTS has 100 observations and 5 variables.

9772       proc psmatch data=patients region=cs;
9773       class drug gender;
9774       psmodel drug(treated='1')=gender age bmi;
9775       match method=greedy(k=1) distance=lps caliper=0.5;
9776       assess lps var=(age bmi);
9777       output out(obs=match)=matched matchid=matchid;
9778       run;

