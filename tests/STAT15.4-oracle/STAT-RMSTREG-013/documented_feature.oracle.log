13723      data survival;
13724      call streaminit(218);
13725      do id=1 to 100;
13726      age=25+mod(id*7,40);
13727      x=mod(id,2);
13728      time=exp(0.5+0.15*x+0.01*age+rand('normal')*0.7);
13729      status=(mod(id,4) ne 0);
13730      output;
13731      end;
13732      run;

NOTE: The data set WORK.SURVIVAL has 100 observations and 5 variables.

13733      proc rmstreg data=survival tau=5;
13734      model time*status(0)=age x / link=linear method=pv;
13735      run;

