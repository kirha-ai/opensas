9391       options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
9391     ! validmemname=compatible locale=en_US;
9392       %let syscc=0;
9393       title; footnote;
9394       ods _all_ close;
9395       ods listing gpath="%sysfunc(pathname(work))";
9396       ods graphics off;
9397       proc datasets library=work kill nolist;
NOTE: Deleting WORK.EPIDEMIC (memtype=DATA).
