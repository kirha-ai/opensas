13409      data survival;
13410      call streaminit(218);
13411      do id=1 to 100;
13412      age=25+mod(id*7,40);
13413      x=mod(id,2);
13414      time=exp(0.5+0.15*x+0.01*age+rand('normal')*0.7);
13415      status=(mod(id,4) ne 0);
13416      output;
13417      end;
13418      run;

NOTE: The data set WORK.SURVIVAL has 100 observations and 5 variables.

13419      proc rmstreg data=survival tau=5;
13420      model time*status(0)=age x / link=linear method=pv;
13421      run;

NOTE: Algorithm converged.
