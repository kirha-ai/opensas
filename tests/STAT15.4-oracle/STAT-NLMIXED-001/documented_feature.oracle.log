NOTE: The data set WORK.NESTED has 1000 observations and 7 variables.

6290       proc nlmixed data = nested;
6291       bounds vara >=0, varb_a >=0;
6292       mean = intercept + aeffect + beffect;
6293       model resp ~ normal (mean, s2);
6294       random aeffect ~ normal(0,vara) subject = A;
6295       random beffect ~ normal(0,varb_a) subject = B(A);
6296       run;

