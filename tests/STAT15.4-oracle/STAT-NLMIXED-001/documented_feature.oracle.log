6274       %let na = 100;
6275       %let nb = 5;
6276       %let nr = 2;
6277       data nested;
6278       do A = 1 to &na;
6279       err1 = 3*rannor(339205);
6280       do B = 1 to &nb;
6281       err2 = 2*rannor(314159);
