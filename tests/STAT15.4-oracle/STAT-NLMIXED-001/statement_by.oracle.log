6318       %let na = 100;
6319       %let nb = 5;
6320       %let nr = 2;
6321       data nested;
6322       do A = 1 to &na;
6323       err1 = 3*rannor(339205);
6324       do B = 1 to &nb;
6325       err2 = 2*rannor(314159);
6326       do rep = 1 to &nr;
6327       err3 = 1*rannor(314159);
6328       resp = 10 + err1 + err2 + err3;
6329       output;
6330       end;
6331       end;
6332       end;
6333       run;

NOTE: The data set WORK.NESTED has 1000 observations and 7 variables.

6334       data _oracle_input; set nested; do _oracle_by=1 to 2; output; end; run;

NOTE: There were 1000 observations read from the data set WORK.NESTED.
NOTE: The data set WORK._ORACLE_INPUT has 2000 observations and 8 variables.

6335       proc sort data=_oracle_input; by _oracle_by; run;

NOTE: There were 2000 observations read from the data set WORK._ORACLE_INPUT.
NOTE: The data set WORK._ORACLE_INPUT has 2000 observations and 8 variables.

6336       proc nlmixed data = _oracle_input;
6337       by _oracle_by;
6338       bounds vara >=0, varb_a >=0;
6339       mean = intercept + aeffect + beffect;
6340       model resp ~ normal (mean, s2);
6341       random aeffect ~ normal(0,vara) subject = A;
6342       random beffect ~ normal(0,varb_a) subject = B(A);
6343       run;

