2652       data SchoolSample;
2653       do SchoolID = 1 to 300;
2654       do nID = 1 to 25;
2655       Neighborhood = (SchoolID-1)*5 + nId;
2656       bInt = 5 *ranuni(1);
2657       bTime = 5 *ranuni(1);
2658       bTime2 = ranuni(1);
2659       do sID = 1 to 2;
2660       do Time = 1 to 4;
2661       Math = bInt + bTime*Time + bTime2*Time*Time + rannor(2);
2662       output;
2663       end;
2664       end;
2665       end;
2666       end;
2667       run;

NOTE: The data set WORK.SCHOOLSAMPLE has 60000 observations and 9 variables.

2668       proc hplmixed data=SchoolSample;
2669       class Neighborhood SchoolID;
2670       model Math = Time Time*Time / solution;
2671       random int Time Time *Time / sub=Neighborhood(SchoolID) type=un;
2672       run;

