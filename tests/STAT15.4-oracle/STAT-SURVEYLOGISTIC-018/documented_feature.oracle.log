21311      data survey;
21312      call streaminit(722);
21313      do stratum=1 to 2;
21314      do cluster=1 to 4;
21315      do id=1 to 12;
21316      age=20+mod(id*7+cluster,45);
21317      event=rand('bernoulli',0.3);
21318      weight=2+stratum+cluster/10;
21319      output;
21320      end;
21321      end;
21322      end;
21323      run;

NOTE: The data set WORK.SURVEY has 96 observations and 6 variables.

21324      proc surveylogistic data=survey;
21325      strata stratum;
21326      cluster cluster;
21327      weight weight;
21328      model event(event='1')=age;
21329      run;

NOTE: PROC SURVEYLOGISTIC is modeling the probability that event=1.
NOTE: Convergence criterion (GCONV=1E-8) satisfied.
