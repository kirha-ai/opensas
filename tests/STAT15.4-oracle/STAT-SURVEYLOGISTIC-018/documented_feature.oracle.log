21302      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
21302    ! validmemname=compatible locale=en_US;
21303      %let syscc=0;
21304      title; footnote;
21305      ods _all_ close;
21306      ods listing gpath="%sysfunc(pathname(work))";
21307      ods graphics off;
21308      proc datasets library=work kill nolist;
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
