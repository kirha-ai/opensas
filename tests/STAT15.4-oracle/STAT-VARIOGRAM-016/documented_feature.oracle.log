31070      proc variogram data=sashelp.thick outv=outv;
31071      store out=SemivStoreGau / label='Thickness Gaussian WLS Fit';
31072      compute lagd=7 maxlag=10;
31073      coordinates xc=East yc=North;
31074      model form=gau cl / covb;
31075      var Thick;
31076      run;

