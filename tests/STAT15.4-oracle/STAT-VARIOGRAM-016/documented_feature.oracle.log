31053      title 'Spatial Correlation Analysis with PROC VARIOGRAM';
31054      ods graphics on;
31055      proc variogram data=sashelp.thick plots=pairs(thr=30);
31056      compute novariogram nhc=20;
31057      coordinates xc=East yc=North;
31058      var Thick;
31059      run;


