21563      ;
21564      proc gee data=Children descending;
21565      class ID City;
21566      model Symptom = City Age Smoke / dist=bin link=logit;
21567      repeated subject=ID / type=exch covb corrw;
21568      run;

NOTE: PROC GEE is modeling the probability that Symptom='1'.
