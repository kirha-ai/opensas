2620       data Bladder;
2621       keep ID TStart TStop Status Trt Number Size Visit;
2622       retain ID TStart 0;
2623       array tt[4] T1-T4;
2624       infile datalines missover;
2625       input Trt Time Number Size T1-T4;
2626       ID + 1;
2627       TStart=0;
2628       do Visit=1 to 4;
2629       if tt[Visit] = . then do;
2630       TStop=Time;
2631       Status=0;
2632       end;
2633       else do;
2634       TStop=tt[Visit];
2635       Status=1;
2636       end;
2637       output;
2638       TStart=TStop;
2639       end;
2640       if (TStart < Time) then delete;
2641       datalines;

NOTE: The data set WORK.BLADDER has 344 observations and 8 variables.

2728       ;
2729       title 'Intensity Model and Proportional Means Model';
2730       proc phreg data=Bladder covm covs(aggregate);
2731       model (TStart, TStop) * Status(0) = Trt Number Size;
2732       id id;
2733       where TStart < TStop;
2734       run;

NOTE: Convergence criterion (GCONV=1E-8) satisfied.
