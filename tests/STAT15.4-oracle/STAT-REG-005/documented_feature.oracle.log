12299      data acetyl;
12300      input x1-x4 @@;
12301      x1x2 = x1 * x2;
12302      x1x1 = x1 * x1;
12303      label x1 = 'reactor temperature(celsius)'
12304      x2 = 'h2 to n-heptone ratio'
12305      x3 = 'contact time(sec)'
12306      x4 = 'conversion percentage'
12307      x1x2= 'temperature-ratio interaction'
12308      x1x1= 'squared temperature';
12309      datalines;

NOTE: SAS went to a new line when INPUT statement reached past the end of a line.
NOTE: The data set WORK.ACETYL has 16 observations and 6 variables.

12316      ;
12317      ods graphics on;
12318      proc reg data=acetyl outvif
12319      outest=b ridge=0 to 0.02 by .002;
12320      model x4=x1 x2 x3 x1x2 x1x1;
12321      run;


NOTE: The data set WORK.B has 23 observations and 13 variables.
