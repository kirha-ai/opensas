9722       data patients;
9723       call streaminit(419);
9724       do patientid=1 to 100;
9725       gender=mod(patientid,2);
9726       age=30+mod(patientid*7,45);
9727       bmi=20+mod(patientid,12);
9728       drug=rand('bernoulli',0.5);
9729       output;
9730       end;
9731       run;

NOTE: The data set WORK.PATIENTS has 100 observations and 5 variables.

9732       proc psmatch data=patients region=cs;
9733       class drug gender;
9734       psmodel drug(treated='1')=gender age bmi;
9735       match method=greedy(k=1) distance=lps caliper=0.5;
9736       assess lps var=(age bmi);
9737       output out(obs=match)=matched matchid=matchid;
9738       run;

