23653      data survey;
23654      call streaminit(722);
23655      do stratum=1 to 2;
23656      do cluster=1 to 4;
23657      do id=1 to 12;
23658      age=20+mod(id*7+cluster,45);
23659      time=1+rand('exponential')*10;
23660      status=(mod(id,4) ne 0);
23661      weight=2+stratum+cluster/10;
23662      output;
23663      end;
23664      end;
23665      end;
23666      run;

NOTE: The data set WORK.SURVEY has 96 observations and 7 variables.

23667      proc surveyphreg data=survey;
23668      strata stratum;
23669      cluster cluster;
23670      weight weight;
23671      model time*status(0)=age;
23672      run;

