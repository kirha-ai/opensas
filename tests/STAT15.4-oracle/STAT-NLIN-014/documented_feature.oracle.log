6126       options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
6126     ! validmemname=compatible locale=en_US;
6127       %let syscc=0;
6128       title; footnote;
6129       ods _all_ close;
6130       ods listing gpath="%sysfunc(pathname(work))";
6131       ods graphics off;
6132       proc datasets library=work kill nolist;
NOTE: Deleting WORK.CONTRIVED (memtype=DATA).
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK.SASGOPT (memtype=CATALOG).
NOTE: File WORK.SASGOPT (memtype=CATALOG) cannot be deleted because it is in use.
NOTE: Deleting WORK.SASMAC1 (memtype=CATALOG).
NOTE: File WORK.SASMAC1 (memtype=CATALOG) cannot be deleted because it is in use.
NOTE: Deleting WORK.SASMAC2 (memtype=CATALOG).
6132     !                                         quit;


6133       ods path work.templat(update) sashelp.tmplmst(read);
6134       
6135       ods graphics on;
6136       ods trace on;
6137       ods trace on;
6138       data contrived;
6139       input x1 x2 y;
6140       datalines;

NOTE: The data set WORK.CONTRIVED has 13 observations and 3 variables.

6154       ;
6155       ods graphics on;
6156       proc nlin data=contrived bias hougaard
6157       NLINMEASURES plots(stats=all)=(diagnostics);
6158       parms alpha=2.0
6159       gamma=0.0;
6160       model y = alpha*x1 + exp(gamma*x2);
6161       run;

NOTE: DER.alpha not initialized or missing. It will be computed automatically.
NOTE: DER.gamma not initialized or missing. It will be computed automatically.

