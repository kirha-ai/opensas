23361      data diallel;
23362      label time = 'Flowering time in days';
23363      do p = 1 to 8;
23364      do m = 1 to 8;
23365      if (m ne p) then do;
23366      sym = trim(left(min(m,p))) || ',' || trim(left(max(m,p)));
23367      do block = 1 to 2;
23368      input time @@;
23369      output;
23370      end;
23371      end;
23372      end;
23373      end;
23374      datalines;

