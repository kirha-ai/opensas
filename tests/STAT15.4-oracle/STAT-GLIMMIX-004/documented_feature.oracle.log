23383      ;
23384      proc glimmix data=diallel outdesign(z)=zmat;
23385      class block sym p m;
23386      effect line = mm(p m);
23387      model time = block;
23388      random line sym p m p*m;
23389      run;

NOTE: When neither METHOD=QUADRATURE nor METHOD=LAPLACE is specified, the default degrees-of-freedom method in models with random effects and constructed 
      effects is DDFM=KENWARDROGER. Without constructed effects this model would have DDFM=CONTAIN as the default.


