2941       data SchoolSample;
2942       do SchoolID = 1 to 300;
2943       do nID = 1 to 25;
2944       Neighborhood = (SchoolID-1)*5 + nId;
2945       bInt = 5 *ranuni(1);
2946       bTime = 5 *ranuni(1);
2947       bTime2 = ranuni(1);
2948       do sID = 1 to 2;
2949       do Time = 1 to 4;
2950       Math = bInt + bTime*Time + bTime2*Time*Time + rannor(2);
2951       output;
2952       end;
2953       end;
2954       end;
2955       end;
2956       run;

NOTE: The data set WORK.SCHOOLSAMPLE has 60000 observations and 9 variables.

2957       proc hplmixed data=SchoolSample;
2958       class Neighborhood SchoolID;
2959       model Math = Time Time*Time / solution;
2960       random int Time Time *Time / sub=Neighborhood(SchoolID) type=un;
2961       run;

