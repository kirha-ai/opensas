1153       data sample;
1154       call streaminit(314159);
1155       do id=1 to 90;
1156        x=rand('normal'); z=rand('normal'); w=rand('normal');
1157        group=1+mod(id,3); block=1+mod(id,5);
1158        y=5+1.5*x-0.6*z+0.4*group+rand('normal');
1159        y2=2+0.5*x+0.8*z+rand('normal'); output;
1160       end;
1161       run;

NOTE: The data set WORK.SAMPLE has 90 observations and 8 variables.

1162       proc hpprincomp data=sample; var x y y2; partial z; output out=scores; performance nthreads=1; run;

