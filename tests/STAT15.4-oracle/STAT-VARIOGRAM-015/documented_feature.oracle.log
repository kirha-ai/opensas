31000      ods trace on;
31001      title 'Spatial Correlation Analysis with PROC VARIOGRAM';
31002      ods graphics on;
31003      proc variogram data=sashelp.thick plots=pairs(thr=30);
31004      compute novariogram nhc=20;
31005      coordinates xc=East yc=North;
31006      var Thick;
31007      run;


