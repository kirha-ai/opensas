23276      data survey;
23277      call streaminit(722);
23278      do stratum=1 to 2;
23279      do cluster=1 to 4;
23280      do id=1 to 12;
23281      age=20+mod(id*7+cluster,45);
23282      time=1+rand('exponential')*10;
23283      status=(mod(id,4) ne 0);
23284      weight=2+stratum+cluster/10;
23285      output;
23286      end;
23287      end;
23288      end;
23289      run;

NOTE: The data set WORK.SURVEY has 96 observations and 7 variables.

23290      proc surveyphreg data=survey;
23291      strata stratum;
23292      cluster cluster;
23293      weight weight;
23294      model time*status(0)=age;
