4751       %let nObs = 5000;
4752       %let nVars = 100;
4753       data SimuData;
4754       array x{&nVars};
4755       do obsNum=1 to &nObs;
4756       do j=1 to &nVars;
4757       x{j}=ranuni(1);
4758       end;
4759       linp = 10 + 11 *x1 - 10*sqrt(x2) + 2/x3 - 8*exp(x4) + 7*x5*x5
4760       - 6*x6**1.5 + 5*log(x7) - 4*sin(3.14*x8) + 3*x9 - 2*x10;
4761       TrueProb = 1/(1+exp(-linp));
4762       if ranuni(1) < TrueProb then y=1;
4763       else y=0;
4764       output;
4765       end;
4766       run;

NOTE: The data set WORK.SIMUDATA has 5000 observations and 105 variables.

4767       proc logistic data=SimuData;
4768       effect splines = spline(x1-x&nVars/separate);
4769       model y = splines/selection=stepwise;
4770       store work.SimuModel;
4771       run;

