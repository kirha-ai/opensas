4965       options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
4965     ! validmemname=compatible locale=en_US;
4966       %let syscc=0;
4967       title; footnote;
4968       ods _all_ close;
4969       ods listing gpath="%sysfunc(pathname(work))";
4970       ods graphics off;
4971       proc datasets library=work kill nolist;
NOTE: Deleting WORK.BLOCKANALYSIS (memtype=ITEMSTOR).
NOTE: Deleting WORK.BLOCKDESIGN (memtype=DATA).
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
