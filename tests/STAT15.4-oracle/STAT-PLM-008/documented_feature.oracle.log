4971     !                                         quit;


4972       ods path work.templat(update) sashelp.tmplmst(read);
4973       
4974       %let nObs = 5000;
4975       %let nVars = 100;
4976       data SimuData;
4977       array x{&nVars};
4978       do obsNum=1 to &nObs;
4979       do j=1 to &nVars;
4980       x{j}=ranuni(1);
4981       end;
4982       linp = 10 + 11 *x1 - 10*sqrt(x2) + 2/x3 - 8*exp(x4) + 7*x5*x5
4983       - 6*x6**1.5 + 5*log(x7) - 4*sin(3.14*x8) + 3*x9 - 2*x10;
4984       TrueProb = 1/(1+exp(-linp));
4985       if ranuni(1) < TrueProb then y=1;
4986       else y=0;
4987       output;
4988       end;
4989       run;

NOTE: The data set WORK.SIMUDATA has 5000 observations and 105 variables.

4990       proc logistic data=SimuData;
4991       effect splines = spline(x1-x&nVars/separate);
4992       model y = splines/selection=stepwise;
4993       store work.SimuModel;
4994       run;

