23522      data survey;
23523      call streaminit(722);
23524      do stratum=1 to 2;
23525      do cluster=1 to 4;
23526      do id=1 to 12;
23527      age=20+mod(id*7+cluster,45);
23528      time=1+rand('exponential')*10;
23529      status=(mod(id,4) ne 0);
23530      weight=2+stratum+cluster/10;
23531      output;
23532      end;
23533      end;
23534      end;
23535      run;

NOTE: The data set WORK.SURVEY has 96 observations and 7 variables.

23536      proc surveyphreg data=survey;
23537      strata stratum;
23538      cluster cluster;
23539      weight weight;
23540      model time*status(0)=age;
23541      run;

