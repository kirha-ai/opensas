13735      proc causaltrt data=drugs method=ipwr ppsmodel;
13736      class Gender;
13737      psmodel Drug(ref='Drug_A') = Age Gender BMI;
13738      model Diabetes2(ref='No') / dist = bin;
13739      run;

NOTE: PROC CAUSALTRT is modeling the probability that Diabetes2='Yes'.
NOTE: PROC CAUSALTRT is modeling the probability that Drug='Drug_B'.
