14308      title 'Cluster Analysis of Flying Mileages Between 10 American Cities';
14309      ods graphics on;
14310      title2 'Using METHOD=AVERAGE';
14311      proc cluster data=sashelp.mileages(type=distance) method=average pseudo;
14312      id City;
14313      run;

