30014    !                                         quit;


30015      ods path work.templat(update) sashelp.tmplmst(read);
30016      
30017      title 'Spatial Correlation Analysis with PROC VARIOGRAM';
30018      ods graphics on;
30019      proc variogram data=sashelp.thick plots=pairs(thr=30);
30020      compute novariogram nhc=20;
30021      coordinates xc=East yc=North;
30022      var Thick;
30023      run;

NOTE: The PROCEDURE VARIOGRAM printed page 1815.

30024      proc variogram data=sashelp.thick outv=outv;
30025      compute lagd=7 maxlag=10 cl robust;
30026      coordinates xc=East yc=North;
30027      var Thick;
30028      run;

NOTE: No DIRECTIONS statement and no NDIRECTIONS=, or NDIRECTIONS=0 specified: Computing omnidirectional semivariogram.
NOTE: The data set WORK.OUTV has 12 observations and 9 variables.
NOTE: The PROCEDURE VARIOGRAM printed pages 1816-1817.

30029      proc variogram data=sashelp.thick outv=outv plots(only)=moran;
30030      compute lagd=7 maxlag=10 autocorr(assum=random);
30031      coordinates xc=East yc=North;
30032      var Thick;
30033      run;

NOTE: No DIRECTIONS statement and no NDIRECTIONS=, or NDIRECTIONS=0 specified: Computing omnidirectional semivariogram.
NOTE: The autocorrelation statistics exclude 33 observation(s) that have no neighbors within the specified LAGDISTANCE= distance.
NOTE: The Moran scatter plot excludes 33 observation(s) because they have no neighbors within the specified LAGDISTANCE= distance.
NOTE: The data set WORK.OUTV has 12 observations and 8 variables.
NOTE: The PROCEDURE VARIOGRAM printed pages 1818-1819.

30034      proc variogram data=sashelp.thick outv=outv;
30035      store out=SemivStoreGau / label='Thickness Gaussian WLS Fit';
30036      compute lagd=7 maxlag=10;
30037      coordinates xc=East yc=North;
30038      model form=gau cl / covb;
30039      var Thick;
30040      run;

NOTE: No DIRECTIONS statement and no NDIRECTIONS=, or NDIRECTIONS=0 specified: Computing omnidirectional semivariogram.
NOTE: Convergence criterion (GCONV=1E-8) satisfied.
NOTE: The data set WORK.OUTV has 12 observations and 8 variables.
NOTE: The PROCEDURE VARIOGRAM printed pages 1820-1823.

30041      ods graphics off;
30042      run;
30043      quit;
