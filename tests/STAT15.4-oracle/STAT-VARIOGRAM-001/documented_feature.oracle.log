30008      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
30008    ! validmemname=compatible locale=en_US;
30009      %let syscc=0;
30010      title; footnote;
30011      ods _all_ close;
30012      ods listing gpath="%sysfunc(pathname(work))";
30013      ods graphics off;
30014      proc datasets library=work kill nolist;
NOTE: Deleting WORK.A (memtype=DATA).
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
