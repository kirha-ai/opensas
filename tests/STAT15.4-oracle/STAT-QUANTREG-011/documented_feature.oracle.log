2761       proc format;
2762       value vfmt 0 = 'No Visit' 1 = 'Second Trimester'
2763       2 = 'Last Trimester' 3 = 'First Trimester';
NOTE: Format VFMT has been output.
2764       value efmt 0 = 'High School' 1 = 'Some College'
2765       2 = 'College' 3 = 'Less Than High School';
NOTE: Format EFMT has been output.
2766       run;


2767       ods graphics on;
2768       proc quantreg ci=sparsity/iid algorithm=interior(tolerance=5.e-4)
2769       data=sashelp.bweight order=internal;
2770       class Visit MomEdLevel;
2771       model Weight = Black Married Boy Visit MomEdLevel MomSmoke
2772       CigsPerDay MomAge MomAge*MomAge
2773       MomWtGain MomWtGain*MomWtGain /
2774       quantile= 0.05 to 0.95 by 0.05
2775       plot=quantplot seed=314159;
2776       format Visit vfmt. MomEdLevel efmt.;
2777       run;


