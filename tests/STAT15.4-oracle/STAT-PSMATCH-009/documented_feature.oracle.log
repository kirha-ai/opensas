9922       data patients;
9923       call streaminit(419);
9924       do patientid=1 to 100;
9925       gender=mod(patientid,2);
9926       age=30+mod(patientid*7,45);
9927       bmi=20+mod(patientid,12);
9928       drug=rand('bernoulli',0.5);
9929       output;
9930       end;
9931       run;

NOTE: The data set WORK.PATIENTS has 100 observations and 5 variables.

9932       proc psmatch data=patients region=cs;
9933       class drug gender;
9934       psmodel drug(treated='1')=gender age bmi;
9935       match method=greedy(k=1) distance=lps caliper=0.5;
9936       assess lps var=(age bmi);
9937       output out(obs=match)=matched matchid=matchid;
9938       run;

