18039      ods path work.templat(update) sashelp.tmplmst(read);
18040      
18041      data Color;
18042      input Region Eyes $ Hair $ Count @@;
18043      label Eyes ='Eye Color'
18044      Hair ='Hair Color'
18045      Region='Geographic Region';
18046      datalines;

NOTE: SAS went to a new line when INPUT statement reached past the end of a line.
NOTE: The data set WORK.COLOR has 27 observations and 4 variables.

18056      ;
18057      run;
18058      proc freq data=Color order=freq;
18059      tables Eyes / binomial(ac wilson exact) alpha=.1;
18060      tables Hair / binomial(equiv p=.28 margin=.1);
18061      weight Count;
18062      title 'Hair and Eye Color of European Children';
18063      run;

