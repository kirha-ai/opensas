18032      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
18032    ! validmemname=compatible locale=en_US;
18033      %let syscc=0;
18034      title; footnote;
18035      ods _all_ close;
18036      ods listing gpath="%sysfunc(pathname(work))";
18037      ods graphics off;
18038      proc datasets library=work kill nolist;
