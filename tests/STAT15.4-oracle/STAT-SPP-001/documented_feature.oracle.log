17512      /* STAT-SPP-001: SPP — Data input, variable roles, and basic options
17513       * Source: S154 / Chapter 114 / `PROC SPP Statement` (PDF pp. 9391–9398); S154 / Chapter 114 / `BY Statement` (PDF p. 9398).
17514       * Discriminates: Verified default procedure context
17515       */
17516      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
17516    ! validmemname=compatible locale=en_US;
17517      %let syscc=0;
17518      title; footnote;
17519      ods _all_ close;
17520      ods listing gpath="%sysfunc(pathname(work))";
17521      ods graphics off;
17522      proc datasets library=work kill nolist;
NOTE: Deleting WORK.DRAWS (memtype=DATA).
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK.SASGOPT (memtype=CATALOG).
NOTE: File WORK.SASGOPT (memtype=CATALOG) cannot be deleted because it is in use.
NOTE: Deleting WORK.SCOV (memtype=DATA).
NOTE: Deleting WORK.TEMPLAT (memtype=ITEMSTOR).
NOTE: File WORK.TEMPLAT (memtype=ITEMSTOR) cannot be deleted because it is in use.
17522    !                                         quit;


17523      ods path work.templat(update) sashelp.tmplmst(read);
17524      
17525      ods graphics on;
17526      proc spp data=sashelp.bei plots(equate)=(trends observations);
17527      process trees = (x, y /area=(0,0,1000,500) Event=Trees);
17528      trend grad = field(x,y, gradient);
17529      trend elev = field(x,y, elevation);
17530      run;

NOTE: The PROCEDURE SPP printed page 1205.

17531      proc spp data=sashelp.bei plots(equate)=(residual intensity);
17532      process trees = (x,y /area=(0,0,1000,500) event=Trees);
17533      trend elev = field(x,y,elevation);
17534      trend grad = field(x,y,gradient);
17535      model trees = elev grad / grid(64,64) residual(B=70) ;
17536      run;

NOTE: Convergence criterion (Absolute gradient, ABSGCONV=0.00001) satisfied.
NOTE: The PROCEDURE SPP printed page 1206.

