3540       proc sim2d data=thick outsim=sim plot=(observ sim);
3541       coordinates xc=East yc=North;
3542       simulate var=Thick numreal=100 seed=79931
3543       scale=7.4599 range=30.1111 nugget=1e-8 form=gauss;
3544       mean 40.1173;
3545       grid x=0 to 100 by 25 y=0 to 100 by 25;
3546       run;

