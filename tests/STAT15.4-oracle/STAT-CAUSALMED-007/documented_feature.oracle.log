13457      proc causalmed data=sashelp.birthwgt decomp;
13458      class LowBirthWgt Smoking Death AgeGroup Married Race
13459      Drinking SomeCollege /descending;
13460      mediator LowBirthWgt = Smoking;
13461      model Death = LowBirthWgt | Smoking;
13462      covar AgeGroup Married Race Drinking SomeCollege;
13463      evaluate 'Low Birth-Weight' LowBirthWgt='Yes' / nodecomp;
13464      evaluate 'Normal Birth-Weight' LowBirthWgt='No' / nodecomp;
13465      run;

NOTE: PROC CAUSALMED is modeling the probability that Death='Yes' in the outcome model.
NOTE: PROC CAUSALMED is modeling the probability that LowBirthWgt='Yes' in the mediator model.
