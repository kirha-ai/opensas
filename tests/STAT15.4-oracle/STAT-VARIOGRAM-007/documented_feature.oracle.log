30400      ods path work.templat(update) sashelp.tmplmst(read);
30401      
30402      title 'Spatial Correlation Analysis with PROC VARIOGRAM';
30403      ods graphics on;
30404      proc variogram data=sashelp.thick plots=pairs(thr=30);
30405      compute novariogram nhc=20;
30406      coordinates xc=East yc=North;
30407      var Thick;
30408      run;

NOTE: The PROCEDURE VARIOGRAM printed page 1876.

30409      proc variogram data=sashelp.thick outv=outv;
30410      compute lagd=7 maxlag=10 cl robust;
30411      coordinates xc=East yc=North;
30412      var Thick;
30413      run;

NOTE: No DIRECTIONS statement and no NDIRECTIONS=, or NDIRECTIONS=0 specified: Computing omnidirectional semivariogram.
NOTE: The data set WORK.OUTV has 12 observations and 9 variables.
NOTE: The PROCEDURE VARIOGRAM printed pages 1877-1878.

30414      proc variogram data=sashelp.thick outv=outv plots(only)=moran;
30415      compute lagd=7 maxlag=10 autocorr(assum=random);
30416      coordinates xc=East yc=North;
30417      var Thick;
30418      run;

NOTE: No DIRECTIONS statement and no NDIRECTIONS=, or NDIRECTIONS=0 specified: Computing omnidirectional semivariogram.
