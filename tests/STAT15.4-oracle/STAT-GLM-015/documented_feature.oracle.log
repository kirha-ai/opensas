26089      /*----------------------------------clrn-cltn-knox-onel-cpst-wbsh-wstr */
26090      contrast 'Compost vs. others' Type -1 -1 -1 -1 6 -1 -1;
26091      contrast 'River soils vs. non' Type -1 -1 -1 -1 0 5 -1,
26092      Type -1 4 -1 -1 0 0 -1;
