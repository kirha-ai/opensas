6762       proc hpsplit data=sashelp.baseball seed=123;
6763       class league division;
6764       model logSalary = nAtBat nHits nHome nRuns nRBI nBB
6765       yrMajor crAtBat crHits crHome crRuns crRbi
6766       crBB league division nOuts nAssts nError;
6767       output out=hpsplout;
6768       run;

