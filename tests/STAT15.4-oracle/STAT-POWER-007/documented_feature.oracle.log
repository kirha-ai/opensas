6667        */
6668       options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
6668     ! validmemname=compatible locale=en_US;
6669       %let syscc=0;
6670       title; footnote;
6671       ods _all_ close;
6672       ods listing gpath="%sysfunc(pathname(work))";
6673       ods graphics off;
6674       proc datasets library=work kill nolist;
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
