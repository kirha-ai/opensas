28384      ods graphics on;
28385      title 'Gasoline Example';
28386      title2 'Iteratively Estimate NOx, CpRatio, EqRatio, and Fuel';
28387      * Fit the Nonparametric Model;
28388      proc transreg data=sashelp.Gas solve test nomiss plots=all;
28389      ods exclude where=(_path_ ? 'MV');
28390      model mspline(NOx / nknots=9) = spline(EqRatio / nknots=9)
28391      monotone(CpRatio) opscore(Fuel);
28392      run;

