28393      title2 'Now fit log(NOx) = b0 + b1*EqRatio + b2*EqRatio**2 +';
28394      title3 'b3*CpRatio + Sum b(j)*Fuel(j) + Error';
28395      *-Fit the Parametric Model Suggested by the Nonparametric Analysis-;
28396      proc transreg data=sashelp.Gas solve ss2 short nomiss plots=all;
28397      model log(NOx) = pspline(EqRatio / deg=2) identity(CpRatio)
28398      opscore(Fuel);
28399      run;

