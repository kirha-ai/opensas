17983      proc spp data=sashelp.bei plots(equate)=(residual intensity);
17984      process trees = (x,y /area=(0,0,1000,500) event=Trees);
17985      trend elev = field(x,y,elevation);
17986      trend grad = field(x,y,gradient);
17987      model trees = elev grad / grid(64,64) residual(B=70) ;
17988      run;


