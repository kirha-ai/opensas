680        class c1;
681        model y=c1 x1;
682        run;

NOTE: The PROCEDURE ADAPTIVEREG printed page 27.

683        data New;
684        set Mixture;
685        basis1 = (c1=1 OR c1=0);
686        basis3 = (c1=1);
687        basis5 = NOT(c1=1) *MAX(x1-0.7665019053,0);
688        basis7 = NOT(c1=1 OR c1=0) *MAX(x1-0.7665019053,0);
689        basis8 = NOT(c1=1 OR c1=0) *MAX(0.7665019053-x1,0);
690        basis9 = (c1=1) *MAX(x1-0.5530566455,0);
691        basis10 = (c1=1)*MAX(0.5530566455-x1,0);
692        basis11 = (c1=1)*MAX(x1-0.045800759,0);
693        basis13 = (c1=1)*MAX(x1-0.9526330293,0);
694        basis15 = (c1=1 OR c1=0)*MAX(x1-0.9499325226,0);
695        basis17 = (c1=1 OR c1=0)*MAX(x1-0.5142821095,0);
696        basis19 = (c1=1 OR c1=0)*MAX(x1-0.9889635476,0);
697        pred = 5.3829 - 4.3871 *basis1 + 32.7761*basis3 +
698        20.2859*basis5 - 11.4183*basis7 - 7.0758*basis8 +
699        58.4911*basis9 - 71.6388*basis10 - 69.0764*basis11 -
700        119.71*basis13 + 66.5733*basis15 + 6.6681*basis17 -
