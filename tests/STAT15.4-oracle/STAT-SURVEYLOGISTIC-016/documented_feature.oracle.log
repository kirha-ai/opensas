21231      data survey;
21232      call streaminit(722);
21233      do stratum=1 to 2;
21234      do cluster=1 to 4;
21235      do id=1 to 12;
21236      age=20+mod(id*7+cluster,45);
21237      event=rand('bernoulli',0.3);
21238      weight=2+stratum+cluster/10;
21239      output;
21240      end;
21241      end;
21242      end;
21243      run;

NOTE: The data set WORK.SURVEY has 96 observations and 6 variables.

21244      proc surveylogistic data=survey;
21245      strata stratum;
21246      cluster cluster;
21247      weight weight;
21248      model event(event='1')=age;
21249      run;

NOTE: PROC SURVEYLOGISTIC is modeling the probability that event=1.
NOTE: Convergence criterion (GCONV=1E-8) satisfied.
