13484    !                                         quit;


13485      ods path work.templat(update) sashelp.tmplmst(read);
13486      
13487      ods trace on;
13488      
13489      
13490      proc causalmed data=sashelp.birthwgt decomp;
13491      class LowBirthWgt Smoking Death AgeGroup Married Race
13492      Drinking SomeCollege /descending;
13493      mediator LowBirthWgt = Smoking;
13494      model Death = LowBirthWgt | Smoking;
13495      covar AgeGroup Married Race Drinking SomeCollege;
13496      evaluate 'Low Birth-Weight' LowBirthWgt='Yes' / nodecomp;
13497      evaluate 'Normal Birth-Weight' LowBirthWgt='No' / nodecomp;
13498      run;


