23071      data survey;
23072      call streaminit(722);
23073      do stratum=1 to 2;
23074      do cluster=1 to 4;
23075      do id=1 to 12;
23076      age=20+mod(id*7+cluster,45);
23077      time=1+rand('exponential')*10;
23078      status=(mod(id,4) ne 0);
23079      weight=2+stratum+cluster/10;
23080      output;
23081      end;
23082      end;
23083      end;
23084      run;

NOTE: The data set WORK.SURVEY has 96 observations and 7 variables.

23085      proc surveyphreg data=survey;
23086      strata stratum;
23087      cluster cluster;
23088      weight weight;
23089      model time*status(0)=age;
23090      run;

