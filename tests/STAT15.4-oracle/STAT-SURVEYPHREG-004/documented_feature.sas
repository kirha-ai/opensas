/* STAT-SURVEYPHREG-004: SURVEYPHREG — DOMAIN / Notation and Estimation / Failure Time Distribution
 * Source: S154 / Chapter 122 / `DOMAIN Statement` (PDF pp. 10022–10023); S154 / Chapter 122 / `Notation and Estimation` (PDF pp. 10042–10043); S154 / Chapter 122 / `Failure Time Distribution` (PDF pp. 10043–10044).
 * Discriminates: Verified default procedure context
 */
options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7 validmemname=compatible locale=en_US;
%let syscc=0;
title; footnote;
ods _all_ close;
ods listing gpath="%sysfunc(pathname(work))";
ods graphics off;
proc datasets library=work kill nolist; quit;
ods path work.templat(update) sashelp.tmplmst(read);

data survey;
call streaminit(722);
do stratum=1 to 2;
do cluster=1 to 4;
do id=1 to 12;
age=20+mod(id*7+cluster,45);
time=1+rand('exponential')*10;
status=(mod(id,4) ne 0);
weight=2+stratum+cluster/10;
output;
end;
end;
end;
run;
proc surveyphreg data=survey;
strata stratum;
cluster cluster;
weight weight;
model time*status(0)=age;
run;
