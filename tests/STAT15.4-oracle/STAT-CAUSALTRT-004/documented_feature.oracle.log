13636      proc causaltrt data=drugs method=ipwr ppsmodel;
13637      class Gender;
13638      psmodel Drug(ref='Drug_A') = Age Gender BMI;
13639      model Diabetes2(ref='No') / dist = bin;
13640      run;

NOTE: PROC CAUSALTRT is modeling the probability that Diabetes2='Yes'.
NOTE: PROC CAUSALTRT is modeling the probability that Drug='Drug_B'.
