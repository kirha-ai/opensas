10223      data survival;
10224      call streaminit(518);
10225      do id=1 to 80;
10226      drug=mod(id,2);
10227      age=25+mod(id*7,40);
10228      time=exp(2+0.25*drug+0.008*age+rand('normal')*0.4);
10229      status=(mod(id,5) ne 0);
10230      output;
10231      end;
10232      run;

NOTE: The data set WORK.SURVIVAL has 80 observations and 5 variables.

10233      proc quantlife data=survival seed=1268;
10234      class drug;
10235      model time*status(0)=drug age / quantile=0.5;
10236      run;

