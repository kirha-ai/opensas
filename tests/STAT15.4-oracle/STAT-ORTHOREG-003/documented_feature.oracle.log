1173       title 'Polynomial Data';
1174       data Polynomial;
1175       do i = 1 to 101;
1176       x = (i-1)/(101-1);
1177       y = 10**(9/2);
1178       do j = 0 to 8;
1179       y = y * (x - j/8);
1180       end;
1181       output;
1182       end;
1183       run;

NOTE: The data set WORK.POLYNOMIAL has 101 observations and 4 variables.

1184       ods graphics on;
1185       proc orthoreg data=Polynomial;
1186       effect xMod = polynomial(x / degree=9);
1187       model y = xMod;
1188       effectplot fit / obs;
1189       store OStore;
1190       run;

