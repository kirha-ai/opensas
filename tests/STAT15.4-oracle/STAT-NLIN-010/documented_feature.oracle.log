5962       ;
5963       proc nlin data=Enzyme method=marquardt hougaard;
5964       parms theta1=155
5965       theta2=0 to 0.07 by 0.01;
5966       model Velocity = theta1*Concentration / (theta2 + Concentration);
5967       run;

