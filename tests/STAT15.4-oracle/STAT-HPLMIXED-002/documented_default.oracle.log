2694       data SchoolSample;
2695       do SchoolID = 1 to 300;
2696       do nID = 1 to 25;
2697       Neighborhood = (SchoolID-1)*5 + nId;
2698       bInt = 5 *ranuni(1);
2699       bTime = 5 *ranuni(1);
2700       bTime2 = ranuni(1);
2701       do sID = 1 to 2;
2702       do Time = 1 to 4;
2703       Math = bInt + bTime*Time + bTime2*Time*Time + rannor(2);
2704       output;
2705       end;
2706       end;
2707       end;
2708       end;
2709       run;

NOTE: The data set WORK.SCHOOLSAMPLE has 60000 observations and 9 variables.

2710       proc hplmixed data=SchoolSample;
2711       class Neighborhood SchoolID;
2712       model Math = Time Time*Time / solution;
2713       random int Time Time *Time / sub=Neighborhood(SchoolID) type=un;
2714       run;

NOTE: The HPLMIXED procedure is executing in single-machine mode.
