NOTE: The data set WORK.FERRITECORES has 20 observations and 2 variables.

25256      ;
25257      proc glimmix data=FerriteCores;
25258      class Temp;
25259      model MagneticForce = Temp;
25260      lsmestimate Temp
25261      'avg(1:1)<avg(2:4)' -3 1 1 1 divisor=3,
25262      'avg(1:2)<avg(3:4)' -1 -1 1 1 divisor=2,
25263      'avg(1:3)<avg(4:4)' -1 -1 -1 3 divisor=3
25264      / adjust=simulate(seed=1) cl upper;
25265      ods select LSMestimates;
25266      run;




