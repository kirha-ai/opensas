23153      data survey;
23154      call streaminit(722);
23155      do stratum=1 to 2;
23156      do cluster=1 to 4;
23157      do id=1 to 12;
23158      age=20+mod(id*7+cluster,45);
23159      time=1+rand('exponential')*10;
23160      status=(mod(id,4) ne 0);
23161      weight=2+stratum+cluster/10;
23162      output;
23163      end;
23164      end;
23165      end;
23166      run;

NOTE: The data set WORK.SURVEY has 96 observations and 7 variables.

23167      proc surveyphreg data=survey;
23168      strata stratum;
23169      cluster cluster;
23170      weight weight;
23171      model time*status(0)=age;
23172      run;

