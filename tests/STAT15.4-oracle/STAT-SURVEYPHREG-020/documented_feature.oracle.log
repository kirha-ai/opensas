23603    !                                         quit;


23604      ods path work.templat(update) sashelp.tmplmst(read);
23605      
23606      ods graphics on;
23607      ods trace on;
23608      ods trace on;
23609      data survey;
23610      call streaminit(722);
23611      do stratum=1 to 2;
23612      do cluster=1 to 4;
23613      do id=1 to 12;
23614      age=20+mod(id*7+cluster,45);
23615      time=1+rand('exponential')*10;
23616      status=(mod(id,4) ne 0);
23617      weight=2+stratum+cluster/10;
23618      output;
23619      end;
23620      end;
23621      end;
23622      run;

NOTE: The data set WORK.SURVEY has 96 observations and 7 variables.

23623      proc surveyphreg data=survey;
23624      strata stratum;
23625      cluster cluster;
23626      weight weight;
23627      model time*status(0)=age;
23628      run;


