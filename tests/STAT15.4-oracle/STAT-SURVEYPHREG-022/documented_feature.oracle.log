23694      data survey;
23695      call streaminit(722);
23696      do stratum=1 to 2;
23697      do cluster=1 to 4;
23698      do id=1 to 12;
23699      age=20+mod(id*7+cluster,45);
23700      time=1+rand('exponential')*10;
23701      status=(mod(id,4) ne 0);
23702      weight=2+stratum+cluster/10;
23703      output;
23704      end;
23705      end;
23706      end;
23707      run;

NOTE: The data set WORK.SURVEY has 96 observations and 7 variables.

23708      proc surveyphreg data=survey;
