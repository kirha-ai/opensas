9551     !                                         quit;


9552       ods path work.templat(update) sashelp.tmplmst(read);
9553       
9554       data bivnormal;
9555       seed = 1283470;
9556       do i = 1 to 1000;
9557       z1 = rannor(seed);
9558       z2 = rannor(seed);
9559       z3 = rannor(seed);
9560       x = 3*z1+z2;
9561       y = 3*z1+z3;
9562       output;
9563       end;
9564       drop seed;
9565       run;

NOTE: The data set WORK.BIVNORMAL has 1000 observations and 6 variables.

9566       ods graphics on;
9567       proc kde data=bivnormal;
9568       univar x / plots=(density histogram histdensity);
9569       univar x y / plots=densityoverlay;
9570       run;

