21022      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
21022    ! validmemname=compatible locale=en_US;
21023      %let syscc=0;
21024      title; footnote;
21025      ods _all_ close;
21026      ods listing gpath="%sysfunc(pathname(work))";
21027      ods graphics off;
21028      proc datasets library=work kill nolist;
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
