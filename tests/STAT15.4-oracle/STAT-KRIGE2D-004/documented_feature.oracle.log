10061      ;
10062      ods graphics on;
10063      proc krige2d data=thick;
10064      coordinates xc=East yc=North;
10065      predict var=Thick radius=60;
10066      model scale=7.4599 range=30.1111 form=gauss;
10067      grid x=0 to 100 by 2.5 y=0 to 100 by 2.5;
10068      run;

