12865      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
12865    ! validmemname=compatible locale=en_US;
12866      %let syscc=0;
12867      title; footnote;
12868      ods _all_ close;
12869      ods listing gpath="%sysfunc(pathname(work))";
12870      ods graphics off;
12871      proc datasets library=work kill nolist;
NOTE: Deleting WORK.BMT2 (memtype=DATA).
NOTE: Deleting WORK.FORMATS (memtype=CATALOG).
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
