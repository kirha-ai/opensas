1738       data bballm;
1739       input School :$13. CSN DurhamSun DurhamHerald WashingtonPost
1740       USA_Today SportMagazine InsideSports UPI AP SportsIllustrated;
1741       label CSN = 'Community Sports News (Chapel Hill, NC)'
1742       DurhamSun = 'Durham Sun'
1743       DurhamHerald = 'Durham Morning Herald'
1744       WashingtonPost = 'Washington Post'
1745       USA_Today = 'USA Today'
1746       SportMagazine = 'Sport Magazine'
1747       InsideSports = 'Inside Sports'
1748       UPI = 'United Press International'
1749       AP = 'Associated Press'
1750       SportsIllustrated = 'Sports Illustrated'
1751       ;
1752       format CSN--SportsIllustrated 5.1;
1753       datalines;

NOTE: The data set WORK.BBALLM has 35 observations and 11 variables.

1789       ;
1790       * Find maximum rank for each news service and replace
1791       * each missing value with the next highest rank.;
1792       proc means data=bballm noprint;
1793       output out=maxrank
1794       max=mcsn mdurs mdurh mwas musa mspom mins mupi map mspoi;
1795       run;

NOTE: There were 35 observations read from the data set WORK.BBALLM.
NOTE: The data set WORK.MAXRANK has 1 observations and 12 variables.

1796       data bball;
1797       set bballm;
1798       if _n_=1 then set maxrank;
1799       array services[10] CSN--SportsIllustrated;
1800       array maxranks[10] mcsn--mspoi;
1801       keep School CSN--SportsIllustrated;
1802       do i=1 to 10;
1803       if services[i]=. then services[i]=maxranks[i]+1;
1804       end;
1805       run;

NOTE: There were 35 observations read from the data set WORK.BBALLM.
NOTE: There were 1 observations read from the data set WORK.MAXRANK.
NOTE: The data set WORK.BBALL has 35 observations and 11 variables.

1806       * Assume that the ranks are ordinal and that unranked teams would have
1807       * been ranked lower than ranked teams. Monotonically transform all ranked
1808       * teams while estimating the unranked teams. Enforce the constraint that
1809       * the missing ranks are estimated to be less than the observed ranks.
1810       * Order the unranked teams optimally within this constraint. Do this so
1811       * as to maximize the variance accounted for by one linear combination.
1812       * This makes the data as nearly rank one as possible, given the constraints.
1813       *
1814       * NOTE: The UNTIE transformation should be used with caution.
1815       * It frequently produces degenerate results.;
1816       ods graphics on;
1817       proc prinqual data=bball out=tbball scores n=1 tstandard=z
1818       plots=transformations;
1819       title2 'Optimal Monotonic Transformation of Ranked Teams';
1820       title3 'with Constrained Estimation of Unranked Teams';
1821       transform untie(CSN -- SportsIllustrated);
1822       id School;
1823       run;


