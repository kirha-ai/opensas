9050       options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
9050     ! validmemname=compatible locale=en_US;
9051       %let syscc=0;
9052       title; footnote;
9053       ods _all_ close;
