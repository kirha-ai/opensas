9056     !                                         quit;


9057       ods path work.templat(update) sashelp.tmplmst(read);
9058       
9059       data responses;
9060       call streaminit(329);
9061       array item[5] item1-item5;
9062       do subject=1 to 150;
9063       theta=rand('normal');
9064       do k=1 to 5;
9065       item[k]=rand('bernoulli',1/(1+exp(-(theta-(k-3)/2))));
9066       end;
9067       output;
9068       end;
9069       keep item1-item5;
9070       run;

NOTE: The data set WORK.RESPONSES has 150 observations and 5 variables.

9071       proc irt data=responses;
9072       var item1-item5;
9073       run;

NOTE: The observed frequency is zero for some response patterns. As a result, the Pearson chi-square model fit statistic is not calculated.
WARNING: Over 20 percent of the response patterns have expected frequency less than 5. The chi-square distribution might not provide valid statistical 
         inferences about the model fit when you use the Pearson chi-square and the likelihood ratio chi-square.
