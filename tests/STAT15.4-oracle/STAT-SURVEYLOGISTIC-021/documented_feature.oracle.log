21469      ods graphics on;
21470      ods trace on;
21471      ods trace on;
21472      data survey;
21473      call streaminit(722);
21474      do stratum=1 to 2;
21475      do cluster=1 to 4;
21476      do id=1 to 12;
21477      age=20+mod(id*7+cluster,45);
21478      event=rand('bernoulli',0.3);
21479      weight=2+stratum+cluster/10;
21480      output;
21481      end;
21482      end;
21483      end;
21484      run;

NOTE: The data set WORK.SURVEY has 96 observations and 6 variables.

21485      proc surveylogistic data=survey;
21486      strata stratum;
21487      cluster cluster;
21488      weight weight;
21489      model event(event='1')=age;
21490      run;


