9706       options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
9706     ! validmemname=compatible locale=en_US;
9707       %let syscc=0;
9708       title; footnote;
9709       ods _all_ close;
9710       ods listing gpath="%sysfunc(pathname(work))";
9711       ods graphics off;
9712       proc datasets library=work kill nolist;
NOTE: Deleting WORK.BIVNORMAL (memtype=DATA).
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK.SASMAC2 (memtype=CATALOG).
NOTE: Deleting WORK.TEMPLAT (memtype=ITEMSTOR).
NOTE: File WORK.TEMPLAT (memtype=ITEMSTOR) cannot be deleted because it is in use.
9712     !                                         quit;


9713       ods path work.templat(update) sashelp.tmplmst(read);
9714       
9715       ods trace on;
9716       data bivnormal;
9717       seed = 1283470;
9718       do i = 1 to 1000;
9719       z1 = rannor(seed);
9720       z2 = rannor(seed);
9721       z3 = rannor(seed);
9722       x = 3*z1+z2;
9723       y = 3*z1+z3;
9724       output;
9725       end;
9726       drop seed;
9727       run;

NOTE: The data set WORK.BIVNORMAL has 1000 observations and 6 variables.

9728       ods graphics on;
9729       proc kde data=bivnormal;
9730       bivar x y / plots=(contour surface);
9731       run;

