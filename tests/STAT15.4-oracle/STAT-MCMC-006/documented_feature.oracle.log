15952      proc mcmc data=behrens outpost=postout seed=123
15953      nmc=1000 monitor=(_parms_ mudif)
15954      statistics(alpha=0.01) nbi=200;
15955      ods select PostSumInt;
15956      parm mu1 0 mu2 0;
15957      parm sig21 1;
