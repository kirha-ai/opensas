15959      prior mu: ~ general(0);
15960      prior sig21 ~ general(-log(sig21), lower=0);
15961      prior sig22 ~ general(-log(sig22), lower=0);
15962      mudif = mu1 - mu2;
15963      if ind = 1 then do;
