17711      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
17711    ! validmemname=compatible locale=en_US;
17712      %let syscc=0;
17713      title; footnote;
17714      ods _all_ close;
17715      ods listing gpath="%sysfunc(pathname(work))";
17716      ods graphics off;
17717      proc datasets library=work kill nolist;
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
