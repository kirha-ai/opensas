17718      ods path work.templat(update) sashelp.tmplmst(read);
17719      
17720      ods graphics on;
17721      proc spp data=sashelp.bei plots(equate)=(trends observations);
17722      process trees = (x, y /area=(0,0,1000,500) Event=Trees);
17723      trend grad = field(x,y, gradient);
17724      trend elev = field(x,y, elevation);
17725      run;

NOTE: The PROCEDURE SPP printed page 1217.

17726      proc spp data=sashelp.bei plots(equate)=(residual intensity);
17727      process trees = (x,y /area=(0,0,1000,500) event=Trees);
17728      trend elev = field(x,y,elevation);
17729      trend grad = field(x,y,gradient);
17730      model trees = elev grad / grid(64,64) residual(B=70) ;
17731      run;

NOTE: Convergence criterion (Absolute gradient, ABSGCONV=0.00001) satisfied.
NOTE: The PROCEDURE SPP printed page 1218.

