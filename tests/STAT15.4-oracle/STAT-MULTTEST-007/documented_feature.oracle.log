5163       ods graphics off;
5164       proc nlmixed data=test;
5165       parameters pi0=0.5 a=.1 b=.1;
5166       pi1= 1-pi0;
5167       bounds 0 <= pi0 <= 1;
5168       loglikelihood= log(pi0+pi1*pdf('beta',Probt,a,b));
5169       model Probt ~ general(loglikelihood);
5170       run;


