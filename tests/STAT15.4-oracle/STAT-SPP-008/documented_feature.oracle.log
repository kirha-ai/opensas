17792      proc spp data=sashelp.bei plots(equate)=(residual intensity);
17793      process trees = (x,y /area=(0,0,1000,500) event=Trees);
17794      trend elev = field(x,y,elevation);
17795      trend grad = field(x,y,gradient);
17796      model trees = elev grad / grid(64,64) residual(B=70) ;
17797      run;

