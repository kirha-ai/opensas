361        %macro _oracle_descriptor(ds);
362        proc contents data=&ds out=_oracle_descriptor(keep=name type length varnum label format informat) noprint; run;
363        proc sort data=_oracle_descriptor; by varnum; run;
364        proc print data=_oracle_descriptor noobs; run;
365        data _oracle_member;
366        length Dataset $64 DatasetType $16;
367        Dataset="&ds"; _handle=open("&ds");
368        DatasetType=attrc(_handle,'TYPE'); NObs=attrn(_handle,'NOBS'); NVars=attrn(_handle,'NVARS');
369        _close=close(_handle); drop _handle _close;
370        run;
371        proc print data=_oracle_member noobs; run;
