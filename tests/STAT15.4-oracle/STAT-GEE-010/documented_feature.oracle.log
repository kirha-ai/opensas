21699      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
21699    ! validmemname=compatible locale=en_US;
21700      %let syscc=0;
21701      title; footnote;
21702      ods _all_ close;
21703      ods listing gpath="%sysfunc(pathname(work))";
21704      ods graphics off;
21705      proc datasets library=work kill nolist;
