732      !                                         quit;


733        ods path work.templat(update) sashelp.tmplmst(read);
734        
735        title 'United States Population, 1920-1970';
736        data USPop;
737        * Regions:
738        * New England - ME, NH, VT, MA, RI, CT.
739        * Great Lakes - OH, IN, IL, MI, WI.
740        * South Atlantic - DE, MD, DC, VA, WV, NC, SC, GA, FL.
741        * Mountain - MT, ID, WY, CO, NM, AZ, UT, NV.
742        * Pacific - WA, OR, CA.
743        *
744        * Note: Multiply data values by 1000 to get populations.;
745        length Region $14;
746        input Region :$14. y1920 y1930 y1940 y1950 y1960 y1970;
747        label y1920 = '1920' y1930 = '1930' y1940 = '1940'
748        y1950 = '1950' y1960 = '1960' y1970 = '1970';
749        if region = 'Hawaii' or region = 'Alaska'
750        then w = -1000;
751        /* Flag Supplementary Observations */
752        else w = 1000;
753        datalines;

NOTE: The data set WORK.USPOP has 11 observations and 8 variables.

765        ;
766        ods graphics on;
767        * Perform Simple Correspondence Analysis;
768        proc corresp data=uspop print=percent observed cellchi2 rp cp chi2p
769        short plot(flip);
770        var y1920 -- y1970;
771        id Region;
772        weight w;
773        run;

