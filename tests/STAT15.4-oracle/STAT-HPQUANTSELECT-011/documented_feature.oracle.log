5222       /* STAT-HPQUANTSELECT-011: HPQUANTSELECT — OUTPUT / Output Data Set
5223        * Source: S154 / Chapter 66 / `OUTPUT Statement` (PDF pp. 4991–4993); S154 / Chapter 66 / `Output Data Set` (PDF pp. 5007–5008).
5224        * Discriminates: Seeded synthetic quantile-regression fixture: OUTPUT / Output Data Set
5225        */
5226       options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
5226     ! validmemname=compatible locale=en_US;
5227       %let syscc=0;
5228       title; footnote;
5229       ods _all_ close;
5230       ods listing gpath="%sysfunc(pathname(work))";
5231       ods graphics off;
5232       proc datasets library=work kill nolist;
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK.SAMPLE (memtype=DATA).
NOTE: Deleting WORK.SCORED (memtype=DATA).
NOTE: Deleting WORK.TEMPLAT (memtype=ITEMSTOR).
NOTE: File WORK.TEMPLAT (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK._NAMEDAT (memtype=DATA).
5232     !                                         quit;


5233       ods path work.templat(update) sashelp.tmplmst(read);
5234       
5235       data sample;
5236       call streaminit(314159);
5237       do id=1 to 120;
5238        x=rand('normal'); z=rand('normal'); w=rand('normal'); group=1+mod(id,3);
5239        y=2+1.5*x-0.6*z+0.4*group+rand('normal');
5240        role=mod(id,4); output;
5241       end;
5242       run;

NOTE: The data set WORK.SAMPLE has 120 observations and 7 variables.

5243       
5244       proc hpquantselect data=sample;
5245       class group;
5246       model y=x z w group / quantile=0.5 clb;
5247       id id;
5248       output out=predicted p=pred r=resid stdp=se lclm=lo uclm=hi;
5249       performance nthreads=1;
5250       run;

NOTE: The HPQUANTSELECT procedure is executing in single-machine mode.
NOTE: The data set WORK.PREDICTED has 120 observations and 6 variables.
NOTE: The PROCEDURE HPQUANTSELECT printed pages 202-203.

5251       proc print data=predicted(obs=10); run;

NOTE: There were 10 observations read from the data set WORK.PREDICTED.
NOTE: The PROCEDURE PRINT printed page 204.

