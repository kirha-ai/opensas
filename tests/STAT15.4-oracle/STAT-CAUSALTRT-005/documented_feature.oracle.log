13669      proc causaltrt data=drugs method=ipwr ppsmodel;
13670      class Gender;
13671      psmodel Drug(ref='Drug_A') = Age Gender BMI;
13672      model Diabetes2(ref='No') / dist = bin;
13673      run;

NOTE: PROC CAUSALTRT is modeling the probability that Diabetes2='Yes'.
