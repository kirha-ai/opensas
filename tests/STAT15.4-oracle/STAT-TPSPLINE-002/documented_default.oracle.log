26229      /* STAT-TPSPLINE-002: TPSPLINE — Thin-plate smoothing spline estimation
26230       * Source: S154 / Chapter 125 / `Getting Started: TPSPLINE Procedure` (PDF pp. 10288–10297); S154 / Chapter 125 / `Overview: TPSPLINE Procedure`
26230    ! (PDF pp. 10286–10288).
26231       * Discriminates: Thin-plate smoothing, smoothing parameter search and output predictions/limits
26232       */
26233      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
26233    ! validmemname=compatible locale=en_US;
26234      %let syscc=0;
26235      title; footnote;
26236      ods _all_ close;
26237      ods listing gpath="%sysfunc(pathname(work))";
26238      ods graphics off;
26239      proc datasets library=work kill nolist;
NOTE: Deleting WORK.PREDICTED (memtype=DATA).
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK.SASGOPT (memtype=CATALOG).
NOTE: File WORK.SASGOPT (memtype=CATALOG) cannot be deleted because it is in use.
NOTE: Deleting WORK.SURFACE (memtype=DATA).
NOTE: Deleting WORK.TEMPLAT (memtype=ITEMSTOR).
NOTE: File WORK.TEMPLAT (memtype=ITEMSTOR) cannot be deleted because it is in use.
26239    !                                         quit;


26240      ods path work.templat(update) sashelp.tmplmst(read);
26241      
26242      data surface; do x1=-1 to 1 by 0.5; do x2=-1 to 1 by 0.5; do rep=1 to 2; y=3+x1-2*x2+0.5*x1*x2+0.1*cos(rep+x1+x2); output; end; end; end; run;

NOTE: The data set WORK.SURFACE has 50 observations and 4 variables.

26243      proc tpspline data=surface; model y=(x1 x2) / lognlambda=(-4 to -2.5 by 0.5); output out=predicted pred uclm lclm; run;

NOTE: The data set WORK.PREDICTED has 50 observations and 7 variables.
NOTE: The PROCEDURE TPSPLINE printed page 1624.

26244      proc print data=predicted(obs=12) noobs; run;

NOTE: There were 12 observations read from the data set WORK.PREDICTED.
NOTE: The PROCEDURE PRINT printed page 1625.

