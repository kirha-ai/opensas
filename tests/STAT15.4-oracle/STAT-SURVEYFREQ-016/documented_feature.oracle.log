19671      ods path work.templat(update) sashelp.tmplmst(read);
19672      
19673      data survey;
19674      do state=1 to 2;
19675      do school=1 to 4;
19676      do id=1 to 6;
19677      response=1+mod(id+school,3);
19678      schooltype=1+mod(school,2);
19679      samplingweight=2+state+school/10;
19680      output;
19681      end;
19682      end;
19683      end;
19684      run;

NOTE: The data set WORK.SURVEY has 48 observations and 6 variables.

19685      proc surveyfreq data=survey;
19686      strata state;
19687      cluster school;
19688      weight samplingweight;
19689      tables schooltype*response / row chisq;
19690      run;

NOTE: The Rao-Scott chi-square test cannot be computed for the table of schooltype by response because the design correction is not positive.
