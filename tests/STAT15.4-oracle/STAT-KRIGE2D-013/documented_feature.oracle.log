10748      ;
10749      ods graphics on;
10750      proc krige2d data=thick;
10751      coordinates xc=East yc=North;
10752      predict var=Thick radius=60;
10753      model scale=7.4599 range=30.1111 form=gauss;
10754      grid x=0 to 100 by 2.5 y=0 to 100 by 2.5;
10755      run;


