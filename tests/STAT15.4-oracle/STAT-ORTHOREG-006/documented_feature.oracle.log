1383       title 'Polynomial Data';
1384       data Polynomial;
1385       do i = 1 to 101;
1386       x = (i-1)/(101-1);
1387       y = 10**(9/2);
1388       do j = 0 to 8;
1389       y = y * (x - j/8);
1390       end;
1391       output;
1392       end;
1393       run;

NOTE: The data set WORK.POLYNOMIAL has 101 observations and 4 variables.

1394       ods graphics on;
1395       proc orthoreg data=Polynomial;
1396       effect xMod = polynomial(x / degree=9);
1397       model y = xMod;
1398       effectplot fit / obs;
1399       store OStore;
1400       run;

NOTE: The ORTHOREG procedure generated the model item store WORK.OSTORE.
NOTE: There were 101 observations read from the data set WORK.POLYNOMIAL.
NOTE: The PROCEDURE ORTHOREG printed page 179.

1401       ods graphics off;
