20915      do id=1 to 12;
20916      age=20+mod(id*7+cluster,45);
20917      event=rand('bernoulli',0.3);
20918      weight=2+stratum+cluster/10;
20919      output;
20920      end;
20921      end;
20922      end;
20923      run;

