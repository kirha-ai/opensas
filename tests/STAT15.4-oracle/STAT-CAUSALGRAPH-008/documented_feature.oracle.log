13161      proc causalgraph;
13162      model "Timm17TwoLatent"
13163      Age ==> Parity PFAS Education,
13164      Parity ==> PrevBF Duration PFAS,
13165      PrevBF ==> PFAS Duration,
13166      PFAS ==> Duration,
13167      Education ==> Duration Employment PFAS BMI Alcohol Smoking,
13168      Employment ==> Duration PFAS BMI Alcohol Smoking,
13169      BMI Alcohol Smoking ==> Duration;
13170      identify PFAS ==> Duration;
13171      unmeasured Alcohol Smoking;
13172      run;

