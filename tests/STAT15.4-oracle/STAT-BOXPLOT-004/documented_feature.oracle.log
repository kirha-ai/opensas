325        data Turbine;
326        informat Day date7.;
327        format Day date5.;
328        label KWatts='Average Power Output';
329        input Day @;
330        do i=1 to 10;
331        input KWatts @;
332        output;
333        end;
334        drop i;
335        datalines;

NOTE: The data set WORK.TURBINE has 200 observations and 2 variables.

356        ;
357        ods graphics off;
358        title 'Box Plot for Power Output';
359        proc boxplot data=Turbine;
360        plot KWatts*Day;
361        run;

