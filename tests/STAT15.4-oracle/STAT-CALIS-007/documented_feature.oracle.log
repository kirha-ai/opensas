NOTE: The data set WORK.KINZER has 6 observations and 8 variables.

723        ;
724        run;
725        proc calis data=Kinzer nobs=326 nose;
726        cosan
727        var= var1-var6,
728        D(6,DIA) * B(2,GEN) + D(6,DIA) * Psi(6,DIA);
729        matrix B
730        [ ,1] = b11 b21 b31 b41 b51 b61,
731        [ ,2] = b12 b22 b32 b42 b52 b62;
732        matrix Psi
733        [1,1] = psi1-psi6;
734        matrix D
735        [1,1] = d1-d6;
736        parameters alpha (1.);
737        /* SAS Programming Statements to Define Dependent Parameters*/
738        /* 6 constraints on the factor loadings */
739        b12 = alpha - b11;
740        b22 = alpha - b21;
741        b32 = alpha - b31;
742        b42 = alpha - b41;
743        b52 = alpha - b51;
744        b62 = alpha - b61;
745        /* 6 Constraints on Correlation structures */
746        psi1 = 1. - b11 * b11 - b12 * b12;
747        psi2 = 1. - b21 * b21 - b22 * b22;
748        psi3 = 1. - b31 * b31 - b32 * b32;
749        psi4 = 1. - b41 * b41 - b42 * b42;
750        psi5 = 1. - b51 * b51 - b52 * b52;
751        psi6 = 1. - b61 * b61 - b62 * b62;
752        vnames
753        D = [var1-var6],
754        B = [factor1 factor2],
755        Psi = D;
756        run;

