14226      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
14226    ! validmemname=compatible locale=en_US;
14227      %let syscc=0;
14228      title; footnote;
14229      ods _all_ close;
14230      ods listing gpath="%sysfunc(pathname(work))";
14231      ods graphics off;
14232      proc datasets library=work kill nolist;
NOTE: Deleting WORK.ONE (memtype=DATA).
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK.TEMPLAT (memtype=ITEMSTOR).
