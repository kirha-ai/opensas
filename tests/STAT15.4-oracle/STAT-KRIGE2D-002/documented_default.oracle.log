9894       /* STAT-KRIGE2D-002: KRIGE2D — Two-dimensional spatial kriging prediction
9895        * Source: S154 / Chapter 74 / `Getting Started: KRIGE2D Procedure` (PDF pp. 5437–5442); S154 / Chapter 74 / `Overview: KRIGE2D Procedure` (PDF pp.
9895     !  5436–5437).
9896        * Discriminates: Getting Started: KRIGE2D Procedure
9897        */
9898       options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
9898     ! validmemname=compatible locale=en_US;
9899       %let syscc=0;
9900       title; footnote;
9901       ods _all_ close;
9902       ods listing gpath="%sysfunc(pathname(work))";
9903       ods graphics off;
9904       proc datasets library=work kill nolist;
NOTE: Deleting WORK.DATA5 (memtype=DATA).
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK.SASMAC2 (memtype=CATALOG).
