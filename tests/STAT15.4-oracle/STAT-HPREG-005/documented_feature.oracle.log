5734       proc hpreg data=analysisData;
5735       partition roleVar=role(train='TRAIN' validate='VAL' test='TEST');
5736       class c1 c2 c3(order=data);
5737       model y = c1|c2|c3|x1|x2|x3|x4|x5|x5|x6|x7|x8|x9|x10
5738       |x11|x12|x13|x14|x15|x16|x17|x18|x19|x20 @2 /stb;
5739       selection method = stepwise(select=sl sle=0.1 sls=0.15 choose=validate)
5740       hierarchy=single details=steps;
5741       run;

NOTE: The HPREG procedure is executing in single-machine mode.
