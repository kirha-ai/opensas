5680       data analysisData;
5681       drop i j c3Num;
5682       length c3$ 7;
5683       array x{20} x1-x20;
5684       do i=1 to 15000;
5685       do j=1 to 20;
5686       x{j} = ranuni(1);
5687       end;
5688       c1 = 1 + mod(i,8);
5689       c2 = ranbin(1,3,.6);
5690       if i < 50 then do;
5691       c3 = 'tiny';
5692       c3Num=1;
5693       end;
5694       else if i < 250 then do;
5695       c3 = 'small';
5696       c3Num=1;
5697       end;
5698       else if i < 600 then do;
5699       c3 = 'average';
5700       c3Num=2;
5701       end;
5702       else if i < 1200 then do;
5703       c3 = 'big';
5704       c3Num=3;
5705       end;
5706       else do;
5707       c3 = 'huge';
5708       c3Num=5;
5709       end;
5710       yTrue = 10 + x1 + 2*x5 + 3*x10 + 4*x20 + 3 *x1*x7 + 8*x6*x7
5711       + 5*(c1=3)*c3Num + 8*(c1=7);
5712       error = 5*rannor(1);
5713       y = yTrue + error;
5714       if mod(i,3)=1 then Role = 'TRAIN';
5715       else if mod(i,3)=2 then Role = 'VAL';
5716       else Role = 'TEST';
5717       output;
5718       end;
5719       run;

NOTE: The data set WORK.ANALYSISDATA has 15000 observations and 27 variables.

5720       proc summary data=analysisData;
5721       class role;
5722       ways 1;
5723       var error;
5724       output out=ASE uss=uss n=n;

NOTE: There were 15000 observations read from the data set WORK.ANALYSISDATA.
NOTE: The data set WORK.ASE has 3 observations and 5 variables.

5725       data ASE;
5726       set ASE;
5727       OracleASE = uss / n;
5728       label OracleASE = 'Oracle ASE';
5729       keep Role OracleASE;

NOTE: There were 3 observations read from the data set WORK.ASE.
NOTE: The data set WORK.ASE has 3 observations and 2 variables.

