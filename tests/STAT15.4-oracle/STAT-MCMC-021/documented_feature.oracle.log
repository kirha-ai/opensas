1750       proc mcmc data=sashelp.class outpost=classout nmc=1000 thin=2 seed=246810 nbi=200;
1751       parms beta0 0 beta1 0;
1752       parms sigma2 1;
1753       prior beta0 beta1 ~ normal(mean = 0, var = 1e6);
