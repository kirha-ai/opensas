1768       ;
1769       proc mcmc data=behrens outpost=postout seed=123
1770       nmc=1000 monitor=(_parms_ mudif)
1771       statistics(alpha=0.01) nbi=200;
1772       ods select PostSumInt;
1773       parm mu1 0 mu2 0;
1774       parm sig21 1;
1775       parm sig22 1;
1776       prior mu: ~ general(0);
1777       prior sig21 ~ general(-log(sig21), lower=0);
1778       prior sig22 ~ general(-log(sig22), lower=0);
1779       mudif = mu1 - mu2;
1780       if ind = 1 then do;
1781       mu = mu1;
1782       s2 = sig21;
1783       end;
1784       else do;
1785       mu = mu2;
1786       s2 = sig22;
1787       end;
1788       model y ~ normal(mu, var=s2);
1789       run;

