10000      ods path work.templat(update) sashelp.tmplmst(read);
10001      
10002      ods trace on;
10003      data patients;
10004      call streaminit(419);
10005      do patientid=1 to 100;
10006      gender=mod(patientid,2);
10007      age=30+mod(patientid*7,45);
10008      bmi=20+mod(patientid,12);
10009      drug=rand('bernoulli',0.5);
10010      output;
10011      end;
10012      run;

NOTE: The data set WORK.PATIENTS has 100 observations and 5 variables.

10013      proc psmatch data=patients region=cs;
10014      class drug gender;
10015      psmodel drug(treated='1')=gender age bmi;
10016      match method=greedy(k=1) distance=lps caliper=0.5;
10017      assess lps var=(age bmi);
10018      output out(obs=match)=matched matchid=matchid;
10019      run;

WARNING: Some treated units do not have matched controls because there are not enough available controls for these treated units.

