9692       proc psmatch data=patients region=cs;
9693       class drug gender;
9694       psmodel drug(treated='1')=gender age bmi;
9695       match method=greedy(k=1) distance=lps caliper=0.5;
9696       assess lps var=(age bmi);
9697       output out(obs=match)=matched matchid=matchid;
9698       run;

