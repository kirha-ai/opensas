23440      data survey;
23441      call streaminit(722);
23442      do stratum=1 to 2;
23443      do cluster=1 to 4;
23444      do id=1 to 12;
23445      age=20+mod(id*7+cluster,45);
23446      time=1+rand('exponential')*10;
23447      status=(mod(id,4) ne 0);
23448      weight=2+stratum+cluster/10;
23449      output;
23450      end;
23451      end;
23452      end;
23453      run;

NOTE: The data set WORK.SURVEY has 96 observations and 7 variables.

23454      proc surveyphreg data=survey;
23455      strata stratum;
23456      cluster cluster;
23457      weight weight;
23458      model time*status(0)=age;
23459      run;

NOTE: Convergence criterion (GCONV=1E-8) satisfied.
