30921      proc variogram data=sashelp.thick outv=outv;
30922      store out=SemivStoreGau / label='Thickness Gaussian WLS Fit';
30923      compute lagd=7 maxlag=10;
30924      coordinates xc=East yc=North;
30925      model form=gau cl / covb;
30926      var Thick;
