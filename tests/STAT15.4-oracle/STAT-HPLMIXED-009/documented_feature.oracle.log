3062       data SchoolSample;
3063       do SchoolID = 1 to 300;
3064       do nID = 1 to 25;
3065       Neighborhood = (SchoolID-1)*5 + nId;
3066       bInt = 5 *ranuni(1);
3067       bTime = 5 *ranuni(1);
3068       bTime2 = ranuni(1);
3069       do sID = 1 to 2;
3070       do Time = 1 to 4;
3071       Math = bInt + bTime*Time + bTime2*Time*Time + rannor(2);
3072       output;
3073       end;
3074       end;
3075       end;
3076       end;
3077       run;

NOTE: The data set WORK.SCHOOLSAMPLE has 60000 observations and 9 variables.

3078       proc hplmixed data=SchoolSample;
3079       class Neighborhood SchoolID;
3080       model Math = Time Time*Time / solution;
3081       random int Time Time *Time / sub=Neighborhood(SchoolID) type=un;
3082       run;

