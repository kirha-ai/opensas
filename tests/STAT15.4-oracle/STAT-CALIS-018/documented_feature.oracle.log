9166       proc calis data=Kinzer nobs=326 nose;
9167       cosan
9168       var= var1-var6,
9169       D(6,DIA) * B(2,GEN) + D(6,DIA) * Psi(6,DIA);
9170       matrix B
9171       [ ,1]= b11 b21 b31 b41 b51 b61,
9172       [ ,2]= 0. b22 b32 b42 b52 b62;
9173       matrix Psi
9174       [1,1]= psi1-psi6;
9175       matrix D
9176       [1,1]= d1-d6 ;
9177       lincon
9178       b61 <= b51,
9179       b51 <= b41,
9180       b41 <= b31,
9181       b31 <= b21,
9182       b21 <= b11,
9183       0. <= b22,
9184       b22 <= b32,
9185       b32 <= b42,
9186       b42 <= b52,
9187       b52 <= b62;
9188       /* SAS Programming Statements */
9189       /* 6 Constraints on Correlation structures */
9190       psi1 = 1. - b11 * b11;
9191       psi2 = 1. - b21 * b21 - b22 * b22;
9192       psi3 = 1. - b31 * b31 - b32 * b32;
9193       psi4 = 1. - b41 * b41 - b42 * b42;
9194       psi5 = 1. - b51 * b51 - b52 * b52;
9195       psi6 = 1. - b61 * b61 - b62 * b62;
9196       vnames
9197       B = [factor1 factor2],
9198       Psi = [var1-var6],
9199       D = Psi;
9200       run;

