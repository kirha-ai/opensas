1602       proc mcmc data=sample outpost=posterior seed=314159 nmc=1500 nbi=300 plots=all;
1603        parms mu 80 sigma2 200;
1604        prior mu ~ normal(0,var=10000);
1605        prior sigma2 ~ igamma(shape=3,scale=300);
1606        model x ~ normal(mu,var=sigma2);
1607       run;


