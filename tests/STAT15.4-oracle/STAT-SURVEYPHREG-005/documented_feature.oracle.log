22991      do stratum=1 to 2;
22992      do cluster=1 to 4;
22993      do id=1 to 12;
22994      age=20+mod(id*7+cluster,45);
22995      time=1+rand('exponential')*10;
22996      status=(mod(id,4) ne 0);
22997      weight=2+stratum+cluster/10;
22998      output;
