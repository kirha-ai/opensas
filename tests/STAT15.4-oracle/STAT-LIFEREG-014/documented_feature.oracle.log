12160      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
12160    ! validmemname=compatible locale=en_US;
12161      %let syscc=0;
12162      title; footnote;
12163      ods _all_ close;
12164      ods listing gpath="%sysfunc(pathname(work))";
12165      ods graphics off;
12166      proc datasets library=work kill nolist;
NOTE: Deleting WORK.FAN (memtype=DATA).
NOTE: Deleting WORK.HEADACHE (memtype=DATA).
NOTE: Deleting WORK.NEW (memtype=DATA).
NOTE: Deleting WORK.POST (memtype=DATA).
NOTE: Deleting WORK.PROB (memtype=DATA).
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK.SASMAC2 (memtype=CATALOG).
NOTE: Deleting WORK.TEMPLAT (memtype=ITEMSTOR).
NOTE: File WORK.TEMPLAT (memtype=ITEMSTOR) cannot be deleted because it is in use.
12166    !                                         quit;


12167      ods path work.templat(update) sashelp.tmplmst(read);
12168      
12169      ods graphics on;
12170      ods trace on;
12171      ods trace on;
12172      data Micro;
12173      input t1 t2 f;
12174      datalines;

NOTE: The data set WORK.MICRO has 14 observations and 3 variables.

12189      ;
12190      ods graphics on;
12191      proc lifereg data=Micro;
12192      model ( t1 t2 ) = / d=lognormal intercept=25 scale=5;
12193      weight f;
12194      probplot
12195      pupper = 10
12196      itprintem
12197      printprobs
12198      maxitem = (1000,25)
12199      ppout;
12200      inset;
12201      run;


