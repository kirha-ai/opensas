967        
968        data sample;
969        call streaminit(314159);
970        do id=1 to 90;
971         x=rand('normal'); z=rand('normal'); w=rand('normal');
972         group=1+mod(id,3); block=1+mod(id,5);
973         y=5+1.5*x-0.6*z+0.4*group+rand('normal');
974         y2=2+0.5*x+0.8*z+rand('normal'); output;
975        end;
976        run;

NOTE: The data set WORK.SAMPLE has 90 observations and 8 variables.

977        proc factor data=sample nfactors=1; var x y y2; partial z; run;

