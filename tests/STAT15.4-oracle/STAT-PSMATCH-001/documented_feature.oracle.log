9618       data patients;
9619       call streaminit(419);
9620       do patientid=1 to 100;
9621       gender=mod(patientid,2);
9622       age=30+mod(patientid*7,45);
9623       bmi=20+mod(patientid,12);
9624       drug=rand('bernoulli',0.5);
9625       output;
9626       end;
9627       run;

NOTE: The data set WORK.PATIENTS has 100 observations and 5 variables.

9628       proc psmatch data=patients region=cs;
9629       class drug gender;
9630       psmodel drug(treated='1')=gender age bmi;
9631       match method=greedy(k=1) distance=lps caliper=0.5;
9632       assess lps var=(age bmi);
9633       output out(obs=match)=matched matchid=matchid;
9634       run;

