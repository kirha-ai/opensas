3814       options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
3814     ! validmemname=compatible locale=en_US;
3815       %let syscc=0;
3816       title; footnote;
3817       ods _all_ close;
3818       ods listing gpath="%sysfunc(pathname(work))";
3819       ods graphics off;
3820       proc datasets library=work kill nolist;
NOTE: Deleting WORK.NEW (memtype=DATA).
NOTE: Deleting WORK.POST (memtype=DATA).
