4376       options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
4376     ! validmemname=compatible locale=en_US;
4377       %let syscc=0;
4378       title; footnote;
4379       ods _all_ close;
4380       ods listing gpath="%sysfunc(pathname(work))";
4381       ods graphics off;
4382       proc datasets library=work kill nolist;
NOTE: Deleting WORK.CRIME (memtype=DATA).
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK.TEMPLAT (memtype=ITEMSTOR).
NOTE: File WORK.TEMPLAT (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK._ORACLE_OUTPUT (memtype=DATA).
4382     !                                         quit;


4383       ods path work.templat(update) sashelp.tmplmst(read);
4384       
4385       ods trace on;
4386       title 'Crime Rates per 100,000 Population by State';
4387       data Crime;
4388       length State $15;
4389       input State :$15. Murder Rape Robbery Assault
4390       Burglary Larceny Auto_Theft;
4391       datalines;

NOTE: The data set WORK.CRIME has 50 observations and 8 variables.

4442       ;
4443       proc hpprincomp data=Crime;
4444       run;

NOTE: The HPPRINCOMP procedure is executing in single-machine mode.

