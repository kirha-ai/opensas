9474       data bivnormal;
9475       seed = 1283470;
9476       do i = 1 to 1000;
9477       z1 = rannor(seed);
9478       z2 = rannor(seed);
9479       z3 = rannor(seed);
9480       x = 3*z1+z2;
9481       y = 3*z1+z3;
9482       output;
9483       end;
9484       drop seed;
9485       run;

NOTE: The data set WORK.BIVNORMAL has 1000 observations and 6 variables.

9486       ods graphics on;
