23194      data survey;
23195      call streaminit(722);
23196      do stratum=1 to 2;
23197      do cluster=1 to 4;
23198      do id=1 to 12;
23199      age=20+mod(id*7+cluster,45);
23200      time=1+rand('exponential')*10;
23201      status=(mod(id,4) ne 0);
23202      weight=2+stratum+cluster/10;
23203      output;
23204      end;
23205      end;
23206      end;
23207      run;

NOTE: The data set WORK.SURVEY has 96 observations and 7 variables.

23208      proc surveyphreg data=survey;
23209      strata stratum;
23210      cluster cluster;
23211      weight weight;
23212      model time*status(0)=age;
23213      run;

