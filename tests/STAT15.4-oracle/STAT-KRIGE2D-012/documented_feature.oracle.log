10651      ods trace on;
10652      title 'Spatial Prediction With Kriging';
10653      data thick;
10654      input East North Thick @@;
10655      label Thick='Coal Seam Thickness';
10656      datalines;

NOTE: SAS went to a new line when INPUT statement reached past the end of a line.
NOTE: The data set WORK.THICK has 75 observations and 3 variables.

10682      ;
10683      ods graphics on;
10684      proc krige2d data=thick;
10685      coordinates xc=East yc=North;
10686      predict var=Thick radius=60;
10687      model scale=7.4599 range=30.1111 form=gauss;
10688      grid x=0 to 100 by 2.5 y=0 to 100 by 2.5;
10689      run;


