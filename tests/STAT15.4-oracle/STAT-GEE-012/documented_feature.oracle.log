21826      ods path work.templat(update) sashelp.tmplmst(read);
21827      
21828      ods graphics on;
21829      ods trace on;
21830      ods trace on;
21831      data Children;
21832      input ID City$ @@;
21833      do i=1 to 4;
21834      input Age Smoke Symptom @@;
21835      output;
21836      end;
21837      datalines;

NOTE: SAS went to a new line when INPUT statement reached past the end of a line.
NOTE: The data set WORK.CHILDREN has 100 observations and 6 variables.

21863      ;
21864      proc gee data=Children descending;
21865      class ID City;
21866      model Symptom = City Age Smoke / dist=bin link=logit;
21867      repeated subject=ID / type=exch covb corrw;
21868      run;


