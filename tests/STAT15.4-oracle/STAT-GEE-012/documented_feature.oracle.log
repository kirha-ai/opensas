21819      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
21819    ! validmemname=compatible locale=en_US;
21820      %let syscc=0;
21821      title; footnote;
21822      ods _all_ close;
21823      ods listing gpath="%sysfunc(pathname(work))";
21824      ods graphics off;
21825      proc datasets library=work kill nolist;
NOTE: Deleting WORK.CHILDREN (memtype=DATA).
