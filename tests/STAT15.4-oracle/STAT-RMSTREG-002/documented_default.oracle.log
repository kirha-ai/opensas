13342       */
13343      options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
13343    ! validmemname=compatible locale=en_US;
13344      %let syscc=0;
13345      title; footnote;
13346      ods _all_ close;
13347      ods listing gpath="%sysfunc(pathname(work))";
13348      ods graphics off;
13349      proc datasets library=work kill nolist;
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK.SASGOPT (memtype=CATALOG).
