22843      data survey;
22844      call streaminit(722);
22845      do stratum=1 to 2;
22846      do cluster=1 to 4;
22847      do id=1 to 12;
22848      age=20+mod(id*7+cluster,45);
22849      time=1+rand('exponential')*10;
22850      status=(mod(id,4) ne 0);
22851      weight=2+stratum+cluster/10;
22852      output;
22853      end;
22854      end;
22855      end;
22856      run;

NOTE: The data set WORK.SURVEY has 96 observations and 7 variables.

22857      proc surveyphreg data=survey;
22858      strata stratum;
22859      cluster cluster;
22860      weight weight;
22861      model time*status(0)=age;
22862      run;

