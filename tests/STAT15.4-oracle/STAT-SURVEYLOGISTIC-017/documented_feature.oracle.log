21271      data survey;
21272      call streaminit(722);
21273      do stratum=1 to 2;
21274      do cluster=1 to 4;
21275      do id=1 to 12;
21276      age=20+mod(id*7+cluster,45);
21277      event=rand('bernoulli',0.3);
21278      weight=2+stratum+cluster/10;
21279      output;
21280      end;
21281      end;
21282      end;
21283      run;

NOTE: The data set WORK.SURVEY has 96 observations and 6 variables.

21284      proc surveylogistic data=survey;
21285      strata stratum;
21286      cluster cluster;
21287      weight weight;
21288      model event(event='1')=age;
21289      run;

