NOTE: The data set WORK.BLOTCH has 90 observations and 3 variables.

23938      ;
23939      proc glimmix data=blotch;
23940      class site variety;
23941      model prop = site variety / link=logit dist=binomial;
23942      random _residual_;
23943      lsmeans variety / diff=control('1');
23944      run;




