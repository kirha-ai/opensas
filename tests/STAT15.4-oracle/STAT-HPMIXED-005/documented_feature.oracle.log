4858        */
4859       options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
4859     ! validmemname=compatible locale=en_US;
4860       %let syscc=0;
4861       title; footnote;
4862       ods _all_ close;
4863       ods listing gpath="%sysfunc(pathname(work))";
4864       ods graphics off;
4865       proc datasets library=work kill nolist;
NOTE: Deleting WORK.HEIGHTS (memtype=DATA).
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
NOTE: File WORK.REGSTRY (memtype=ITEMSTOR) cannot be deleted because it is in use.
NOTE: Deleting WORK.SASGOPT (memtype=CATALOG).
