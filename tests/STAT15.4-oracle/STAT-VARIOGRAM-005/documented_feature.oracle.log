30260      title 'Semivariogram Model Fitting of Log-Arsenic Concentration';
30261      data logAsData;
30262      input East North logAs @@;
30263      label logAs='log(As) Concentration';
30264      datalines;

NOTE: SAS went to a new line when INPUT statement reached past the end of a line.
NOTE: The data set WORK.LOGASDATA has 138 observations and 3 variables.

30311      ;
30312      ods graphics on;
30313      proc variogram data=logAsData plots=pairs(mid);
30314      compute novariogram nhc=50;
30315      coord xc=East yc=North;
30316      var logAs;
30317      run;

NOTE: The PROCEDURE VARIOGRAM printed page 1861.

30318      proc variogram data=logAsData plots(only)=semivar;
30319      compute lagd=5 maxlag=40;
30320      coord xc=East yc=North;
30321      var logAs;
30322      run;

NOTE: No DIRECTIONS statement and no NDIRECTIONS=, or NDIRECTIONS=0 specified: Computing omnidirectional semivariogram.
NOTE: The PROCEDURE VARIOGRAM printed pages 1862-1863.

30323      proc variogram data=logAsData plots(only)=fit;
30324      store out=SemivAsStore / label='LogAs Concentration Models';
30325      compute lagd=5 maxlag=40;
30326      coord xc=East yc=North;
30327      model form=auto(mlist=(exp,gau,mat) nest=1 to 2);
30328      var logAs;
30329      run;

NOTE: No DIRECTIONS statement and no NDIRECTIONS=, or NDIRECTIONS=0 specified: Computing omnidirectional semivariogram.
NOTE: Matern form replaced with Gaussian form in one or more models because the smoothing parameter exceeded the MTOGTOL= option threshold. This action 
