2309       data a (drop=i);
2310       do i=1 to 1000;
2311       x1=rannor(1234);
2312       x2=rannor(1234);
2313       e=rannor(1234);
2314       if i > 950 then y=100 + 10*e;
2315       else y=10 + 5*x1 + 3*x2 + 0.5 * e;
2316       output;
2317       end;
2318       run;

NOTE: The data set WORK.A has 1000 observations and 4 variables.

2319       data _oracle_input; set a; do _oracle_by=1 to 2; output; end; run;

NOTE: There were 1000 observations read from the data set WORK.A.
NOTE: The data set WORK._ORACLE_INPUT has 2000 observations and 5 variables.

2320       proc sort data=_oracle_input; by _oracle_by; run;

