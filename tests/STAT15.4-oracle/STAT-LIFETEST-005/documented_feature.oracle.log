1287       options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
1287     ! validmemname=compatible locale=en_US;
1288       %let syscc=0;
1289       title; footnote;
