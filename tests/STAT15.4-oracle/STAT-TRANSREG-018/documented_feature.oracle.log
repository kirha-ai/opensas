28116      title 'Introductory Main-Effects ANOVA Example';
28117      data a;
28118      input y x1 $ x2 $;
28119      datalines;

NOTE: The data set WORK.A has 12 observations and 3 variables.

28132      ;
28133      * Fit a main-effects ANOVA model with 1, 0, -1 coding;
28134      proc transreg ss2;
28135      model identity(y) = class(x1 x2 / effects);
28136      output coefficients replace;
28137      run;

