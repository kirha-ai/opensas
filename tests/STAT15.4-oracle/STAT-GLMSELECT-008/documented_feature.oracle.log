5867       /* STAT-GLMSELECT-008: GLMSELECT — Stepwise Selection (STEPWISE) / Lasso Selection (LASSO) / Adaptive LASSO Selection
5868        * Source: S154 / Chapter 56 / `Stepwise Selection (STEPWISE)` (PDF pp. 4361–4362); S154 / Chapter 56 / `Lasso Selection (LASSO)` (PDF pp.
5868     ! 4363–4364); S154 / Chapter 56 / `Adaptive LASSO Selection` (PDF p. 4364).
5869        * Discriminates: Example 56.7: LASSO with Screening
5870        */
5871       options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
5871     ! validmemname=compatible locale=en_US;
5872       %let syscc=0;
5873       title; footnote;
5874       ods _all_ close;
5875       ods listing gpath="%sysfunc(pathname(work))";
5876       ods graphics off;
5877       proc datasets library=work kill nolist;
NOTE: Deleting WORK.REGSTRY (memtype=ITEMSTOR).
