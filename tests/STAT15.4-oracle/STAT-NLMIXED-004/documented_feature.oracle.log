6467       ;
6468       proc nlmixed data=headache;
6469       bounds gamma > 0;
6470       linp = b0 - b1 *(group-2);
6471       alpha = exp(-linp);
6472       G_t = exp(-(alpha *minutes)**gamma);
6473       g = gamma *alpha*((alpha*minutes)**(gamma-1))*G_t;
6474       ll = (censor=0) *log(g) + (censor=1)*log(G_t);
6475       model minutes ~ general(ll);
6476       predict 1-G_t out=cdf;
6477       run;

