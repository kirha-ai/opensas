26205      data surface;
26206      do x1=-1 to 1 by 0.5;
26207      do x2=-1 to 1 by 0.5;
26208      do rep=1 to 2;
26209      y=3+x1-2*x2+0.5*x1*x2+0.1*cos(rep+x1+x2);
26210      output;
26211      end;
26212      end;
26213      end;
26214      run;

NOTE: The data set WORK.SURFACE has 50 observations and 4 variables.

26215      proc tpspline data=surface;
26216      model y=(x1 x2) / lognlambda=(-4 to -2.5 by 0.5);
26217      output out=predicted pred uclm lclm;
26218      run;

NOTE: The data set WORK.PREDICTED has 50 observations and 7 variables.
