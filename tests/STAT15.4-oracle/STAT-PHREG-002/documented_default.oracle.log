1809       data Rats;
1810       label Days ='Days from Exposure to Death';
1811       input Days Status Group @@;
1812       datalines;

NOTE: SAS went to a new line when INPUT statement reached past the end of a line.
NOTE: The data set WORK.RATS has 40 observations and 3 variables.

1823       ;
1824       data Regimes;
1825       Group=0;
1826       output;
1827       Group=1;
1828       output;
1829       run;

NOTE: The data set WORK.REGIMES has 2 observations and 1 variables.

1830       ods graphics on;
1831       proc phreg data=Rats plot(overlay)=survival;
1832       model Days*Status(0)=Group;
1833       baseline covariates=regimes out=_null_;
1834       run;

NOTE: Convergence criterion (GCONV=1E-8) satisfied.
NOTE: The PROCEDURE PHREG printed page 208.

1835       proc phreg data=Rats;
1836       model Days*Status(0)=Group X;
1837       X=Group*(log(Days) - 5.4);
1838       run;

NOTE: Convergence criterion (GCONV=1E-8) satisfied.
NOTE: The PROCEDURE PHREG printed page 209.

1839       ods graphics on;
1840       proc phreg data=Rats;
1841       model Days*Status(0)=Group;
1842       bayes seed=1 outpost=Post nmc=1000 nbi=200;
1843       run;

NOTE: Convergence criterion (GCONV=1E-8) satisfied.
NOTE: The data set WORK.POST has 1000 observations and 4 variables.
NOTE: The PROCEDURE PHREG printed pages 210-212.

1844       data New;
1845       set Post;
1846       Indicator=(Group < 0);
1847       label Indicator='Group < 0';
1848       run;

