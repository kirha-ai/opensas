5373       options nosyntaxcheck obs=max firstobs=1 nodate nonumber nocenter linesize=160 pagesize=max nostimer nofullstimer validvarname=v7
5373     ! validmemname=compatible locale=en_US;
5374       %let syscc=0;
5375       title; footnote;
5376       ods _all_ close;
5377       ods listing gpath="%sysfunc(pathname(work))";
5378       ods graphics off;
