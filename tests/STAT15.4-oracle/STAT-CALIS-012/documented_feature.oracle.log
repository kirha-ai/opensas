8372       title "Stability of Alienation";
8373       title2 "Data Matrix of WHEATON, MUTHEN, ALWIN & SUMMERS (1977)";
8374       data Wheaton(TYPE=COV);
8375       length _name_ $32 _type_ $8;
8376       infile datalines truncover;
8377       
8378       _type_ = 'cov';
8379       input _name_ :$32. Anomie67 Powerless67 Anomie71 Powerless71
8380       Education SEI;
8381       label Anomie67='Anomie (1967)' Powerless67='Powerlessness (1967)'
8382       Anomie71='Anomie (1971)' Powerless71='Powerlessness (1971)'
8383       Education='Education' SEI='Occupational Status Index';
8384       datalines;

NOTE: The data set WORK.WHEATON has 6 observations and 8 variables.

8391       ;
8392       ods graphics on;
8393       proc calis nobs=932 data=Wheaton plots=residuals;
8394       path
8395       Anomie67 Powerless67 <=== Alien67 = 1.0 0.833,
8396       Anomie71 Powerless71 <=== Alien71 = 1.0 0.833,
8397       Education SEI <=== SES = 1.0 lambda,
8398       Alien67 Alien71 <=== SES = gamma1 gamma2,
8399       Alien71 <=== Alien67 = beta;
8400       pvar
8401       Anomie67 = theta1,
8402       Powerless67 = theta2,
8403       Anomie71 = theta1,
8404       Powerless71 = theta2,
8405       Education = theta3,
8406       SEI = theta4,
8407       Alien67 = psi1,
8408       Alien71 = psi2,
8409       SES = phi;
8410       pcov
8411       Anomie67 Anomie71 = theta5,
8412       Powerless67 Powerless71 = theta5;
8413       pathdiagram title='Stability of Alienation';
8414       run;

