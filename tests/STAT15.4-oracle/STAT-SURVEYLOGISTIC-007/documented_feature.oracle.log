4252       ;
4253       data WebSurvey;
4254       set WebSurvey;
4255       if Class=1 then Weight=3734/300;
4256       if Class=2 then Weight=3565/300;
4257       if Class=3 then Weight=3903/300;
4258       if Class=4 then Weight=4196/300;
4259       run;

NOTE: There were 60 observations read from the data set WORK.WEBSURVEY.
