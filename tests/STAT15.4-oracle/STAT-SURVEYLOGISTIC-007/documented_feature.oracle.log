NOTE: Format DESIGN has been output.
4230       value Rating
4231       1='dislike very much'
4232       2='dislike'
4233       3='neutral'
4234       4='like'
4235       5='like very much';
NOTE: Format RATING has been output.
4236       run;


4237       data WebSurvey;
4238       format Class Class. Design Design. Rating Rating.;
4239       do Class=1 to 4;
4240       do Design=1 to 3;
4241       do Rating=1 to 5;
4242       input Count @@;
4243       output;
4244       end;
4245       end;
4246       end;
4247       datalines;

