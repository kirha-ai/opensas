data _null_;
  length k 8 v $8;
  declare hash h();
  h.defineKey("k");
  h.defineData("k","v");
  h.defineDone();
  k=10; v="ten";    h.add();
  k=20; v="twenty"; h.add();
  k=30; v="thirty"; h.add();
  declare hiter hi("h");
  rc=hi.last();  put "last k=" k " v=" v;
  rc=hi.prev();  put "prev k=" k " v=" v;
  rc=hi.prev();  put "prev k=" k " v=" v;
  rc=hi.prev();  put "prev-before-first rc=" rc;
  rc=hi.next();  put "next-again k=" k " v=" v;
  rc=h.clear();  put "clear rc=" rc;
  n=h.num_items; put "n-after-clear=" n;
  rc=hi.first(); put "first-after-clear rc=" rc;
  k=40; v="forty"; h.add();
  n=h.num_items; put "n-reused=" n;
  rc=h.delete(); put "delete rc=" rc;
  declare hash h();
  h.defineKey("k");
  h.defineData("k","v");
  h.defineDone();
  n=h.num_items; put "n-fresh=" n;
run;
