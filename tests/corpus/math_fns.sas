data _null_;
  a = exp(0);
  b = log(1);
  c = log10(1000);
  d = log2(16);
  s = round(sin(0), .0001);
  co = round(cos(0), .0001);
  t = round(tan(0), .0001);
  at = round(atan2(1, 1), .0001);
  sh = round(sinh(0), .0001);
  ch = round(cosh(0), .0001);
  th = round(tanh(0), .0001);
  as = round(arsin(1), .0001);
  ac = round(arcos(1), .0001);
  sg = sign(-42);
  fc = fact(6);
  cb = comb(6, 2);
  pm = perm(6, 2);
  dg = round(digamma(1), .0001);
  put "a=" a " b=" b " c=" c " d=" d;
  put "s=" s " co=" co " t=" t " at=" at;
  put "sh=" sh " ch=" ch " th=" th;
  put "as=" as " ac=" ac " sg=" sg;
  put "fc=" fc " cb=" cb " pm=" pm " dg=" dg;
run;
