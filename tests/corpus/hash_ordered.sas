data _null_;
  length k 8 v $8;
  declare hash h(ordered:"a");
  h.defineKey("k");
  h.defineData("k","v");
  h.defineDone();
  k=30; v="thirty"; h.add();
  k=10; v="ten";    h.add();
  k=20; v="twenty"; h.add();
  declare hiter hi("h");
  rc=hi.first();
  do while (rc=0);
    put "asc k=" k " v=" v;
    rc=hi.next();
  end;
run;

