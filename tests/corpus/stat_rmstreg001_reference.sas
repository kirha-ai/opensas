/* STAT-RMSTREG-001: the reference program of the ticket on its exact data.
 * The original builds TIME with CALL STREAMINIT(218) and RAND('NORMAL'),
 * whose SAS stream opensas does not reproduce; here the 100 TIME values SAS
 * 9.4 generated (printed there with HEX16.) are read as shortest round-trip
 * decimals, bit-identical. Synthetic data, no real data.
 * AGE, X and STATUS are the original deterministic formulas. Expected
 * listing: the SAS 9.4 reference listing of the original program, then
 * LINK=LOG and the defaults (LINK=LOG METHOD=PV) on the same data, and a
 * BY / FREQ run with one missing explanatory value (SAS 9.4).
 */
options nodate nonumber nocenter linesize=160 pagesize=max;
data survival;
input id time status;
age=25+mod(id*7,40);
x=mod(id,2);
