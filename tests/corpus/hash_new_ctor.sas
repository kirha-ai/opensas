data _null_;
  length k 8 v $8;
  declare hash h;
  h = _new_ hash();
  h.defineKey("k");
  h.defineData("v");
  h.defineDone();
  k=1; v="one"; rc=h.add();
  k=2; v="two"; rc=h.add();
  k=2; rc=h.find();
  put "found v=" v;
run;

data _null_;
  length k 8 v $8;
  declare hash h;
  h = _new_ hash(ordered:"a");
  h.defineKey("k");
  h.defineData("k","v");
  h.defineDone();
  k=30; v="thirty"; h.add();
  k=10; v="ten";    h.add();
  declare hiter hi("h");
  rc=hi.first();
  do while (rc=0);
    put "k=" k " v=" v;
    rc=hi.next();
  end;
run;
