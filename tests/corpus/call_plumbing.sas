data _null_;
  seed = 12345;
  call ranuni(seed, u);
  call ranuni(seed, u2);
  ok = (u > 0 and u < 1 and u2 > 0 and u2 < 1 and u ne u2);
  put "ranuni_ok=" ok;
  a=3; b=1; c=2;
