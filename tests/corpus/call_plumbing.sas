  put "sort_num=" a b c;
  length p $6 q $6 r $6;
  p="cherry"; q="apple"; r="banana";
  call sort(p, q, r);
  put "sort_char=" p q r;
  x = 42;
  call vname(x, nm);
  put "vname=" nm;
run;
