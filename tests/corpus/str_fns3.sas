data _null_;
  pi = round(constant("pi"), .0001);
  ct = count("abcabc", "bc");
  cc = countc("mississippi", "s");
  cw = countw("a b  c d");
  ic = indexc("xy9z", "0123456789");
  iw = indexw("the cat sat", "cat");
  ch = char("abc", 2);
  rt = right("ab");
  tn = lengthn("ab   ");
  mz = modz(10, 3);
  cn = choosen(2, 11, 22, 33);
  cs = choosec(-1, "x", "y", "z");
  wn = whichn(22, 11, 22, 33);
  fn = ifn(1, 100, 200);
  fc = ifc(0, "yes", "no");
  sx = soundex("Robert");
  nl = nliteral("a b");
  put "pi=" pi " ct=" ct " cc=" cc " cw=" cw " ic=" ic " iw=" iw;
  put "ch=" ch " rt=" rt " tn=" tn " mz=" mz " cn=" cn " cs=" cs;
  put "wn=" wn " fn=" fn " fc=" fc " sx=" sx " nl=" nl;
run;
