data sample;
  do rep=1 to 250;
    do i=1 to 16;
      x=1.8684768733855683*(1-ranuni(817)**0.056857224936872064)/0.056857224936872064;
      output;
    end;
  end;
run;
ods exclude all;
ods output ParameterEstimates=est;
proc univariate data=sample noprint;
  by rep;
  histogram x / pareto(theta=0 edfseed=11 edfnsamples=1) noplot;
run;
ods exclude none;
data _null_;
  set est;
  file print;
  if symbol in ('Sigma','Alpha') then put 'PAR|' rep 3. '|' symbol;
run;
