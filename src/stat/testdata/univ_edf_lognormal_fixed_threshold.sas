options nonumber nodate linesize=160;
ods graphics off;
ods exclude all;
data state;
  length n t lo hi lowstat highstat loPV hiPV 8;
  do n=6,8,15,30,65,128;
    do t=1 to 2;
      lo=0; hi=4; lowstat=.;highstat=.;loPV=.;hiPV=.; output;
    end;
  end;
run;
%macro probe;
%do step=1 %to 35;
data d;
  set state;
  g=(lo+hi)/2;
  do i=1 to n;
    v=(i-.41)/(n+.18);
    u=.5+.5*sign(2*v-1)*abs(2*v-1)**(1+g);
    x=exp(quantile('normal',u));
    output;
  end;
run;
ods output GoodnessOfFit=gof;
proc univariate data=d noprint;by n t;histogram x / lognormal noplot;run;
data selected; set gof;
  if (t=1 and TestLab='W-Sq') or (t=2 and TestLab='A-Sq');
  keep n t Stat pValue pSign;
run;
data state;
  merge state selected;by n t;
  if pValue=.5 and pSign='>' then do;lo=(lo+hi)/2;lowstat=Stat;loPV=pValue;end;
  else do;hi=(lo+hi)/2;highstat=Stat;hiPV=pValue;end;
  drop Stat pValue pSign;
run;
%end;
%mend;
%probe;
ods exclude none;
data _null_;set state;file print;
  put 'PROBE|' n '|' t '|' lowstat best32. '|' loPV '|' highstat best32. '|' hiPV;
run;
ods exclude all;
data hold;do n=9,24,77;
  do j=0 to 8; do i=1 to n;
    v=(i-.375)/(n+.25);u=v**(1+j*.11);
    z=quantile('normal',u); x=3+exp(.4+1.7*z); output;
  end;end;
end;run;
%macro validate(var,opt,id);
ods output GoodnessOfFit=gof;
proc univariate data=hold noprint;by n j;histogram &var / &opt noplot;run;
ods exclude none;
data _null_;set gof;file print;
  put "&id|" n '|' j '|' TestLab '|' Stat best32. '|' pValue best32. '|' pSign;
run;
ods exclude all;
%mend;
%validate(x,lognormal(theta=3),LOG);
%validate(z,normal,NORM);
ods exclude none;
data _null_;file print;put "VERSION=&sysvlong4";run;
