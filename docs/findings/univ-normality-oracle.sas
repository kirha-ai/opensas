options nodate nonumber;
data samples;
length case $32;
do n=3,4,8,11,12,2000,2001;
 case=cats('quantile',n);
 do i=1 to n; x=probit((i-.375)/(n+.25)); output; end;
 case=cats('uniform',n);
 do i=1 to n; x=i; output; end;
 case=cats('skew',n);
 do i=1 to n; x=log(i)+sin(i); output; end;
end;
do n=1,2,3,4,8,2001;
 case=cats('constant',n); do i=1 to n; x=7; output; end;
end;
do n=3,4,8,11,12,2000,2001;
 case=cats('ties',n); do i=1 to n; x=floor(i/3); output; end;
 case=cats('outlier',n); do i=1 to n; if i=n then x=1e6; else x=i; output; end;
end;
do shape=0.01 to 0.12 by 0.005;
 n=2001; case=cats('ks',put(shape,6.3));
 do i=1 to n; z=probit((i-.375)/(n+.25)); x=z+shape*(z*z-1); output; end;
end;
case='translate8'; n=8; do i=1 to n; x=1e12+i/1024; output; end;
case='scale8'; n=8; do i=1 to n; x=i*1e100; output; end;
keep case x;
run;
proc sort data=samples; by case; run;
proc univariate data=samples noprint outtable=result; by case; var x; run;
data _null_; set result; file print; put case ' | ' _nobs_ best32. ' | ' _normal_ best32. ' | ' _probn_ best32.; run;
