37         options nodate nonumber;
38         data samples;
39         length case $32;
40         do n=3,4,8,11,12,2000,2001;
41          case=cats('quantile',n);
42          do i=1 to n; x=probit((i-.375)/(n+.25)); output; end;
43          case=cats('uniform',n);
44          do i=1 to n; x=i; output; end;
45          case=cats('skew',n);
46          do i=1 to n; x=log(i)+sin(i); output; end;
47         end;
48         do n=1,2,3,4,8,2001;
49          case=cats('constant',n); do i=1 to n; x=7; output; end;
50         end;
51         do n=3,4,8,11,12,2000,2001;
52          case=cats('ties',n); do i=1 to n; x=floor(i/3); output; end;
53          case=cats('outlier',n); do i=1 to n; if i=n then x=1e6; else x=i; output; end;
54         end;
55         do shape=0.01 to 0.12 by 0.005;
56          n=2001; case=cats('ks',put(shape,6.3));
57          do i=1 to n; z=probit((i-.375)/(n+.25)); x=z+shape*(z*z-1); output; end;
58         end;
59         case='translate8'; n=8; do i=1 to n; x=1e12+i/1024; output; end;
60         case='scale8'; n=8; do i=1 to n; x=i*1e100; output; end;
61         keep case x;
62         run;

