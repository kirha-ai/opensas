options nonumber nodate;
data j; do i=1 to 101; q=(i-.375)/101.25; b=quantile('beta',q,2,3); p=q**(1/2); g=2*((1-q)**(-.3)-1)/.3; output; end; run;
%macro fit(v,f,opts,label);
title "&label"; proc univariate data=j; var &v; histogram &v / &f(&opts) noplot; run;
%mend;
