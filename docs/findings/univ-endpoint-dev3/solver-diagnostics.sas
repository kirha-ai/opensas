options nonumber nodate;
%macro show;
%put DEV3_CASE &case;
%if %sysfunc(exist(p)) %then %do;
data _null_; set p; put 'DEV3_PARAMETER ' Symbol $ ' ' Estimate hex16.; run;
proc print data=p noobs; format _numeric_ best32.; run;
proc datasets lib=work nolist; delete p; quit;
%end;
%mend;
data p_base; do i=1 to 41; x=0+1*((i-.375)/41.25)**2; output; end; run;
%let case=power_base_scale_1; title "&case"; ods output ParameterEstimates=p; proc univariate data=p_base noprint; histogram x / power(theta=0 sigma=est maxiter=1) noplot; run; %show;
%let case=power_base_both_1; title "&case"; ods output ParameterEstimates=p; proc univariate data=p_base noprint; histogram x / power(theta=est sigma=est maxiter=1) noplot; run; %show;
