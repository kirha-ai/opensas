options nonumber nodate;
%macro show; %if %sysfunc(exist(p)) %then %do;
proc print data=p noobs; format _numeric_ best32.; run;
proc datasets lib=work nolist; delete p; quit;
%end; %mend;
data d0; do i=1 to 41; x=0+1*((i-.375)/(41+.25))**(1/0.5); output; end; run;
title "case 0 power scale"; ods output ParameterEstimates=p; proc univariate data=d0 noprint; histogram x / power(theta=0 sigma=est) noplot; run; %show;
title "case 0 power both"; ods output ParameterEstimates=p; proc univariate data=d0 noprint; histogram x / power(theta=est sigma=est) noplot; run; %show;
title "case 0 power theta"; ods output ParameterEstimates=p; proc univariate data=d0 noprint; histogram x / power(theta=est sigma=1 alpha=0.5) noplot; run; %show;
title "case 0 beta scale"; ods output ParameterEstimates=p; proc univariate data=d0 noprint; histogram x / beta(theta=0 sigma=est beta=1) noplot; run; %show;
title "case 0 beta both"; ods output ParameterEstimates=p; proc univariate data=d0 noprint; histogram x / beta(theta=est sigma=est beta=1) noplot; run; %show;
title "case 0 beta theta"; ods output ParameterEstimates=p; proc univariate data=d0 noprint; histogram x / beta(theta=est sigma=1 alpha=0.5 beta=1) noplot; run; %show;
