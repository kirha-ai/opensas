options nonumber nodate;
data d; do i=1 to 31; x=.01*quantile('beta',(i-.375)/31.25,2,3); output; end; run;
proc means data=d noprint; var x; output out=m mean=mean std=sd skewness=skew kurtosis=kurt min=lo max=hi; run;
data _null_; set m;
t=(6+3*kurt-3*skew*skew)/(1.5*skew*skew-kurt);
r=sign(skew)*sqrt(skew*skew*(t+2)**2/(16*(t+1)+skew*skew*(t+2)**2));
w=2*sd*sqrt((t+1)/(1-r*r)); mt=mean-w*(1-r)/2;
s0=hi-lo+min(.002,.1*(w-(hi-lo))); t0=lo-min(.001,.1*(lo-mt));
call symputx('s0',put(s0,best32.)); call symputx('w',put(w,best32.));
call symputx('mt',put(mt,best32.)); call symputx('t0',put(t0,best32.));
call symputx('padded',put(hi-lo+.002,best32.)); call symputx('safe',put(1.05*hi,best32.));
call symputx('near',put(lo-.00001,best32.));
put 'DEV3_CONTROL s0 ' s0 hex16.; put 'DEV3_CONTROL w ' w hex16.;
put 'DEV3_CONTROL mt ' mt hex16.; put 'DEV3_CONTROL t0 ' t0 hex16.;
run;
%macro fit(case,opts);
title "&case"; ods output ParameterEstimates=p;
proc univariate data=d noprint; histogram x / beta(&opts beta=1.5) noplot; run;
%put DEV3_CASE &case;
%if %sysfunc(exist(p)) %then %do;
data _null_; set p; put 'DEV3_PARAMETER ' Symbol $ ' ' Estimate hex16.; run;
proc datasets lib=work nolist; delete p; quit;
%end;
%mend;
%fit(baseline,%str(theta=0 sigma=est));
%fit(fixed_alpha,%str(theta=0 sigma=est alpha=2));
%fit(fixed_candidate,%str(theta=0 sigma=&s0));
%fit(fixed_moment_width,%str(theta=0 sigma=&w));
%fit(fixed_feasible,%str(theta=0 sigma=&safe));
%fit(fixed_padded,%str(theta=0 sigma=&padded));
%fit(fixed_moment_location,%str(theta=&mt sigma=est));
%fit(fixed_location_candidate,%str(theta=&t0 sigma=est));
%fit(fixed_near_minimum,%str(theta=&near sigma=est));
%fit(fixed_near_and_candidate,%str(theta=&near sigma=&s0));
