40         data _null_; set m;
41         t=(6+3*kurt-3*skew*skew)/(1.5*skew*skew-kurt);
42         r=sign(skew)*sqrt(skew*skew*(t+2)**2/(16*(t+1)+skew*skew*(t+2)**2));
43         w=2*sd*sqrt((t+1)/(1-r*r)); mt=mean-w*(1-r)/2;
44         s0=hi-lo+min(.002,.1*(w-(hi-lo))); t0=lo-min(.001,.1*(lo-mt));
45         call symputx('s0',put(s0,best32.)); call symputx('w',put(w,best32.));
46         call symputx('mt',put(mt,best32.)); call symputx('t0',put(t0,best32.));
47         call symputx('padded',put(hi-lo+.002,best32.)); call symputx('safe',put(1.05*hi,best32.));
48         call symputx('near',put(lo-.00001,best32.));
49         put 'DEV3_CONTROL s0 ' s0 hex16.; put 'DEV3_CONTROL w ' w hex16.;
50         put 'DEV3_CONTROL mt ' mt hex16.; put 'DEV3_CONTROL t0 ' t0 hex16.;
51         run;

