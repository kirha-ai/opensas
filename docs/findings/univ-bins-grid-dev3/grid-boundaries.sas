options nonumber nodate linesize=256;
%macro dump(ds);
%if %sysfunc(exist(&ds)) %then %do;
proc contents data=&ds out=meta noprint; run;
proc sort data=meta; by varnum; run;
data _null_; set meta; length line $1000;
line=cats("DEV3_META|&ds|",varnum,'|',name,'|',type,'|',length,'|',label,'|',format,'|',formatl,'|',formatd,'|',informat,'|',informl,'|',informd); ll=lengthn(line); put line $varying1000. ll;
run;
data _null_; set &ds; array nn _numeric_; array cc _character_; length line $1000;
do zz=1 to dim(nn); nm=vname(nn[zz]); line=cats("DEV3_N|&ds|",_n_,'|',nm,'|',put(nn[zz],hex16.)); ll=lengthn(line); put line $varying1000. ll; end;
do zz=1 to dim(cc); nm=vname(cc[zz]); line=cats("DEV3_C|&ds|",_n_,'|',nm,'|',cc[zz]); ll=lengthn(line); put line $varying1000. ll; end;
run;
%end;
%mend;
%macro summary(ds);
data _null_; set &ds end=done; retain first second;
if _n_=1 then first=_value_; if _n_=2 then second=_value_;
if done then put "DEV3_GRID|&ds|" _n_ best12. '|' first hex16. '|' second hex16. '|' _value_ hex16.;
run;
%mend;
data d; do i=1 to 1; x=5; output; end; run; proc univariate data=d noprint; histogram x / noplot kernel(c=.5) outkernel=flat0 outhistogram=flat_h0; run; %dump(flat0); %dump(flat_h0);
data d; do i=1 to 20; x=0; output; end; run; proc univariate data=d noprint; histogram x / noplot kernel(c=.5) outkernel=flat1 outhistogram=flat_h1; run; %dump(flat1); %dump(flat_h1);
data d; do i=1 to 20; x=0.01; output; end; run; proc univariate data=d noprint; histogram x / noplot kernel(c=.5) outkernel=flat2 outhistogram=flat_h2; run; %dump(flat2); %dump(flat_h2);
data d; do i=1 to 20; x=5; output; end; run; proc univariate data=d noprint; histogram x / noplot kernel() outkernel=flat3 outhistogram=flat_h3; run; %dump(flat3); %dump(flat_h3);
data d; do i=1 to 2; x=1234; output; end; run; proc univariate data=d noprint; histogram x / noplot kernel(c=.5) outkernel=flat4 outhistogram=flat_h4; run; %dump(flat4); %dump(flat_h4);
data d; do i=1 to 21; x=0; if i=21 then x=10; output; end; run; proc univariate data=d noprint; histogram x / noplot kernel(c=.5) outkernel=zeroiqr; run; %dump(zeroiqr);
data d; input x @@; datalines;
1 2 3 4 6 8 10 15
;
proc univariate data=d noprint; histogram x / noplot kernel(c=.5 .6 lower=0 -5 upper=20 30) outkernel=boundslist; run; %dump(boundslist);
data d; do i=0 to 20; x=i/20; abcdefghi=x; abcdefghijklmnopq=x; output; end; run; proc univariate data=d noprint; histogram abcdefghi abcdefghijklmnopq / noplot kernel(c=.2) outkernel=names outhistogram=nameh; run; %dump(names); %dump(nameh);
proc univariate data=d noprint; histogram x / noplot endpoints=0 to 1 by .25 outhistogram=explicit0; run; %dump(explicit0);
proc univariate data=d noprint; histogram x / noplot endpoints=0 to 1 by .25 rtinclude outhistogram=explicit1; run; %dump(explicit1);
