options nonumber nodate linesize=256;
%macro dump(ds);
%if %sysfunc(exist(&ds)) %then %do;
proc contents data=&ds out=meta noprint; run;
proc sort data=meta; by varnum; run;
data _null_; set meta; length line $1000;
line=cats("DEV3_META|&ds|",varnum,'|',name,'|',type,'|',length,'|',label,'|',format,'|',formatl,'|',formatd,'|',informat,'|',informl,'|',informd); ll=lengthn(line); put line $varying1000. ll;
run;
data _null_; set &ds; array nn _numeric_; array cc _character_; length line $1000;
do zz=1 to dim(nn); nm=vname(nn[zz]); line=cats("DEV3_N|&ds|",_n_,'|',nm,'|',put(nn[zz],hex16.)); ll=lengthn(line); put line $varying1000. ll; end;
do zz=1 to dim(cc); nm=vname(cc[zz]); line=cats("DEV3_C|&ds|",_n_,'|',nm,'|',cc[zz]); ll=lengthn(line); put line $varying1000. ll; end;
run;
%end;
%mend;
%macro summary(ds);
data _null_; set &ds end=done; retain first second;
if _n_=1 then first=_value_; if _n_=2 then second=_value_;
if done then put "DEV3_GRID|&ds|" _n_ best12. '|' first hex16. '|' second hex16. '|' _value_ hex16.;
run;
%mend;
data d; length g $1; g="A"; do i=0 to 19; x=i/19; y=x; output; end; g="B"; do i=1 to 10; x=.37; y=.; output; end; g="C"; do i=1 to 10; x=.; y=2+i/10; output; end; run;
proc univariate data=d noprint; class g; histogram x y / noplot  outhistogram=cells0; run; %dump(cells0);
proc univariate data=d noprint; class g / keylevel="B"; histogram x y / noplot  outhistogram=cells1; run; %dump(cells1);
proc univariate data=d noprint; class g / keylevel="C"; histogram x y / noplot  outhistogram=cells2; run; %dump(cells2);
proc univariate data=d noprint; class g; histogram x y / noplot maxnbin=3 outhistogram=cells3; run; %dump(cells3);
proc univariate data=d noprint; class g; histogram x y / noplot maxsigmas=1 outhistogram=cells4; run; %dump(cells4);
proc univariate data=d noprint; class g; histogram x y / noplot endpoints=uniform rtinclude outhistogram=cells5; run; %dump(cells5);
data d; do i=0 to 20; x=i/20; output; end; run;
proc univariate data=d noprint; histogram x / noplot nmidpoints=2 outhistogram=counts0; run; %dump(counts0);
proc univariate data=d noprint; histogram x / noplot nmidpoints=6 outhistogram=counts1; run; %dump(counts1);
proc univariate data=d noprint; histogram x / noplot nmidpoints=8 outhistogram=counts2; run; %dump(counts2);
proc univariate data=d noprint; histogram x / noplot nmidpoints=20 outhistogram=counts3; run; %dump(counts3);
proc univariate data=d noprint; histogram x / noplot nendpoints=2 rtinclude outhistogram=counts4; run; %dump(counts4);
proc univariate data=d noprint; histogram x / noplot nendpoints=8 outhistogram=counts5; run; %dump(counts5);
proc univariate data=d noprint; histogram x / noplot endpoints rtinclude outhistogram=counts6; run; %dump(counts6);
