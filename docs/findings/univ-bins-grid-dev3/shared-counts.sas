options nonumber nodate;
%macro dump(ds);
%if %sysfunc(exist(&ds)) %then %do;
proc contents data=&ds out=meta noprint; run;
proc sort data=meta; by varnum; run;
data _null_; set meta;
put "DEV3_META|&ds|" varnum best12. '|' name $32. '|' type best12. '|' length best12. '|' label $100. '|' format $32. '|' formatl best12. '|' formatd best12. '|' informat $32. '|' informl best12. '|' informd best12.;
run;
data _null_; set &ds;
array nn _numeric_; array cc _character_;
do zz=1 to dim(nn); nm=vname(nn[zz]); put "DEV3_N|&ds|" _n_ best12. '|' nm $32. '|' nn[zz] hex16.; end;
do zz=1 to dim(cc); nm=vname(cc[zz]); put "DEV3_C|&ds|" _n_ best12. '|' nm $32. '|' cc[zz] $char100.; end;
run;
%end;
%mend;
data d; length g $4; g="A"; do i=1 to 8; x=input(scan("1 2 3 4 6 8 10 15",i),best.); output; end; g="B"; do i=1 to 100; x=20+(i-1)/99; output; end; run;
title "shared0"; proc univariate data=d noprint; class g; histogram x / noplot  outhistogram=shared0; run; %dump(shared0);
title "shared1"; proc univariate data=d noprint; class g; histogram x / noplot midpoints=uniform outhistogram=shared1; run; %dump(shared1);
title "shared2"; proc univariate data=d noprint; class g; histogram x / noplot endpoints outhistogram=shared2; run; %dump(shared2);
title "shared3"; proc univariate data=d noprint; class g; histogram x / noplot endpoints=uniform outhistogram=shared3; run; %dump(shared3);
title "shared4"; proc univariate data=d noprint; class g / keylevel="B"; histogram x / noplot  outhistogram=shared4; run; %dump(shared4);
title "shared5"; proc univariate data=d noprint; class g / keylevel="Z"; histogram x / noplot  outhistogram=shared5; run; %dump(shared5);
title "shared6"; proc univariate data=d noprint; class g; histogram x / noplot nmidpoints=5 outhistogram=shared6; run; %dump(shared6);
title "shared7"; proc univariate data=d noprint; class g; histogram x / noplot nendpoints=5 outhistogram=shared7; run; %dump(shared7);
data d; do i=1 to 20; x=(i-1)/19; output; end; run;
