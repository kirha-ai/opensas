options nonumber nodate linesize=256;
%macro dump(ds);
%if %sysfunc(exist(&ds)) %then %do;
proc contents data=&ds out=meta noprint; run;
proc sort data=meta; by varnum; run;
data _null_; set meta; length line $1000;
line=cats("DEV3_META|&ds|",varnum,'|',name,'|',type,'|',length,'|',label,'|',format,'|',formatl,'|',formatd,'|',informat,'|',informl,'|',informd); ll=lengthn(line); put line $varying1000. ll;
run;
data _null_; set &ds; array nn _numeric_; array cc _character_; length line $1000;
do zz=1 to dim(nn); nm=vname(nn[zz]); line=cats("DEV3_N|&ds|",_n_,'|',nm,'|',put(nn[zz],hex16.)); ll=lengthn(line); put line $varying1000. ll; end;
do zz=1 to dim(cc); nm=vname(cc[zz]); line=cats("DEV3_C|&ds|",_n_,'|',nm,'|',cc[zz]); ll=lengthn(line); put line $varying1000. ll; end;
run;
%end;
%mend;
%macro summary(ds);
data _null_; set &ds end=done; retain first second;
if _n_=1 then first=_value_; if _n_=2 then second=_value_;
if done then put "DEV3_GRID|&ds|" _n_ best12. '|' first hex16. '|' second hex16. '|' _value_ hex16.;
run;
%mend;
data d; length byid $3 group $6; label byid="By label" group="Class label"; format byid $3.; do byid="B1","B2"; group="A"; do i=1 to 17; x=-3+4*quantile("beta",(i-.375)/17.25,2,3); LongVariableName=x; output; end; group="B"; do i=1 to 31; x=2+i/31; LongVariableName=x; output; end; end; run;
proc univariate data=d(where=(byid="B1" and group="A")) noprint; histogram x / noplot kernel(c=.2 noprint) outkernel=held0 outhistogram=hh0; run; %dump(held0); %dump(hh0);
proc univariate data=d(where=(byid="B1" and group="A")) noprint; histogram x / noplot kernel(c=.9 noprint) outkernel=held1 outhistogram=hh1; run; %dump(held1); %dump(hh1);
proc univariate data=d(where=(byid="B1" and group="A")) noprint; histogram x / noplot kernel(k=quadratic c=1 noprint) outkernel=held2 outhistogram=hh2; run; %dump(held2); %dump(hh2);
proc univariate data=d(where=(byid="B1" and group="A")) noprint; histogram x / noplot kernel(k=triangular c=2 noprint) outkernel=held3 outhistogram=hh3; run; %dump(held3); %dump(hh3);
proc univariate data=d(where=(byid="B1" and group="A")) noprint; histogram x / noplot kernel(c=.5 lower=-4 upper=2 noprint) outkernel=held4 outhistogram=hh4; run; %dump(held4); %dump(hh4);
proc univariate data=d(where=(byid="B1" and group="A")) noprint; histogram x / noplot kernel(c=.3 .9 noprint) outkernel=held5 outhistogram=hh5; run; %dump(held5); %dump(hh5);
proc univariate data=d(where=(byid="B1" and group="A")) noprint; histogram x / noplot kernel(c=.2 noprint) normal(mu=100 sigma=1 noprint) outkernel=held6 outhistogram=hh6; run; %dump(held6); %dump(hh6);
proc univariate data=d noprint; by byid; class group; histogram LongVariableName / noplot kernel(c=.5 noprint) outkernel=metadata outhistogram=mh; run; %dump(metadata); %dump(mh);
data constant; x=5; output; output; run; proc univariate data=constant noprint; histogram x / noplot kernel(c=.5 noprint) outkernel=kc outhistogram=hc; run; %dump(kc); %dump(hc);
data unit; do i=0 to 19; x=i/19; output; end; run; proc univariate data=unit noprint; histogram x / noplot endpoints=0 to 1 by .25 kernel(c=.1 noprint) outkernel=aligned; run; %dump(aligned);
