options nonumber nodate;
%macro dump(ds);
%if %sysfunc(exist(&ds)) %then %do;
proc contents data=&ds out=meta noprint; run;
proc sort data=meta; by varnum; run;
data _null_; set meta;
put "DEV3_META|&ds|" varnum best12. '|' name $32. '|' type best12. '|' length best12. '|' label $100. '|' format $32. '|' formatl best12. '|' formatd best12. '|' informat $32. '|' informl best12. '|' informd best12.;
run;
data _null_; set &ds;
array nn _numeric_; array cc _character_;
do zz=1 to dim(nn); nm=vname(nn[zz]); put "DEV3_N|&ds|" _n_ best12. '|' nm $32. '|' nn[zz] hex16.; end;
do zz=1 to dim(cc); nm=vname(cc[zz]); put "DEV3_C|&ds|" _n_ best12. '|' nm $32. '|' cc[zz] $char100.; end;
run;
%end;
%mend;
data d; do i=1 to 20; x=0; output; end; run;
title "h0_mid"; proc univariate data=d noprint; histogram x / noplot  normal(mu=0 sigma=1) outhistogram=h0_mid; run; %dump(h0_mid);
title "h0_end"; proc univariate data=d noprint; histogram x / noplot endpoints normal(mu=0 sigma=1) outhistogram=h0_end; run; %dump(h0_end);
title "h0_right"; proc univariate data=d noprint; histogram x / noplot endpoints rtinclude normal(mu=0 sigma=1) outhistogram=h0_right; run; %dump(h0_right);
