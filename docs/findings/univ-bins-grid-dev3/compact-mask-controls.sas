options nonumber nodate linesize=256;
%macro dump(ds);
%if %sysfunc(exist(&ds)) %then %do;
proc contents data=&ds out=meta noprint; run;
proc sort data=meta; by varnum; run;
data _null_; set meta; length line $1000;
line=cats("DEV3_META|&ds|",varnum,'|',name,'|',type,'|',length,'|',label,'|',format,'|',formatl,'|',formatd,'|',informat,'|',informl,'|',informd); ll=lengthn(line); put line $varying1000. ll;
run;
data _null_; set &ds; array nn _numeric_; array cc _character_; length line $1000;
do zz=1 to dim(nn); nm=vname(nn[zz]); line=cats("DEV3_N|&ds|",_n_,'|',nm,'|',put(nn[zz],hex16.)); ll=lengthn(line); put line $varying1000. ll; end;
do zz=1 to dim(cc); nm=vname(cc[zz]); line=cats("DEV3_C|&ds|",_n_,'|',nm,'|',cc[zz]); ll=lengthn(line); put line $varying1000. ll; end;
run;
%end;
%mend;
%macro summary(ds);
data _null_; set &ds end=done; retain first second;
if _n_=1 then first=_value_; if _n_=2 then second=_value_;
if done then put "DEV3_GRID|&ds|" _n_ best12. '|' first hex16. '|' second hex16. '|' _value_ hex16.;
run;
%mend;
data d; do i=1 to 17; x=-3+4*quantile("beta",(i-.375)/17.25,2,3); output; end; run;
proc univariate data=d noprint; histogram x / noplot kernel(k=triangular c=2 noprint) endpoints=-4 to 2 by .5 outkernel=tri_prefix; run; %dump(tri_prefix);
proc univariate data=d noprint; histogram x / noplot kernel(k=quadratic c=1 noprint) endpoints=-5 to 2 by 1 outkernel=quad_full; run; %dump(quad_full);
data fresh; do i=1 to 13; x=-7+3*((i-.375)/13.25)**2; output; end; run; %dump(fresh);
proc univariate data=fresh noprint; histogram x / noplot kernel(k=quadratic c=.7 noprint) endpoints=-10 to 0 by 1 outkernel=qfull; run; %dump(qfull);
proc univariate data=fresh noprint; histogram x / noplot kernel(k=quadratic c=.7 noprint) endpoints=-8 to 0 by 1 outkernel=qprefix; run; %dump(qprefix);
proc univariate data=fresh noprint; histogram x / noplot kernel(k=triangular c=.7 noprint) endpoints=-10 to 0 by 1 outkernel=tfull; run; %dump(tfull);
proc univariate data=fresh noprint; histogram x / noplot kernel(k=triangular c=.7 noprint) endpoints=-8 to 0 by 1 outkernel=tprefix; run; %dump(tprefix);
