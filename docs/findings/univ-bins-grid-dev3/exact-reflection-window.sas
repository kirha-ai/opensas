options nonumber nodate linesize=256;
%macro dump(ds);
%if %sysfunc(exist(&ds)) %then %do;
proc contents data=&ds out=meta noprint; run;
proc sort data=meta; by varnum; run;
data _null_; set meta; length line $1000;
line=cats("DEV3_META|&ds|",varnum,'|',name,'|',type,'|',length,'|',label,'|',format,'|',formatl,'|',formatd,'|',informat,'|',informl,'|',informd); ll=lengthn(line); put line $varying1000. ll;
run;
data _null_; set &ds; array nn _numeric_; array cc _character_; length line $1000;
do zz=1 to dim(nn); nm=vname(nn[zz]); line=cats("DEV3_N|&ds|",_n_,'|',nm,'|',put(nn[zz],hex16.)); ll=lengthn(line); put line $varying1000. ll; end;
do zz=1 to dim(cc); nm=vname(cc[zz]); line=cats("DEV3_C|&ds|",_n_,'|',nm,'|',cc[zz]); ll=lengthn(line); put line $varying1000. ll; end;
run;
%end;
%mend;
%macro summary(ds);
data _null_; set &ds end=done; retain first second;
if _n_=1 then first=_value_; if _n_=2 then second=_value_;
if done then put "DEV3_GRID|&ds|" _n_ best12. '|' first hex16. '|' second hex16. '|' _value_ hex16.;
run;
%mend;
data exact; do i=1 to 17; x=-3+4*quantile("beta",(i-.375)/17.25,2,3); output; end; run; %dump(exact);
proc univariate data=exact noprint; histogram x / noplot kernel(c=.5 lower=-3 upper=.5 noprint) outkernel=reflected0; run; %dump(reflected0);
proc univariate data=exact noprint; histogram x / noplot kernel(k=quadratic c=.7 lower=-3 upper=.5 noprint) outkernel=reflected1; run; %dump(reflected1);
proc univariate data=exact noprint; histogram x / noplot kernel(k=triangular c=1.1 lower=-3 upper=.5 noprint) outkernel=reflected2; run; %dump(reflected2);
data d; length g $1; g="A"; do i=0 to 20; x=-1+i/10; output; end; g="B"; x=-4; output; x=4; output; run;
proc univariate data=d noprint; class g; histogram x / noplot maxnbin=7 outhistogram=mixed0; run; %dump(mixed0);
proc univariate data=d noprint; class g; histogram x / noplot endpoints maxnbin=7 outhistogram=mixed1; run; %dump(mixed1);
proc univariate data=d noprint; class g; histogram x / noplot maxsigmas=3 outhistogram=mixed2; run; %dump(mixed2);
proc univariate data=d noprint; class g; histogram x / noplot endpoints maxsigmas=3 outhistogram=mixed3; run; %dump(mixed3);
