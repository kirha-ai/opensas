options nonumber nodate linesize=256;
%macro dump(ds);
%if %sysfunc(exist(&ds)) %then %do;
proc contents data=&ds out=meta noprint; run;
proc sort data=meta; by varnum; run;
data _null_; set meta; length line $1000;
line=cats("DEV3_META|&ds|",varnum,'|',name,'|',type,'|',length,'|',label,'|',format,'|',formatl,'|',formatd,'|',informat,'|',informl,'|',informd); ll=lengthn(line); put line $varying1000. ll;
run;
data _null_; set &ds; array nn _numeric_; array cc _character_; length line $1000;
do zz=1 to dim(nn); nm=vname(nn[zz]); line=cats("DEV3_N|&ds|",_n_,'|',nm,'|',put(nn[zz],hex16.)); ll=lengthn(line); put line $varying1000. ll; end;
do zz=1 to dim(cc); nm=vname(cc[zz]); line=cats("DEV3_C|&ds|",_n_,'|',nm,'|',cc[zz]); ll=lengthn(line); put line $varying1000. ll; end;
run;
%end;
%mend;
%macro summary(ds);
data _null_; set &ds end=done; retain first second;
if _n_=1 then first=_value_; if _n_=2 then second=_value_;
if done then put "DEV3_GRID|&ds|" _n_ best12. '|' first hex16. '|' second hex16. '|' _value_ hex16.;
run;
%mend;
data d; length g $1; g="A"; do i=0 to 20; x=-1+i/10; output; end; g="B"; do i=0 to 10; x=3+i/10; output; end; g="C"; do i=0 to 10; x=-4+i/10; output; end; run;
proc univariate data=d noprint; class g; histogram x / noplot maxnbin=3 outhistogram=limit0; run; %dump(limit0);
proc univariate data=d noprint; class g; histogram x / noplot maxnbin=5 outhistogram=limit1; run; %dump(limit1);
proc univariate data=d noprint; class g; histogram x / noplot maxnbin=6 outhistogram=limit2; run; %dump(limit2);
proc univariate data=d noprint; class g; histogram x / noplot maxnbin=7 outhistogram=limit3; run; %dump(limit3);
proc univariate data=d noprint; class g; histogram x / noplot maxnbin=9 outhistogram=limit4; run; %dump(limit4);
proc univariate data=d noprint; class g; histogram x / noplot maxnbin=12 outhistogram=limit5; run; %dump(limit5);
proc univariate data=d noprint; class g; histogram x / noplot maxsigmas=1 outhistogram=limit6; run; %dump(limit6);
proc univariate data=d noprint; class g; histogram x / noplot maxsigmas=2 outhistogram=limit7; run; %dump(limit7);
proc univariate data=d noprint; class g; histogram x / noplot maxsigmas=3 outhistogram=limit8; run; %dump(limit8);
proc univariate data=d noprint; class g; histogram x / noplot maxsigmas=5 outhistogram=limit9; run; %dump(limit9);
data d; do i=1 to 20; x=.1; output; end; run; proc univariate data=d noprint; histogram x / noplot kernel(c=.5 noprint) outkernel=smallconst; run; %dump(smallconst);
