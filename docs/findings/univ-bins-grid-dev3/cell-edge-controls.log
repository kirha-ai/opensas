50         %mend;
51         %macro summary(ds);
52         data _null_; set &ds end=done; retain first second;
53         if _n_=1 then first=_value_; if _n_=2 then second=_value_;
54         if done then put "DEV3_GRID|&ds|" _n_ best12. '|' first hex16. '|' second hex16. '|' _value_ hex16.;
55         run;
