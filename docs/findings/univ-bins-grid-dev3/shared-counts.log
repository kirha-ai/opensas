37         options nonumber nodate;
38         %macro dump(ds);
39         %if %sysfunc(exist(&ds)) %then %do;
40         proc contents data=&ds out=meta noprint; run;
41         proc sort data=meta; by varnum; run;
42         data _null_; set meta;
43         put "DEV3_META|&ds|" varnum best12. '|' name $32. '|' type best12. '|' length best12. '|' label $100. '|'
43       ! format $32. '|' formatl best12. '|' formatd best12. '|' informat $32. '|' informl best12. '|' informd best12.
43       ! ;
44         run;
45         data _null_; set &ds;
46         array nn _numeric_; array cc _character_;
47         do zz=1 to dim(nn); nm=vname(nn[zz]); put "DEV3_N|&ds|" _n_ best12. '|' nm $32. '|' nn[zz] hex16.; end;
48         do zz=1 to dim(cc); nm=vname(cc[zz]); put "DEV3_C|&ds|" _n_ best12. '|' nm $32. '|' cc[zz] $char100.; end;
49         run;
50         %end;
51         %mend;
52         data d; length g $4; g="A"; do i=1 to 8; x=input(scan("1 2 3 4 6 8 10 15",i),best.); output; end; g="B"; do
52       ! i=1 to 100; x=20+(i-1)/99; output; end; run;

