options nonumber nodate linesize=256;
%macro dump(ds);
%if %sysfunc(exist(&ds)) %then %do;
proc contents data=&ds out=meta noprint; run;
proc sort data=meta; by varnum; run;
data _null_; set meta; length line $1000;
line=cats("DEV3_META|&ds|",varnum,'|',name,'|',type,'|',length,'|',label,'|',format,'|',formatl,'|',formatd,'|',informat,'|',informl,'|',informd); ll=lengthn(line); put line $varying1000. ll;
run;
data _null_; set &ds; array nn _numeric_; array cc _character_; length line $1000;
do zz=1 to dim(nn); nm=vname(nn[zz]); line=cats("DEV3_N|&ds|",_n_,'|',nm,'|',put(nn[zz],hex16.)); ll=lengthn(line); put line $varying1000. ll; end;
do zz=1 to dim(cc); nm=vname(cc[zz]); line=cats("DEV3_C|&ds|",_n_,'|',nm,'|',cc[zz]); ll=lengthn(line); put line $varying1000. ll; end;
run;
%end;
%mend;
%macro summary(ds);
data _null_; set &ds end=done; retain first second;
if _n_=1 then first=_value_; if _n_=2 then second=_value_;
if done then put "DEV3_GRID|&ds|" _n_ best12. '|' first hex16. '|' second hex16. '|' _value_ hex16.;
run;
%mend;
data d; length g $1; g="A"; do i=0 to 20; x=-1+i/10; output; end; g="B"; do i=0 to 10; x=-4+i/10; output; end; g="C"; do i=0 to 10; x=3+i/10; output; end; run;
proc univariate data=d noprint; class g; histogram x / noplot maxnbin=7 outhistogram=reverse0; run; %dump(reverse0);
proc univariate data=d noprint; class g; histogram x / noplot endpoints maxnbin=7 outhistogram=reverse1; run; %dump(reverse1);
proc univariate data=d noprint; class g; histogram x / noplot endpoints maxsigmas=3 outhistogram=reverse2; run; %dump(reverse2);
proc univariate data=d noprint; class g; histogram x / noplot endpoints rtinclude maxsigmas=3 outhistogram=reverse3; run; %dump(reverse3);
proc univariate data=d noprint; class g; histogram x / noplot maxnbin=9 maxsigmas=3 outhistogram=reverse4; run; %dump(reverse4);
proc univariate data=d noprint; class g; histogram x / noplot maxnbin=0 outhistogram=reverse5; run; %dump(reverse5);
proc univariate data=d noprint; class g; histogram x / noplot maxsigmas=0 outhistogram=reverse6; run; %dump(reverse6);
