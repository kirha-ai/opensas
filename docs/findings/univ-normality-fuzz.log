37         options nodate nonumber;
38         data d;
39         length case $40;
40         do delta=.005,.008,.009,.0099,.01,.0101,.011,.012,.015,.02;
41          do n=3,8,12;
42           case=cats('u',n,'d',put(delta,best12.));
43           do i=1 to n; x=10000+delta*(i-1)/(n-1); output; end;
44           case=cats('t',n,'d',put(delta,best12.));
45           do i=1 to n; x=10000; if i=n then x=x+delta; output; end;
46          end;
47         end;
48         keep case x;
49         run;

