options nonumber nodate;
data j; do i=1 to 101; z=probit((i-.375)/101.25); b=1/(1+exp((.4-z)/1.2)); u=3+2*sinh((z-.4)/1.2); output; end; run;
%macro fit(v,f,opts,label);
title "&label"; proc univariate data=j; var &v; histogram &v / &f(fitmethod=&opts) noplot; run;
%mend;
%fit(b,sb,mle theta=est,SB mle theta=est);
%fit(b,sb,mle sigma=est,SB mle sigma=est);
%fit(b,sb,mle delta=2,SB mle delta=2);
%fit(b,sb,mle gamma=.8,SB mle gamma=.8);
%fit(b,sb,mle delta=2 gamma=.8,SB mle delta=2 gamma=.8);
%fit(b,sb,mle theta=est delta=2 gamma=.8,SB mle theta=est delta=2 gamma=.8);
%fit(b,sb,mle sigma=est delta=2 gamma=.8,SB mle sigma=est delta=2 gamma=.8);
%fit(b,sb,moments theta=est,SB moments theta=est);
%fit(b,sb,moments sigma=est,SB moments sigma=est);
%fit(b,sb,moments delta=2,SB moments delta=2);
%fit(b,sb,moments gamma=.8,SB moments gamma=.8);
%fit(b,sb,moments delta=2 gamma=.8,SB moments delta=2 gamma=.8);
