options nodate nonumber;
data normal_cases;
do g=1 to 10;
if g=1 then n=1;
else if g=2 then n=2;
else if g=3 then n=3;
else if g=4 then n=8;
else if g=5 then n=11;
else if g=6 then n=12;
else if g=7 then n=2000;
else if g=8 then n=2001;
else if g=9 then n=5003;
else n=8;
do i=1 to n;
x=i;
if g=5 then x=mod(i,4);
if g=10 then x=7;
f=1;w=1;output;
end;end;
run;
proc univariate data=normal_cases noprint outtable=normals;by g;var x;run;
data _null_;set normals;file print;
put 'NORMAL ' g= _NOBS_= _NORMAL_ 12.8 _PROBN_ 12.8;
put 'ROBUST ' g= _GINI_ 12.6 _MAD_ 12.6 _SN_ 12.6 _QN_ 12.6 _STDSN_ 12.6 _STDQN_ 12.6;
run;
data counts;
do g=1 to 2;
x=1;f=1000;w=1;output;
x=2;f=999+g;w=1;output;
end;
run;
proc univariate data=counts noprint outtable=expanded;by g;var x;freq f;run;
data _null_;set expanded;file print;put 'EXPANDED ' g= _NOBS_= _NORMAL_ 12.8 _PROBN_ 12.8;run;
proc univariate data=counts noprint outtable=weighted;by g;var x;freq f;weight w;run;
data _null_;set weighted;file print;put 'WEIGHTED ' g= _NOBS_= _NORMAL_ 12.8 _PROBN_ 12.8;run;
data empty;set counts(obs=0);run;
proc univariate data=empty noprint outtable=empty_table;var x;run;
data _null_;ds=open('empty_table');rows=attrn(ds,'nobs');cols=attrn(ds,'nvars');rc=close(ds);file print;put 'EMPTY ' rows= cols=;run;
