options nodate nonumber;
proc format;value band 1-2='Combined';run;
data grouped;
length group $4 id $8;
label b='BY key' c='Formatted class' group='Text class' x='First analysis' y='Second analysis';
format c band.;
do b=1 to 2;
do j=1 to 2;
if j=1 then group='West';else group='East';
do x=1 to 5003;
c=1+mod(x,2);y=10000+2*x;w=1+mod(x,3);f=1+mod(x,2);id=cats('ID',b,j);output;
end;end;end;
run;
proc univariate data=grouped noprint idout outtable=tab pctldef=4;
by b;class c group(order=data);var x y;id id;freq f;weight w;
output out=summary mean=mx my n=nx ny nobs=ox oy p25=qx qy pctlpts=12.345 50 99.9 pctlpre=alpha_ beta_;
run;
data _null_;set summary;file print;raw_c=c;put b= c= raw_c= group= id= nx= ny= ox= oy= mx= my= qx= qy= alpha_12_34= beta_12_34=;run;
data _null_;set tab;file print;put b= c= group= _VAR_= _NOBS_= _SUMWGT_= _MEAN_= _MEDIAN_= _NORMAL_=;run;
proc contents data=summary out=meta noprint;run;
proc sort data=meta;by varnum;run;
data _null_;set meta;file print;put varnum name type length format label;run;
