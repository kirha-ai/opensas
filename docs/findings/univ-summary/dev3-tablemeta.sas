options nodate nonumber;
data d;
length analysis_name_longer_than_eight 8;
label analysis_name_longer_than_eight='A deliberately long synthetic label containing more than forty characters';
analysis_name_longer_than_eight=1;output;analysis_name_longer_than_eight=2;output;
run;
proc univariate data=d noprint outtable=t;var analysis_name_longer_than_eight;run;
proc contents data=t out=c noprint;run;
data _null_;set c;if name in ('_VAR_','_LABEL_');file print;put name length;run;
data none;x=1;f=0;g=.;output;run;
proc univariate data=none noprint outtable=fzero;var x;freq f;run;
proc univariate data=none noprint outtable=cmiss;class g;var x;run;
data _null_;length label $256;
ds=open('fzero');rows=attrn(ds,'nobs');cols=attrn(ds,'nvars');label=attrc(ds,'label');rc=close(ds);file print;put 'FZERO ' rows= cols= label=;
ds=open('cmiss');rows=attrn(ds,'nobs');cols=attrn(ds,'nvars');label=attrc(ds,'label');rc=close(ds);put 'CMISS ' rows= cols= label=;
run;
