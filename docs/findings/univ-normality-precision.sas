options nodate nonumber;
data d;
length case $40;
do n=2,3,8,12,2000,2001;
 do factor=.99,.999,1,1.001,1.01;
  case=cats('n',n,'f',put(factor,best12.));
  do i=1 to n;
   x=1+(2*(i>n/2)-1)*sqrt(500*constant('MACEPS'))*factor;
   output;
  end;
 end;
end;
keep case x;
run;
proc sort data=d; by case; run;
proc univariate data=d noprint outtable=r; by case; var x; run;
data _null_; set r; file print; put case ' | ' _normal_ best32. ' | ' _probn_ best32.; run;
