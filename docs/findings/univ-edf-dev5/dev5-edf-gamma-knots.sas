options ls=256;ods graphics off;ods exclude all;
%macro probe(id,mask);
data state;do shape=1.5,3,10;do n=10,20,50,100,200;do target=.001,.0025,.005,.01,.025,.05,.1,.15,.2,.25,.5;do t=1 to 3;lo=0;hi=8;output;end;end;end;end;run;
%do step=1 %to 44;
data d;array xx[500] _temporary_;set state;g=(lo+hi)/2;lm=0;
do i=1 to n;v=(i-.41)/(n+.18);u=.5+.5*sign(2*v-1)*abs(2*v-1)**(1+g);xx[i]=log(quantile('gamma',u,shape));lm+xx[i]/n;end;
%if &mask=0 %then %do;do i=1 to n;x=exp(xx[i]);output;end;%end;
%else %if &mask=1 %then %do;do i=1 to n;x=exp(xx[i]-lm+digamma(shape));output;end;%end;
%else %do;
kl=0;kh=100;do iter=1 to 60;k=(kl+kh)/2;mx=k*xx[n];sm=0;do i=1 to n;sm+exp(k*xx[i]-mx)/n;end;gap=log(sm)+mx-k*lm;if gap>log(shape)-digamma(shape) then kh=k;else kl=k;end;
scale=shape/exp(log(sm)+mx);do i=1 to n;x=exp(k*xx[i])*scale;output;end;
%end;
run;
%do shapei=1 %to 3;
%let shape=%scan(1.5 3 10,&shapei,%str( ));
ods output GoodnessOfFit=gf&shapei;
proc univariate data=d(where=(shape=&shape)) noprint;by shape n target t;
histogram x / noplot gamma(theta=0 %if &mask=0 %then %do; alpha=&shape %end; %if &mask=1 %then %do; sigma=1 %end; alphainitial=&shape alphadelta=1e-10 maxiter=100);run;
%end;
data selected;set gf1 gf2 gf3;if (t=1 and TestLab='D') or (t=2 and TestLab='W-Sq') or (t=3 and TestLab='A-Sq');keep shape n target t Stat pValue pSign;run;
data state;merge state selected;by shape n target t;g=(lo+hi)/2;if pValue>target or (pValue=target and pSign='>') then lo=g;else hi=g;run;
%end;
ods exclude none;
data _null_;set state;file print;put "&id|" shape best8. '|' n best8. '|' target best8. '|' t best8. '|' Stat best32. '|' lo best32. '|' hi best32.;run;
ods exclude all;
%mend;
%probe(gscale,0);%probe(gshape,1);%probe(gboth,2);
