run;proc sort data=state;by aa bb n t;run;
data d;set state;do side=-1,1;if side=-1 then g=max(0,lo-1e-5);else g=hi+1e-5;do i=1 to n;v=(i-.41)/(n+.18);u=.5+.5*sign(2*v-1)*abs(2*v-1)**(1/(1+g));x=quantile('beta',u,aa,bb);output;end;end;run;
ods output GoodnessOfFit=gof ParameterEstimates=pars;
proc univariate data=d noprint;by aa bb n t side;histogram x / noplot beta(theta=0 sigma=1);run;
data shapes;set pars;by aa bb n t side;retain FitAlpha FitBeta;if Symbol='Alpha' then FitAlpha=Estimate;if Symbol='Beta' then FitBeta=Estimate;if last.side then output;keep aa bb n t side FitAlpha FitBeta;run;
ods exclude none;
data _null_;merge gof shapes;by aa bb n t side;if (t=1 and TestLab='D') or (t=2 and TestLab='W-Sq') or (t=3 and TestLab='A-Sq');file print;put 'beta|' n best8. '|' side best8. '|' TestLab '|' Stat best32. '|' pValue best32. '|' pSign '|' FitAlpha best32. '|' FitBeta best32.;run;
