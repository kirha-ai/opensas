run;proc sort data=state;by mask target n t;run;
%macro p(shape,mask);
data d;set state(where=(mask=&mask and target=&shape));do side=-1,1;if side=-1 then g=max(0,lo-1e-5);else g=hi+1e-5;do i=1 to n;v=(i-.41)/(n+.18);u=.5+.5*sign(2*v-1)*abs(2*v-1)**(1+g);x=3+(-log1px(-u))**(1/&shape);output;end;end;run;
data gof;length n t side Stat pValue 8 TestLab $4 pSign $1;stop;run;
ods output GoodnessOfFit=gof ParameterEstimates=pars;
proc univariate data=d noprint;by n t side;histogram x / noplot weibull(theta=est %if &mask=0 or &mask=1 %then %do; c=&shape %end; %if &mask=0 or &mask=2 %then %do; sigma=1 %end; maxiter=100);run;
data shapes;set pars;by n t side;retain FitShape;if Symbol='C' then FitShape=Estimate;if last.side then output;keep n t side FitShape;run;
data selected;set gof;if (t=1 and TestLab='D') or (t=2 and TestLab='W-Sq') or (t=3 and TestLab='A-Sq');run;
ods exclude none;
data _null_;merge shapes selected(in=ok);by n t side;available=ok;file print;put "wb&mask._&shape|" n best8. '|' side best8. '|' t best8. '|' Stat best32. '|' pValue best32. '|' pSign '|' FitShape best32. '|' available;run;
ods exclude all;
%mend;
%macro grid;%do mask=0 %to 3;%p(2.2,&mask);%p(3,&mask);%p(5,&mask);%p(10,&mask);%p(20,&mask);%end;%mend;%grid;
