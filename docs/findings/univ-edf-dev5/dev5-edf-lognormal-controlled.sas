options ls=256;ods graphics off;ods exclude all;
%macro p(shape,mask);
data d;array zz[500] _temporary_;array rr[500] _temporary_;array yy[500] _temporary_;array dy[500] _temporary_;
do n=10,20,50,100,200,500;do g=0 to 300;mz=0;mz2=0;
do i=1 to n;v=(i-.41)/(n+.18);u=.5+.5*sign(2*v-1)*abs(2*v-1)**(1+g*.01);zz[i]=quantile('normal',u);mz+zz[i]/n;mz2+zz[i]**2/n;end;
m2=0;mr2=0;mzr=0;do i=1 to n;rr[i]=zz[i]**2-mz2;zz[i]=zz[i]-mz;m2+zz[i]**2/n;mr2+rr[i]**2/n;mzr+zz[i]*rr[i]/n;end;
c=0;cl=-5;ch=5;
do iter=1 to 80;
variance=m2+2*c*mzr+c*c*mr2;vd=2*mzr+2*c*mr2;scale=&shape*sqrt((n-1)/n)/sqrt(variance);ymin=1e100;
do i=1 to n;w=zz[i]+c*rr[i];yy[i]=scale*w;dy[i]=scale*(rr[i]-w*vd/(2*variance));ymin=min(ymin,yy[i]);end;
sw=0;sy=0;sd=0;syd=0;
do i=1 to n;w=exp(-yy[i]+ymin);sw+w;sy+w*yy[i];sd+w*dy[i];syd+w*(1-yy[i])*dy[i];end;
ratio=sy/sw;value=1+ratio/(&shape*&shape);deriv=(syd/sw+ratio*sd/sw)/(&shape*&shape);if abs(value)<1e-13 then leave;
if value>0 then ch=c;else cl=c;next=c-value/deriv;if next<=cl or next>=ch then next=(cl+ch)/2;c=next;end;
if abs(value)>1e-9 then put 'CONTROL_NOT_CONVERGED ' n= g= value=;
do i=1 to n;x=exp(yy[i]);output;end;end;end;run;
data gof;length n g Stat pValue 8 TestLab $4 pSign $1;stop;run;
ods output GoodnessOfFit=gof ParameterEstimates=pars;
proc univariate data=d noprint;by n g;histogram x / noplot lognormal(theta=est %if &mask=2 %then %do; zeta=0 %end;);run;
data shapes;set pars;by n g;retain FitShape;if Symbol='Sigma' then FitShape=Estimate;if last.g then output;keep n g FitShape;run;
ods exclude none;
data _null_;merge gof(in=ok) shapes;by n g;if ok;file print;put "ln&mask._&shape|" n best8. '|' g best8. '|' TestLab '|' Stat best32. '|' pValue best32. '|' pSign '|' FitShape best32.;run;
ods exclude all;
%mend;
%p(.2,2);%p(.5,2);%p(1,2);%p(2,2);%p(.2,3);%p(.5,3);%p(1,3);%p(2,3);
