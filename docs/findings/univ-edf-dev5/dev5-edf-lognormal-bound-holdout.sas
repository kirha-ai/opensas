run;proc sort data=state;by mask target n t;run;
%macro p(shape,mask);
data ids;set state(where=(mask=&mask and target=&shape));do side=-1,1;output;end;keep n t side;run;
data d;set state(where=(mask=&mask and target=&shape));do side=-1,1;if side=-1 then g=max(0,lo-1e-5);else g=hi+1e-5;do i=1 to n;v=(i-.41)/(n+.18);u=.5+.5*sign(2*v-1)*abs(2*v-1)**(1+g);x=3+exp(&shape*quantile('normal',u));output;end;end;run;
data gof;length n t side Stat pValue 8 TestLab $4 pSign $1;stop;run;
ods output GoodnessOfFit=gof ParameterEstimates=pars;
proc univariate data=d noprint;by n t side;histogram x / noplot lognormal(theta=est %if &mask=0 or &mask=1 %then %do; sigma=&shape %end; %if &mask=0 or &mask=2 %then %do; zeta=0 %end;);run;
data shapes;set pars;by n t side;retain FitShape npars;if first.side then do;FitShape=.;npars=0;end;if Symbol in ('Theta','Zeta','Sigma') and not missing(Estimate) then npars+1;if Symbol='Sigma' then FitShape=Estimate;if last.side then output;keep n t side FitShape npars;run;
data selected;set gof;if (t=1 and TestLab='D') or (t=2 and TestLab='W-Sq') or (t=3 and TestLab='A-Sq');run;
ods exclude none;
data _null_;merge ids selected(in=ok) shapes;by n t side;available=ok;fit_complete=(npars=3 and FitShape>0);file print;put "ln&mask._&shape|" n best8. '|' side best8. '|' t best8. '|' Stat best32. '|' pValue best32. '|' pSign '|' FitShape hex16. '|' available '|' fit_complete;run;
ods exclude all;
%mend;
%macro grid;%do mask=0 %to 3;
%p(.15,&mask);%p(.3,&mask);%p(.6,&mask);%p(1,&mask);%p(1.3,&mask);%p(1.7,&mask);%p(2.1,&mask);%p(2.5,&mask);%p(2.85,&mask);
%end;%mend;%grid;
