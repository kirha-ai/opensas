options ls=256;ods graphics off;ods exclude all;
%macro p(aa,bb);
data d;array zz[500] _temporary_;do n=30,70,100,150,300;do g=0 to 500;
do i=1 to n;v=(i-.41)/(n+.18);zz[i]=sign(2*v-1)*abs(2*v-1)**(1+g*.006);end;
ta=digamma(&aa)-digamma(&aa+&bb);tb=digamma(&bb)-digamma(&aa+&bb);a=log(&aa/&bb);b=2;
do iter=1 to 100;
l1=0;l2=0;j11=0;j12=0;j21=0;j22=0;
do i=1 to n;z=a+b*zz[i];if z>=0 then do;x=1/(1+exp(-z));lx=-log1px(exp(-z));ly=-z+lx;end;else do;x=exp(z)/(1+exp(z));ly=-log1px(exp(z));lx=z+ly;end;
l1+lx/n;l2+ly/n;j11+(1-x)/n;j12+(1-x)*zz[i]/n;j21+-x/n;j22+-x*zz[i]/n;end;
l1=l1-ta;l2=l2-tb;if abs(l1)+abs(l2)<1e-13 then leave;
det=j11*j22-j12*j21;da=(l1*j22-j12*l2)/det;db=(j11*l2-l1*j21)/det;damp=max(1,abs(da)/2,abs(db)/(.5*b));a=a-da/damp;b=b-db/damp;end;
do i=1 to n;z=a+b*zz[i];if z>=0 then x=1/(1+exp(-z));else x=exp(z)/(1+exp(z));output;end;
end;end;run;
ods output GoodnessOfFit=gof ParameterEstimates=pars;
proc univariate data=d noprint;by n g;histogram x / noplot beta(theta=0 sigma=1);run;
data shapes;set pars;by n g;retain FitAlpha FitBeta;if Symbol='Alpha' then FitAlpha=Estimate;if Symbol='Beta' then FitBeta=Estimate;if last.g then output;keep n g FitAlpha FitBeta;run;
ods exclude none;
data _null_;merge gof shapes;by n g;file print;put "beta_&aa._&bb|" n best8. '|' g best8. '|' TestLab '|' Stat best32. '|' pValue best32. '|' pSign '|' FitAlpha best32. '|' FitBeta best32.;run;
ods exclude all;
%mend;
%p(0.3,0.3);
%p(0.3,0.8);
%p(0.3,1.5);
%p(0.3,3);
%p(0.8,0.8);
%p(0.8,1.5);
%p(0.8,3);
%p(1.5,1.5);
%p(1.5,3);
%p(3,3);
