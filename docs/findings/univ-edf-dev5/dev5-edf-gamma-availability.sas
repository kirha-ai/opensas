options ls=256;ods graphics off;ods exclude all;
%macro probe(id,shape,mask);
data d;array xx[500] _temporary_;do n=20;do g=0 to 0;
lm=0;do i=1 to n;v=(i-.29)/(n+.42);u=.5+.5*sign(2*v-1)*abs(2*v-1)**(1+g*.023);xx[i]=log(quantile('gamma',u,&shape));lm+xx[i]/n;end;
%if &mask=0 %then %do;do i=1 to n;x=3+2*exp(xx[i]);output;end;%end;
%else %if &mask=1 %then %do;
do i=1 to n;x=3+2*exp(xx[i]-lm+digamma(&shape));output;end;
%end;
%else %do;
lo=0;hi=100;do iter=1 to 60;k=(lo+hi)/2;mx=k*xx[n];sm=0;do i=1 to n;sm+exp(k*xx[i]-mx)/n;end;gap=log(sm)+mx-k*lm;if gap>log(&shape)-digamma(&shape) then hi=k;else lo=k;end;
scale=&shape/exp(log(sm)+mx);do i=1 to n;x=3+2*exp(k*xx[i])*scale;output;end;
%end;
end;end;run;
data gof;length TestLab $4;stop;run;
ods output GoodnessOfFit=gof ParameterEstimates=pars;
proc univariate data=d noprint;by n g;histogram x / noplot gamma(theta=3 %if &mask=0 %then %do; alpha=&shape %end; %if &mask=1 %then %do; sigma=2 %end; alphainitial=&shape alphadelta=1e-10 maxiter=100);run;
ods exclude none;
data _null_;if 0 then set gof nobs=nr;file print;put "&id.&shape|rows|" nr;stop;run;
data _null_;set pars;where Symbol='Alpha';file print;put "&id.&shape|alpha|" Estimate best32.;run;
ods exclude all;
%mend;
%probe(gscale,0.5,0);
%probe(gscale,0.99,0);
%probe(gscale,1,0);
%probe(gshape,0.5,1);
%probe(gshape,0.99,1);
%probe(gshape,1,1);
%probe(gboth,0.5,2);
%probe(gboth,0.99,2);
%probe(gboth,1,2);
