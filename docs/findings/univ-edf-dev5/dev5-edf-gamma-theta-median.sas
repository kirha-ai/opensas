options ls=256;ods graphics off;ods exclude all;
%macro p(shape,mask);
data state;length Stat pValue FitAlpha 8 pSign $1;do n=10,20,50,100,200;do t=1 to 3;lo=0;hi=8;output;end;end;run;
%do step=1 %to 44;
data d;array xx[500] _temporary_;set state;g=(lo+hi)/2;sm=0;ss=0;
do i=1 to n;v=(i-.41)/(n+.18);u=.5+.5*sign(2*v-1)*abs(2*v-1)**(1+g);xx[i]=quantile('gamma',u,&shape);sm+xx[i]/n;ss+xx[i]*xx[i]/n;end;
do i=1 to n;%if &mask=2 %then %do;x=3+(xx[i]-sm)*sqrt(&shape/(ss-sm*sm))+2*&shape;%end;%else %do;x=3+xx[i];%end;output;end;run;
data gof;length n t Stat pValue 8 TestLab $4 pSign $1;stop;run;
ods output GoodnessOfFit=gof ParameterEstimates=pars;
proc univariate data=d noprint;by n t;histogram x / noplot gamma(theta=est %if &mask=0 or &mask=1 %then %do; alpha=&shape %end; %if &mask=0 or &mask=2 %then %do; sigma=1 %end; maxiter=100 alphadelta=1e-10);run;
data shapes;set pars;by n t;retain FitAlpha;if Symbol='Alpha' then FitAlpha=Estimate;if last.t then output;keep n t FitAlpha;run;
data selected;set gof;if (t=1 and TestLab='D') or (t=2 and TestLab='W-Sq') or (t=3 and TestLab='A-Sq');keep n t Stat pValue pSign;run;
data state;merge state(drop=Stat pValue pSign FitAlpha) selected shapes;by n t;g=(lo+hi)/2;if pValue=.5 and pSign='>' then lo=g;else hi=g;run;
%end;
ods exclude none;
data _null_;set state;file print;put "gtheta&mask._&shape|" n best8. '|' t best8. '|' Stat best32. '|' FitAlpha best32. '|' lo best32. '|' hi best32.;run;
ods exclude all;
%mend;
%macro grid;%do mask=0 %to 3;%p(1.5,&mask);%p(3,&mask);%p(5,&mask);%p(10,&mask);%p(20,&mask);%end;%mend;%grid;
