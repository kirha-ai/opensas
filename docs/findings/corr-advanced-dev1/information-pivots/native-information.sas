options linesize=240 pagesize=max;
proc iml;
x= -40//quantile('normal',42/90)//quantile('normal',80/90)//40;
y= -40//quantile('normal',10/90)//40;
r=.98771303561774;n=90;info=j(4,4,0);probs=j(3,2,0);
start dens(x,y,r);v=(1-r)*(1+r);return(exp(-((x-r*y)##2/v+y*y)/2)/(2*constant('pi')*sqrt(v)));finish;
do i=1 to 3;do j=1 to 2;
 xl=x[i];xu=x[i+1];yl=y[j];yu=y[j+1];sd=sqrt((1-r)*(1+r));
 p=probbnrm(xu,yu,r)-probbnrm(xl,yu,r)-probbnrm(xu,yl,r)+probbnrm(xl,yl,r);probs[i,j]=p;
 d=j(4,1,0);
 if i>1 then d[i-1]=-pdf('normal',xl)*(cdf('normal',(yu-r*xl)/sd)-cdf('normal',(yl-r*xl)/sd));
 if i<3 then d[i]=pdf('normal',xu)*(cdf('normal',(yu-r*xu)/sd)-cdf('normal',(yl-r*xu)/sd));
 if j>1 then d[3]=-pdf('normal',yl)*(cdf('normal',(xu-r*yl)/sd)-cdf('normal',(xl-r*yl)/sd));
 if j<2 then d[3]=pdf('normal',yu)*(cdf('normal',(xu-r*yu)/sd)-cdf('normal',(xl-r*yu)/sd));
 d[4]=dens(xu,yu,r)-dens(xl,yu,r)-dens(xu,yl,r)+dens(xl,yl,r);
 if p>0 then info=info+n*d*d`/max(p,1e-12);
end;end;
g=ginv(info);sw=sweep(info);call eigen(ev,vec,info);vginv=g[4,4];vsweep=sw[4,4];ratio=min(ev)/max(ev);
print x[format=best32.] y[format=best32.] probs[format=best32.] info[format=best32.] vginv[format=best32.] vsweep[format=best32.] ratio[format=best32.];
quit;
