options linesize=240 pagesize=max;
ods exclude none;proc iml;
start box(par,i,j);
 x=-40//par[1:2]//40;y=-40//par[3:4]//40;r=par[5];
 p=probbnrm(x[i+1],y[j+1],r)-probbnrm(x[i],y[j+1],r)-probbnrm(x[i+1],y[j],r)+probbnrm(x[i],y[j],r);
 return(max(0,p));
finish;
start density(x,y,r);
 v=(1-r)*(1+r);p=exp(-((x-r*y)##2/v+y*y)/2)/(2*constant('pi')*sqrt(v));return(p);
finish;
start derivative(par,i,j);
 x=-40//par[1:2]//40;y=-40//par[3:4]//40;r=par[5];s=sqrt((1-r)*(1+r));
 xl=x[i];xu=x[i+1];yl=y[j];yu=y[j+1];d=j(5,1,0);
 if i>1 then d[i-1]=-pdf('normal',xl)*(cdf('normal',(yu-r*xl)/s)-cdf('normal',(yl-r*xl)/s));
 if i<3 then d[i]=pdf('normal',xu)*(cdf('normal',(yu-r*xu)/s)-cdf('normal',(yl-r*xu)/s));
 if j>1 then d[j+1]=-pdf('normal',yl)*(cdf('normal',(xu-r*yl)/s)-cdf('normal',(xl-r*yl)/s));
 if j<3 then d[j+2]=pdf('normal',yu)*(cdf('normal',(xu-r*yu)/s)-cdf('normal',(xl-r*yu)/s));
 d[5]=density(xu,yu,r)-density(xl,yu,r)-density(xu,yl,r)+density(xl,yl,r);return(d);
finish;
start likelihood(par,counts);
 value=0;
 if abs(par[5])>=1 | par[1]>=par[2] | par[3]>=par[4] then return(1e100);
 do i=1 to 3;do j=1 to 3;
  if counts[i,j]>0 then do;p=box(par,i,j);if p<=0 then return(1e100);value=value-counts[i,j]*log(p);end;
 end;end;return(value);
finish;
do example=1 to 2;
 if example=1 then counts={10 4 0,0 8 2,0 0 7};else counts={5 7 0,0 8 3,0 0 12};
 n=sum(counts);row=counts[,+];col=counts[+,]`;
 par=quantile('normal',cusum(row[1:2])/n)//quantile('normal',cusum(col[1:2])/n)//0;
 sx=0;sy=0;sxx=0;syy=0;sxy=0;
 do i=1 to 3;do j=1 to 3;f=counts[i,j];sx=sx+f*i;sy=sy+f*j;sxx=sxx+f*i*i;syy=syy+f*j*j;sxy=sxy+f*i*j;end;end;
 par[5]=(sxy-sx*sy/n)/sqrt((sxx-sx*sx/n)*(syy-sy*sy/n));trace=j(1,7,.);
 do iteration=1 to 100;
  info=j(5,5,0);g=j(5,1,0);zero=0;
  do i=1 to 3;do j=1 to 3;
   p=box(par,i,j);d=derivative(par,i,j);
   if p>0 then do;info=info+n*d*d`/p;g=g-counts[i,j]*d/p;end;
   else zero=zero+1;
  end;end;
  call eigen(e,ev,info);ratio=min(e)/max(e);iv=sweep(info);delta=iv*g;
  base=likelihood(par,counts);scale=1;
  do backtrack=1 to 30;
   candidate=par-scale*delta;
   if candidate[5]>=1 then candidate[5]=.999;
   if candidate[5]<=-1 then candidate[5]=-.999;
   if likelihood(candidate,counts)<=base+1e-10 then backtrack=30;
   else scale=scale/2;
  end;
  change=max(abs(candidate-par));se=sqrt(max(0,iv[5,5]));
  trace=trace//(iteration||par[5]||candidate[5]||se||change||ratio||zero);
  par=candidate;
  if change<1e-5 then iteration=100;
 end;
 trace=trace[2:nrow(trace),];
 print example trace[colname={'iteration' 'oldrho' 'rho' 'SE' 'change' 'eigenratio' 'zeroCells'} format=best24.];
end;
quit;
