options nodate nonumber;
data d;
length case $40;
do spread=.0001,.0002,.0005,.001,.002,.003,.004,.005,.008;
 case=cats('s',put(spread,best12.)); do i=1 to 8; x=10000+i*spread; output; end;
end;
do n=2,3,8,12,2000,2001;
 case=cats('shift',n); do i=1 to n; x=1e8+i; output; end;
end;
case='short2neg'; x=-100; output; x=12; output;
keep case x;
run;
proc sort data=d; by case; run;
proc univariate data=d noprint outtable=r; by case; var x; run;
data _null_; set r; file print; put case ' | ' _nobs_ best32. ' | ' _normal_ best32. ' | ' _probn_ best32.; run;
